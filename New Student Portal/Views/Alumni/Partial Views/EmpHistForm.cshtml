<div class="row">
    <div class="col-md-6">
        <span style="font-weight: bold">From</span>
        <input type="text" id="txtFrom" class="form-control" placeholder="dd/mm/yyyy" onkeydown="return false;" autocomplete="off" />
        <div class='a'></div>
    </div>
    <div class="col-md-6">
        <span style="font-weight: bold">To</span>
        <input type="text" id="txtTo" class="form-control" placeholder="dd/mm/yyyy" onkeydown="return false;" autocomplete="off" />
        <div class='a'></div>
    </div>
</div>
<div class="row">
    <div class="col-md-6">
        <span style="font-weight: bold">Organization</span>
        <input type="text" id="txtInstitution" class="form-control" />
    </div>
    <div class="col-md-6">
        <span style="font-weight: bold">Job Title</span>
        <input type="text" id="txtTitle" class="form-control" />
    </div>
</div>
<hr />
<div align="center">
    <input type="button" class="btn btn-danger" value="Submit Line" onclick="SubmitStudentEmpHist();" />
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $('#txtFrom,#txtTo').datepicker({
            changeMonth: true,
            changeYear: true,
            autoclose: true,
            yearRange: '-50:+0',
            showOtherMonths: true,
            dateFormat: 'dd/mm/yy'
        });
        $(window).resize(function () {
            $('#txtFrom,#txtTo').datepicker('hide');
            $('#txtFrom,#txtTo').blur();
        });
    });
</script>
