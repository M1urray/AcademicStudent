@model IEnumerable<New_Student_Portal.ViewModel.ProgEnrol>
<div class="table-responsive">
    <table class="table table-centered table-nowrap" id="PRVLines">
        <thead>
            <tr>
                <th>#</th>
                <th>Code</th>
                <th>Programme</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null && Model.Count() > 0)
                {
                    int i = 1;
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>@i</td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Prog)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ProgName)
                            </td>
                        </tr>
                        i++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="2" style="color:red">
                            No Records Found
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>



