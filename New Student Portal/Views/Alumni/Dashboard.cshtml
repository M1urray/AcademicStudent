@model New_Student_Portal.ViewModel.StudentDetailView
@using New_Student_Portal.Models;
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
    string StudentNo = "";
    string imgSrc = "";

    if (Session["username"] == null)
    {
        Response.Redirect(Url.Action("Login", "Login"));
    }
    else
    {
        StudentNo = Session["username"].ToString();
    }

    try
    {

        if (Session["ImgProfile"] == null)
        {
            var base64 = CommonClass.ProfilePicture(Session["Username"].ToString());
            if (base64 != "")
            {
                imgSrc = String.Format("data:image/gif;base64,{0}", base64);
                Session["ImgProfile"] = imgSrc;
            }
        }
        else
        {
            imgSrc = Session["ImgProfile"].ToString();
        }
    }
    catch (Exception ex)
    {
        ex.Data.Clear();
    }

    string CreditAmout = "0.00", DebitAmount = "0.00", Balance = "0.00";
    if (Model.Balance != 0)
    {
        Balance = Convert.ToDecimal(Model.Balance).ToString("#,##0.00");
    }
    if (Model.Debit_Amount != 0)
    {
        DebitAmount = Convert.ToDecimal(Model.Debit_Amount).ToString("#,##0.00");
    }
    if (Model.Credit_Amount != 0)
    {
        CreditAmout = Convert.ToDecimal(Model.Credit_Amount).ToString("#,##0.00");
    }
}
<style>
    .Padding {
        padding: 5px;
    }

    b {
        font-size: 12px;
    }

    .ClassDiv {
        background-color: black;
        padding: 3px;
        border-radius: 8px;
    }

        .ClassDiv:hover {
            background-color: #ff6a00;
        }

    .classHr {
        margin: 2px;
    }

    .badge {
        font-size: 32px;
        background-color: #00aeee;
        cursor: pointer;
    }

    thead {
        background-color: black;
        color: white;
    }
</style>
<div class="modal-content">
    <div class="modal-header" style="padding-top: 3px; padding-bottom: 3px">
        <h4 class="modal-title"><b>Alumni Dashboard</b></h4>
    </div>
    <div class="modal-body">
        <div class="row" style="font-size: 12px">
            <div class="col-sm-6">
                <div class="modal-content">
                    <div class="modal-header">
                        <h4 class="modal-title"><b>Basic information</b></h4>
                    </div>
                    <div class="modal-body">
                        <div class="col-md-3 col-lg-3 marginbottom20">
                            @{

                                if (imgSrc != "")
                                {
                                    <img src="@imgSrc" Height="115" Width="114" style="border-radius: 50% !important" />
                                }
                                else
                                {
                                    if (Model.Gender == "Female")
                                    {
                                        <img src="~/img/profile_f.png" Height="115" Width="114" style="border-radius: 50% !important" />
                                    }
                                    else
                                    {
                                        <img src="~/img/profile_m.png" Height="115" Width="114" style="border-radius: 50% !important" />
                                    }
                                }
                            }
                        </div>
                        <hr class="classHr" />
                        <div class="row">
                            <div class="col-md-4">
                                <label style="font-size: 12px; font-weight: bold">Reg. No</label>
                            </div>
                            <div class="col-md-8">
                                <span class="label label-warning">@Html.DisplayFor(model => model.No)</span>
                            </div>
                        </div>
                        <hr class="classHr" />
                        <div class="row">
                            <div class="col-md-4">
                                <label style="font-size: 12px; font-weight: bold">Name</label>
                            </div>
                            <div class="col-md-8">
                                <span class="label label-warning">@Html.DisplayFor(model => model.Name)</span>
                            </div>
                        </div>
                        <hr class="classHr" />
                        <div class="row">
                            <div class="col-md-4">
                                <label style="font-size: 12px; font-weight: bold">ID No</label>
                            </div>
                            <div class="col-md-8">
                                <span class="label label-warning">@Html.DisplayFor(model => model.ID_No)</span>
                            </div>
                        </div>
                        <hr class="classHr" />
                        <div class="row">
                            <div class="col-md-4">
                                <label style="font-size: 12px; font-weight: bold">Gender</label>
                            </div>
                            <div class="col-md-8">
                                <span class="label label-warning">@Html.DisplayFor(model => model.Gender)</span>
                            </div>
                        </div>
                        <hr class="classHr" />
                        <div class="row">
                            <div class="col-md-4">
                                <label style="font-size: 12px; font-weight: bold">Date of Birth</label>
                            </div>
                            <div class="col-md-8">
                                <span class="label label-warning">@Html.DisplayFor(model => model.Date_Of_Birth)</span>
                            </div>
                        </div>
                        <hr class="classHr" />
                        <div class="row">
                            <div class="col-md-4">
                                <label style="font-size: 12px; font-weight: bold">Phone Number</label>
                            </div>
                            <div class="col-md-8">
                                <span class="label label-warning">@Html.DisplayFor(model => model.Phone_No)</span>
                            </div>
                        </div>
                        <hr class="classHr" />
                        <div class="row">
                            <div class="col-md-4">
                                <label style="font-size: 12px; font-weight: bold">Address</label>
                            </div>
                            <div class="col-md-8">
                                <span class="label label-warning">@Html.DisplayFor(model => model.Address)</span>
                            </div>
                        </div>
                        <hr class="classHr" />
                        <div class="row">
                            <div class="col-md-4">
                                <label style="font-size: 12px; font-weight: bold">Email</label>
                            </div>
                            <div class="col-md-8">
                                <span class="label label-warning">@Html.DisplayFor(model => model.E_Mail)</span>
                            </div>
                        </div>
                        <hr class="classHr" />
                    </div>
                </div>
            </div>
            <div class="col-sm-6">
                <div class="panel panel-success">
                    <div class="panel-heading"><i class="fa fa-calendar"></i><b>Notifications</b></div>
                    <div class="panel-body" style="background-color: white; min-height: 400px">
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

