@model New_Student_Portal.ViewModel.StudentDetailView
@using New_Student_Portal.Models;
@{
    ViewBag.Title = "Alumni Dashboard";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
    string StudentNo = "";
    string imgSrc = "";

    if (Session["username"] == null)
    {
        Response.Redirect(Url.Action("Login", "Login"));
    }
    else
    {
        StudentNo = Session["username"].ToString();
    }

    try
    {

        if (Session["ImgProfile"] == null)
        {
            var base64 = CommonClass.ProfilePicture(Session["Username"].ToString());
            if (base64 != "")
            {
                imgSrc = String.Format("data:image/gif;base64,{0}", base64);
                Session["ImgProfile"] = imgSrc;
            }
        }
        else
        {
            imgSrc = Session["ImgProfile"].ToString();
        }
    }
    catch (Exception ex)
    {
        ex.Data.Clear();
    }

    string CreditAmout = "0.00", DebitAmount = "0.00", Balance = "0.00";
    if (Model.Balance != 0)
    {
        Balance = Convert.ToDecimal(Model.Balance).ToString("#,##0.00");
    }
    if (Model.Debit_Amount != 0)
    {
        DebitAmount = Convert.ToDecimal(Model.Debit_Amount).ToString("#,##0.00");
    }
    if (Model.Credit_Amount != 0)
    {
        CreditAmout = Convert.ToDecimal(Model.Credit_Amount).ToString("#,##0.00");
    }
}
<style>
    .card, .card-title {
        color: white
    }

    .card-header, .card-title {
        background-color: #192f59;
    }

    .card-title {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-left: 10px;
    }

    thead {
        background-color: #b0a2a2;
        color: black
    }

    table {
        border: 2px solid #b0a2a2;
    }
</style>
<div class="modal-content">
    <h4 class="card-title">Basic information</h4>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-6 col-md-2 col-lg-2">
                @{

                    if (imgSrc != "")
                    {
                        <img src="@imgSrc" Height="115" Width="114" style="border-radius: 50% !important" />
                    }
                    else
                    {
                        if (Model.Gender == "Female")
                        {
                            <img src="~/img/profile_f.png" Height="115" Width="114" style="border-radius: 50% !important" />
                        }
                        else
                        {
                            <img src="~/img/profile_m.png" Height="115" Width="114" style="border-radius: 50% !important" />
                        }
                    }
                }
                <hr />
            </div>
            <div class="col-sm-6 col-md-10 col-lg-10">
                <div class="row modal-dialog-scrollable">
                    <div class="col-sm-6 col-md-6">
                        <div class="row mb-3">
                            <label class="col-md-4">Reg. No</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.No)</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-4"> Name</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.Name)</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-4"> ID No</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.ID_No)</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-4">Gender</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.Gender)</span>
                            </div>
                        </div>
                    </div> <!-- end col -->
                    <div class="col-sm-6 col-md-6">
                        <div class="row mb-3">
                            <label class="col-md-4"> Address</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.Address)</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-4">Email</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.E_Mail)</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-4"> Date Of Birth</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.Date_Of_Birth)</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-4"> Campus</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.Campus)</span>
                            </div>
                        </div>
                    </div> <!-- end col -->
                </div> <!-- end row -->
            </div>
        </div>
    </div> <!-- end card-body -->

</div>
<div class="modal-content">
    <h4 class="card-title">Daystar Programme Enrollment List</h4>
    <div class="card-body">
        <div id="divProgEnromnt"></div>
    </div> <!-- end card-body -->
</div>
<div class="modal-content">
    <h4 class="card-title">Employment History</h4>
    <div class="card-body">
        <div id="divEmpHist"></div>
    </div> <!-- end card-body -->
</div>
<div class="modal-content">
    <h4 class="card-title">Qualification History</h4>
    <div class="card-body">
        <div id="divQualHist"></div>
    </div> <!-- end card-body -->
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModal" class="modal" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelT"></label></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        LoadProgrammeEnrolmentLines();
    });
    var LoadProgrammeEnrolmentLines = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            url: "/Alumni/ProgrammeEnrollment",
            success: function (data) {
                $("#divProgEnromnt").html(data);
                HideProgress();
                LoadEmploymentHistLines();
            },
            error: function () {
                HideProgress();
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    };
    var LoadEmploymentHistLines = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            url: "/Alumni/EmplHistList",
            success: function (data) {
                $("#divEmpHist").html(data);
                HideProgress();
                LoadQualificationLines();
            },
            error: function () {
                HideProgress();
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    };
    var LoadQualificationLines = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            url: "/Alumni/EducHistList",
            success: function (data) {
                $("#divQualHist").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                Swal.fire("There is some problem to process your request. Please try after some time");
            }
        });
    };
    var NewEmpHist = function () {
        $("#labelT").text("New Employment History Form");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Alumni/NewEmplymentHist',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    };
    var NewQualHist = function () {
        $("#labelT").text("New Qualification Form");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Alumni/NewQualifHist',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    };
    var SubmitStudentEmpHist = function () {       
        var from = $("#txtFrom").val();
        var to = $("#txtTo").val();
        var Institution = $("#txtInstitution").val();
        var Title = $("#txtTitle").val();
        if (from == "") {
            Swal.fire('Warning', "Select from date", 'warning');
            return;
        }
        else if (to == "") {
            Swal.fire('Warning', "Select to date", 'warning');
            return;
        }
        else if (Institution == "") {
            Swal.fire('Warning', "Enter institution", 'warning');
            return;
        }
        else if (Title == "") {
            Swal.fire('Warning', "Enter Job Title", 'warning');
            return;
        }
        else {
            ShowProgress();

            var EmpHist = {};
            EmpHist.From = from;
            EmpHist.To = to;
            EmpHist.Title = Title;
            EmpHist.Company = Institution;

            $.ajax({
                type: "POST",
                url: "/Alumni/SubmitEmpHistLine",
                data: JSON.stringify({ empHist: EmpHist }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success) {
                        HideProgress();
                        LoadEmploymentHistLines();
                        $("#myModal").modal("hide");
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        Swal.fire('Warning', data.message, 'warning');
                        HideProgress();
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    }
    var SubmitStudentQual = function () {
        var from = $("#txtQFrom").val();
        var to = $("#txtQTo").val();
        var Institution = $("#txtInstitution").val();
        var Award = $("#txtAward").val();
        if (from == "") {
            Swal.fire('Warning', "Select from date", 'warning');
            return;
        }
        else if (to == "") {
            Swal.fire('Warning', "Select to date", 'warning');
            return;
        }
        else if (Institution == "") {
            Swal.fire('Warning', "Enter institution", 'warning');
            return;
        }
        else if (Award == "") {
            Swal.fire('Warning', "Enter reward", 'warning');
            return;
        }
        else {
            ShowProgress();

            var QualHist = {};
            QualHist.From = from;
            QualHist.To = to;
            QualHist.Institution = Institution;
            QualHist.Award = Award;

            $.ajax({
                type: "POST",
                url: "/Alumni/SubmitQualHistLine",
                data: JSON.stringify({ qual: QualHist }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success) {
                        HideProgress();
                        LoadQualificationLines();
                        $("#myModal").modal("hide");
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        Swal.fire('Warning', data.message, 'warning');
                        HideProgress();
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Warning', err, 'warning');
                }
            });
        }
    }
    var RemoveEmpHistLine = function (LnNo) {
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            type: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
            if (result.value) {
                ShowProgress();
                $.ajax({
                    type: "POST",
                    url: "/Purchase/RemovePurchaseLine",
                    data: JSON.stringify({ DocNo: DocNo, LnNo: LnNo }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        if (data.success) {
                            HideProgress();
                            LoadPurchaseDocumentLines(DocNo, 'Open');
                            $("#myModal").modal("hide");
                            Swal.fire('Success', data.message, 'success');
                        }
                        else {
                            Swal.fire('Warning', data.message, 'warning');
                            HideProgress();
                        }
                    },
                    error: function (err) {
                        HideProgress();
                        Swal.fire('Warning', err, 'warning');
                    }
                });
            }
            else {
                Swal.fire('Cancelled', 'Purchase line has not been deleted', 'error');
            }
        });
    };
</script>
