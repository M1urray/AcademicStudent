
@{
    ViewBag.Title = "NewProgrammeApplication";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<div class="modal-content">
    <div class="modal-header" style="padding-top: 3px; padding-bottom: 3px">
        <h4 class="modal-title"><b>New Programme Application</b></h4>
    </div>
    <div class="modal-body">
        <div class="stepwizard">
            <div class="stepwizard-row setup-panel">
                <div class="stepwizard-step">
                    <button type="button" class="btn btn-primary btn-circle" disabled>1</button>
                    <p class="d-none d-sm-block">Programme</p>
                </div>
                <div class="stepwizard-step">
                    <button type="button" class="btn btn-secondary btn-circle" disabled>2</button>
                    <p class="d-none d-sm-block">Education</p>
                </div>
                <div class="stepwizard-step">
                    <button type="button" class="btn btn-secondary btn-circle" disabled>3</button>
                    <p class="d-none d-sm-block">Grades</p>
                </div>
                <div class="stepwizard-step">
                    <button type="button" class="btn btn-secondary btn-circle" disabled>4</button>
                    <p class="d-none d-sm-block">Contacts</p>
                </div>
                <div class="stepwizard-step">
                    <button type="button" class="btn btn-secondary btn-circle" disabled>5</button>
                    <p class="d-none d-sm-block">Submission</p>
                </div>
            </div>
        </div>
        <div id="divSteps"></div>
    </div>
</div>
<script src="~/JS/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        GetStepSection('StepOneView');
    });
    function GetStepSection(Step) {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: "/Allumni/" + Step,
            success: function (data) {
                $("#divSteps").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                swal('Warning', 'There is some problem to process your request. Please try after some time', 'warning');
            }
        });
    }
    function SubmitStepOneSection() {
        ShowProgress();
        $.ajax({
            type: "POST",
            url: "/Allumni/SaveStepOneData",
            //data: JSON.stringify(UnitReg),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    GetStepSection('StepTwoView');
                }
                else {
                    HideProgress();
                    swal('Warning', data.message, 'warning');
                }
            },
            error: function () {
                HideProgress();
                swal('Warning', 'There is some problem to process your request. Please try after some time', 'warning');
            }
        });
    }
