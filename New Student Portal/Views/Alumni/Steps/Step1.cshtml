 <!--step-1-->
<div id="step-1">
    <div class="d-flex justify-content-center pt-0 mt-0">
        <div class="col-xs-12 col-sm-12 col-md-12 col-lg-12 ">
            <div class="panel border-theme-color customPanel">
                <div class="panel-heading bg-theme-color text-center d-flex justify-content-center pl-2 pr-2">
                    Step 1/6<span class="d-none d-sm-block"> - Personal & Programme Info.</span>
                </div>
                <div class="panel-body pb-2">
                    <h5>Programme Details</h5>
                    <div class="row">
                        <!--campus name-->
                        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="form-group">
                                <label class="control-label">Campus</label>
                                <select name="campus" class="form-control " id="campus" onchange="onCampusCategoryChange(1)" required>
                                    <option value="" selected>--Select--</option>
                                    <option value="MAIN" selected>Main Campus</option>
                                    <option value="NAIROBI">Nairobi Campus</option>
                                </select>
                            </div>
                        </div>
                        <!--programme level-->
                        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="form-group">
                                <label class="control-label">Programme level</label>
                                <select name="programme_level" class="form-control " id="programme_level" onchange="onCampusCategoryChange(1)" required>
                                    <option value="" selected>--Select--</option>
                                    <option value="Certificate ">Certificate</option>
                                    <option value="Diploma">Diploma</option>
                                    <option value="Undergraduate" selected>Bachelors/Degree</option>
                                    <option value="Masters">Masters</option>
                                    <option value="PHD">PHD</option>
                                </select>
                            </div>
                        </div>
                        <!--programme name-->
                        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="form-group">
                                <label class="control-label">Programme name</label>
                                <select name="programme" class="form-control " id="programme" onchange="onProgrammeChange()" disabled data-live-search="true" data-style="btn-default" data-container="body" required>
                                </select>
                            </div>
                        </div>
                        <!--intake-->
                        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="form-group">
                                <label class="control-label">Intake</label>
                                <select name="intake" class="form-control " id="intake" disabled required>
                                </select>
                            </div>
                        </div>
                        <!--programme level-->
                        <div class="col-xs-12 col-sm-6 col-md-4 col-lg-3">
                            <div class="form-group">
                                <label class="control-label">Mode of Study</label>
                                <select name="study_mode" class="form-control " id="study_mode" required>
                                    <option value="">--Select--</option>
                                    <option value="FULLTIME" selected>Full Time</option>
                                    <option value="ONLINE">Online</option>
                                    <option value="PARTTIME">Part Time</option>
                                </select>
                            </div>
                        </div>
                        <!--phone number-->
                        <!--<div class="col-xs-12 col-sm-6 col-md-4 col-lg-3 column hidden" id="indexNo">
                            <div class="form-group">
                                <label class="control-label">KCSE Index No.</label>
                                <input type="text"class="form-control " name="indexNo" placeholder="e.g 12345/2019" value="">
                            </div>
                        </div>-->
                    </div><!--/row-Programme details-->
                    <hr />
                    <div class="rowx text-center">                        
                        <button type="submit" class="btn btn-primary" onclick="SubmitStepOneSection()">Next <i class="feather icon-arrow-right"></i></button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
