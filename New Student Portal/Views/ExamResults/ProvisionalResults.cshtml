@model IEnumerable<New_Student_Portal.ViewModel.ExamSemesters>
@{
    ViewBag.Title = "Provisional Results";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<style>
    .rowFocus {
        background-color: red;
        border: solid 1px lightblue;
    }

    .RemoverowFocus {
        background-color: white;
    }

    tr.border_bottom td {
        border-bottom: 1px solid black;
        border-top: 1px solid black;
        font-weight: bolder
    }

    .pre-scrollable {
        max-height: none
    }
</style> 
<div class="modal-content">    
    <div class="modal-body pre-scrollable">
        <table class="table table-hover" style="font-size:12px">
            <thead style="color:white;background-color:black">
                <tr>
                    <th>
                        Unit
                    </th>
                    <th>
                        Description
                    </th>
                    <th style="text-align:center">
                        Credits
                    </th>
                    <th style="text-align:center">
                        Marks
                    </th>
                    <th style="text-align:center">
                        Grade
                    </th>
                    <th style="text-align:center">
                        QP
                    </th>

                </tr>
            </thead>
            @{
                if (Model != null)
                {
                    if (Model.Count() > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tbody>
                                @{
                                    <tr style="color:white;background-color:cadetblue">
                                        <td colspan="6">@item.Semester</td>
                                    </tr>
                                    decimal TotalGPA = 0, TotalQltPoint = 0, TotalUnits = 0, AVGQPoints = 0, TotalCredits = 0;
                                    if (item.ListOfResults.Count() > 0)
                                    {
                                        foreach (var Res in item.ListOfResults)
                                        {
                                            <tr>
                                                <td>
                                                    @Html.DisplayFor(modelItem => Res.Unit)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => Res.UnitName)
                                                </td>
                                                <td align="center">
                                                    @Html.DisplayFor(modelItem => Res.Credits)
                                                </td>
                                                <td align="center">
                                                    @Html.DisplayFor(modelItem => Res.Marks)
                                                </td>
                                                <td align="center">
                                                    @Html.DisplayFor(modelItem => Res.Grade)
                                                </td>
                                                <td align="center">
                                                    @Html.DisplayFor(modelItem => Res.GltyPoints)
                                                </td>
                                            </tr>
                                            TotalGPA = TotalGPA + Convert.ToDecimal(Res.GPA);
                                            TotalQltPoint = TotalQltPoint + Convert.ToDecimal(Res.GltyPoints);
                                            TotalUnits = TotalUnits + Convert.ToDecimal(Res.TotalUnits);
                                            TotalCredits = TotalCredits + Convert.ToDecimal(Res.Credits);
                                        }
                                        AVGQPoints = Math.Round((TotalQltPoint / TotalUnits), 2);
                                        <tr class="border_bottom">
                                            <td colspan="2" align="right">Totals</td>
                                            <td align="center">
                                                @TotalCredits
                                            </td>
                                            <td colspan="2"></td>
                                            <td align="center">
                                                @TotalQltPoint
                                            </td>
                                        </tr>
                                        <tr class="border_bottom">
                                            <td colspan="5" align="right">Term GPA</td>
                                            <td align="center">
                                                @AVGQPoints
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" style="color:red">
                                                No Records found
                                            </td>
                                        </tr>
                                    }

                                }
                            </tbody>
                        }
                    }
                    else
                    {
                        <tbody>
                            <tr>
                                <td colspan="6" style="color:red">
                                    No Records found
                                </td>
                            </tr>
                        </tbody>
                    }
                }
            }
        </table>
    </div>
</div>



