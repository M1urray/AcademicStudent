@model IEnumerable<New_Student_Portal.ViewModel.ExamSemesters>
@{
    // ViewBag.Title = "Provisional Results";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<style>
    .rowFocus {
        background-color: red;
        border: solid 1px lightblue;
    }

    .RemoverowFocus {
        background-color: white;
    }

    tr.border_bottom td {
        border-bottom: 1px solid black;
        border-top: 1px solid black;
        font-weight: bolder
    }

    .pre-scrollable {
        max-height: none
    }
</style>


<div class="modal-content">
    <div class="modal-body pre-scrollable">
        <div>
            <input type="button" value="Print Transcript" class="btn btn-danger" onclick="PrintFeeStatement();" />
        </div>
        <hr />
        <table class="table table-hover" style="font-size: 12px">
            <thead style="color: white; background-color: black">
                <tr>
                    <th>
                        Unit
                    </th>
                    <th>
                        Description
                    </th>
                    @*<th style="text-align:center">
                            Credits
                        </th>*@
                    <th style="text-align: center">
                        Grade
                    </th>
                </tr>
            </thead>
            @{
                if (Model != null)
                {
                    if (Model.Count() > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tbody>
                                @{
                                    <tr style="color: white; background-color: cadetblue">
                                        <td colspan="6">@item.Semester</td>
                                    </tr>
                                    decimal TotalGPA = 0, TotalQltPoint = 0, TotalUnits = 0, AVGQPoints = 0, TotalCredits = 0;
                                    if (item.ListOfResults.Count() > 0)
                                    {
                                        foreach (var Res in item.ListOfResults)
                                        {
                                            decimal TotalCred = 0;
                                            //TotalCred = Convert.ToDecimal(Res.Credits) * 15;
                                            <tr>
                                                <td>
                                                    @Html.DisplayFor(modelItem => Res.Unit)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => Res.UnitName)
                                                </td>
                                                @*<td align="center">
                                                        @TotalCred
                                                    </td>*@
                                                <td align="center">
                                                    @Html.DisplayFor(modelItem => Res.Grade)
                                                </td>
                                            </tr>
                                            //TotalGPA = TotalGPA + Convert.ToDecimal(Res.GPA);
                                            //TotalQltPoint = TotalQltPoint + Convert.ToDecimal(Res.GltyPoints);
                                            //TotalUnits = TotalUnits + Convert.ToDecimal(Res.TotalUnits);
                                            //TotalCredits = TotalCredits + TotalCred;
                                        }
                                        @*AVGQPoints = Math.Round((TotalQltPoint / TotalUnits), 2);
                                            <tr class="border_bottom">
                                                <td colspan="2" align="right">Totals</td>
                                                <td align="center">
                                                    @TotalCredits
                                                </td>
                                                <td colspan="2"></td>
                                            </tr>*@
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" style="color: red">
                                                No Records found
                                            </td>
                                        </tr>
                                    }

                                }
                            </tbody>
                        }
                    }
                    else
                    {
                        <tbody>
                            <tr>
                                <td colspan="6" style="color: red">
                                    No Records found
                                </td>
                            </tr>
                        </tbody>
                    }
                }
            }
        </table>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModalUnits" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Fee Statement</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
                <iframe id="iframe" style="width:100%;height:450px"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var PrintFeeStatement = function () {
        ShowProgress();
        $.ajax({
            url: '/ViewDocuments/ProvisionalResults',
            type: "POST",
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', data.message);
                    $("#myModalUnits").modal("show");
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }

            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>



