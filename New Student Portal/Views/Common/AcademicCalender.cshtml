@model IEnumerable<New_Student_Portal.ViewModel.Academic_Calender>
<style>
    thead {
        background-color: black;
        color: white;
    }
</style>
<div class="card">
    <div class="card-body">
        <div class="responsive-table-plugin">
            <div class="table-rep-plugin">
                <div class="table-responsive" data-pattern="priority-columns">
                    <table id="tech-companies-1" class="table table-striped table-hover" style="font-size:12px">
                        <thead>
                            <tr>
                                <th width="60%">
                                    Event Name
                                </th>
                                <th width="20%">
                                    Start Date
                                </th>
                                <th width="20%">
                                    End Date
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (Model != null)
                                {
                                    if (Model.Count() > 0)
                                    {
                                        foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Event)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.StartDate)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.EndDate)
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="3" style="color:red">
                                                No Records Found
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
