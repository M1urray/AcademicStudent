@model New_Student_Portal.ViewModel.Payment

@{
    ViewBag.Title = "Payment Via ECitizen";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}

<div class="container">
    <div class="row">
        <div class="col-md-12 col-md-12">
            <div class="card">
                <div class="card-body">
                    <form id="payment-form" method="post" action="https://payments.ecitizen.go.ke/PaymentAPI/iframev2.1.php" target="my_frame">
                        <input type="hidden" name="apiClientID" value="@Html.Raw(@Model.apiClientID)">
                        <input type="hidden" name="secureHash" value="@Html.Raw(@Model.secureHash)">
                        <input type="hidden" name="billDesc" value="@Html.Raw(@Model.billDesc)">
                        <input type="hidden" name="billRefNumber" value="@Html.Raw(@Model.billRefNumber)">
                        <input type="hidden" name="currency" value="@Html.Raw(@Model.currency)">
                        <input type="hidden" name="serviceID" value="@Html.Raw(@Model.serviceID)">
                        <input type="hidden" name="clientMSISDN" value="@Html.Raw(@Model.clientMSISDN)">
                        <input type="hidden" name="clientName" value="@Html.Raw(@Model.clientName)">
                        <input type="hidden" name="clientIDNumber" value="@Html.Raw(@Model.clientIDNumber)">
                        <input type="hidden" name="clientEmail" value="@Html.Raw(@Model.clientEmail)">
                        <input type="hidden" name="callBackURLOnSuccess" value="@Html.Raw(@Model.callBackURLOnSuccess)">
                        <input type="hidden" name="notificationURL" value="@Html.Raw(@Model.notificationURL)">
                        <input type="hidden" name="amountExpected" value="@Html.Raw(@Model.amountExpected)">
                    </form>
                    <iframe name="my_frame" style="border:none; width:100%; height:800px;"></iframe>

                </div> <!-- end card-body -->
            </div> <!-- end card-->
        </div>
    </div>
</div>

<script>
  document.getElementById('payment-form').submit();
  function resizeIframe(obj) {
    obj.style.height = obj.contentWindow.document.documentElement.scrollHeight + 'px';
  }
</script>

