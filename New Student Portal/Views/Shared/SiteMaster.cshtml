@using New_Student_Portal.CustomSecurity;
@using New_Student_Portal.Models;
@using System.Globalization;
@{
    Layout = null;
    var currentUser = User as New_Student_Portal.CustomSecurity.CustomPrincipal;

    string userRole = currentUser.RoleName;
    bool fullAccess = currentUser.Full_Access;
    bool PrintExam = false, AllowExamCard = false, AllowEval = false, AllowApplication = false, AllowGradAppl = false; ;
    string UserName = "";
    string ProfilePicBase64 = "", gender = "", imgSrc = "";
    int CountNotif = 0;
    //AllowApplication = CommonClass.AllowGradClearanceApplication(currentUser.);

    if (Session["Username"] == null)
    {
        Response.Write("<script type='text/javascript'>"); Response.Write("window.location = '" + Url.Action("Login", "Login") + "'</script>");
        Response.Flush();
    }
    else
    {
        string StdNo = Session["Username"].ToString();
        AllowGradAppl = CommonClass.AllowGradClearanceApplication(StdNo);
        string Sem = "";
        if (Session["CurrentSem"] == null)
        {
            Session["CurrentSem"] = CommonClass.CurrentSemester("");
        }

        Sem = Session["CurrentSem"].ToString();
        string RegDeadlineDate = CommonClass.RegistrationDeadline(Sem);
        CountNotif = CommonClass.GetDocumentCount();
        if (RegDeadlineDate != "")
        {
            DateTime regDeadLine = DateTime.ParseExact(RegDeadlineDate.Replace("-", "/"), "dd/MM/yyyy", CultureInfo.InvariantCulture);
            if (regDeadLine <= DateTime.Today)
            {
                PrintExam = true;
            }
            else
            {
                PrintExam = false;
            }
        }
        bool[] s = CommonClass.LecEvaluationAllowed(Sem);
        AllowExamCard = s[0];
        AllowEval = s[1];
        if (Session["FullName"] == null)
        {
            UserName = New_Student_Portal.Models.CommonClass.GetStudentName(Session["Username"].ToString());
        }
        else
        {
            UserName = Session["FullName"].ToString();
        }
        if (UserName != "")
        {
            ProfilePicBase64 = CommonClass.ProfilePicture(StdNo);

            if (ProfilePicBase64 == "")
            {
                if (Session["Gender"] != null)
                {
                    if (Session["Gender"].ToString() == "Male")
                    {
                        gender = "Male";
                    }
                    else
                    {
                        gender = "Female";
                    }
                }
            }
            else
            {
                imgSrc = String.Format("data:image/gif;base64,{0}", ProfilePicBase64);
                Session["ImgProfile"] = imgSrc;
            }
        }
    }
}

