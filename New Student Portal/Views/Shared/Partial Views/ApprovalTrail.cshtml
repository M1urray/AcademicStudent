@model IEnumerable<New_Student_Portal.ViewModel.ApprovalEntries>
<table id="datatable-buttons" class="table table-bordered dt-responsive nowrap" style="border-collapse: collapse; border-spacing: 0; width: 100%;">
    <thead style="background-color:black;color:white">
        <tr>
            <th>Approver Name</th>
            <th>Date Sent for Approval</th>
            @*<th>Status</th>*@
        </tr>
    </thead>
    <tbody>
        @{
            if (Model != null && Model.Count() > 0)
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @Html.DisplayFor(modelItem => item.UserID)
                        </td>
                        <td>
                            @Html.DisplayFor(modelItem => item.DateSendForApproval)
                        </td>
                        @*<td>
                            @if (item.Status == "Open")
                            {
                                <span class="badge badge-outline-info">Pending Approval</span>
                            }
                            else if (item.Status == "Approved")
                            {
                                <span class="badge badge-outline-success">Approved</span>
                            }
                            else if (item.Status == "Created")
                            {
                                <span class="badge badge-soft-warning">Waiting Approval</span>
                            }
                            else
                            {
                                @Html.DisplayFor(modelItem => item.Status)
                            }
                        </td>*@
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="2" style="color:red">
                        No Records Found
                    </td>
                </tr>
            }
        }
    </tbody>
</table>

