@model New_Student_Portal.ViewModel.GradRequestInfomation
<div class="col-md-12" style="color:wheat">

    <h3>Requisition No. : @Model.ReqNo</h3>
    @if (Model.Balance > 0)
    {
        <p style="color:#efefef">Graduation request has been recieved. Awaiting clearance of Fee balance of @Model.Balance.ToString("#,##0.00")</p>
    }
    else
    {
        <p>Graduation request has been successfully recieved</p>
    }
    <hr />
    <div>
        <input type="button" id="btnGPayment" class="btn btn-danger" value="Graduation Fee Payment" onclick="NewGraduationfeePayment();" />
    </div>
    <hr />
</div>
