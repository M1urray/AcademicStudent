<style>
    .badge {
        display: inline-block;
        padding: 5px 10px;
        border: 1px solid #4CAF50; /* Green border color */
        border-radius: 10px; /* Rounded corners */
        background: #159ed5; /* Gradient background */
        color: white; /* White text color */
        font-family: Arial, sans-serif; /* Optional: Choose a font */
        font-size: 14px; /* Optional: Adjust font size */
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1); /* Subtle shadow */
    }

    .form-group {
        margin-bottom: 20px; /* Increased margin for better spacing */
    }
</style>

<div id="divForm">
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label for="RegNo" class="lblClass">Registration No</label>
                <span class="badge">@Model.No</span> <!-- Changed from label to span -->
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="fullName" class="lblClass">Full Name</label>
                <span class="badge">@Model.Name</span> <!-- Changed from label to span -->
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label for="IDNo" class="lblClass">National ID</label>
                <span class="badge">@Model.ID_No</span> <!-- Changed from label to span -->
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="IDaddress" class="lblClass">Address</label>
                <span class="badge">@Model.Address</span> <!-- Changed from label to span -->
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label for="txtTel" class="lblClass">Telephone</label>
                <span class="badge">@Model.Phone_No</span> <!-- Changed from label to span -->
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label for="txtEmail" class="lblClass">Email</label>
                <span class="badge">@Model.E_Mail</span> <!-- Changed from label to span -->
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                <label for="txtProg" class="lblClass">Programme</label>
                <span class="badge">@Model.Prog (@Model.ProgName)</span> <!-- Changed from label to span -->
            </div>
        </div>
    </div>
    <hr />
    <div align="center">
        <button type="button" id="btnSaving" class="btn btn-danger" onclick="SubmitClearanceRequest(`@Model.No`,`@Model.Prog`);">Make Request</button> <!-- Changed from input type="button" to button -->
    </div>
    <hr />
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#lblTitle").text("New Clearance Form");
    });
</script>
