@model New_Student_Portal.ViewModel.DropdownListValues
@{
    ViewBag.Title = "Student Complaint List";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<div class="card">
    <div class="card-body">
        <hr />
        <input type="button" class="btn btn-danger btnClass" value="New Compliant" onclick="NewEnquiry();" />
        <hr />
        <div id="divEnquiry"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModalEnquiry" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Complaint Form</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
                <div class="row" style="background-color:darkgrey">
                    <div class="col-md-6">
                        Issue Directed to
                        <select class="form-select" id="ddlInquiry">
                            <option value="">----</option>
                            <option value="1">Quality Assurance Department</option>
                            <option value="2">Corporate Affairs Department</option>
                            <option value="3">ICT Department</option>
                            <option value="4">Admissions Departent</option>
                        </select>
                        @*@Html.DropDownListFor(m => m.Code, new SelectList(Model.ListOfValues, "Value", "Text", Model.Code), "--Select Department--", new { @id = "ddlDim1", @class = "form-select" })*@
                        <br />
                    </div>
                    <div class="col-md-6"></div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-12">
                        Issue Description
                        <textarea id="txtQuery" rows="3" class="form-control"></textarea>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-12">
                        Priority
                        <select class="form-select" id="ddlPriority">
                            <option value="">----</option>
                            <option value="1">High</option>
                            <option value="2">Moderate</option>
                            <option value="3">Low</option>
                        </select>
                    </div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-12">
                        Attachment
                        <input type="file" class="form-control" id="fileProveAttachment" />
                    </div>
                </div>
                <hr />
                <div align="center">
                    <input type="button" id="btnSaving" class="btn btn-danger" value="Make Complaint" onclick="SubmitEnquiry();" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/JS/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoadEnquiryList();
    });
    function LoadEnquiryList() {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: "/Course/StudentEnquiryListView",
            success: function (data) {
                $("#divEnquiry").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                alert("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var NewEnquiry = function () {
        $("#myModalEnquiry").modal("show");
    }
    var SubmitEnquiry = function () {
        var Dep = $("#ddlInquiry").children("option:selected").val();
        var Priority = $("#ddlPriority").children("option:selected").val();
        var txtEnquiry = $("#txtQuery").val();
        if (Dep == "") {
            Swal.fire('Warning', 'Select Department', 'warning');
            return;
        }
        else if (txtEnquiry == "") {
            Swal.fire('Warning', 'Enter Enquiry', 'warning');
            return;
        }
        else if (Priority == "") {
            Swal.fire('Warning', 'Select Priority', 'warning');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                url: "/Course/SubmitEnquiry",
                datatype: "json",
                type: "POST",
                data: JSON.stringify({ Dep: Dep, Enquiry: txtEnquiry, Priority: Priority }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        LoadEnquiryList();
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        Swal.fire('Warning', data.message, 'warning');
                        HideProgress();
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
                }
            });
        }
    }
</script>


