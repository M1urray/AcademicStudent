
@{
    ViewBag.Title = "Student Enquiry List";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<div class="card">
    <div class="card-body">
        <hr />
        <input type="button" class="btn btn-danger btnClass" value="New Enquiry" onclick="NewEnquiry();" />
        <hr />
        <div id="divEnquiry"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModalEnquiry" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Enquiry Form</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
                <div class="row" style="background-color:darkgrey">
                    <div class="col-md-6">
                        Enquire From
                        <select class="form-control" id="ddlEnquiry" name="ddlEnquiry">
                            <option value="">----</option>
                            <option value="1">Admission</option>
                            <option value="2">Finance</option>
                            <option value="3">Dean of Student</option>
                            <option value="4">ICT</option>
                        </select>
                        <br />
                    </div>
                    <div class="col-md-6"></div>
                </div>
                <hr />
                <div class="row">
                    <div class="col-md-12">
                        Enter Enquiry
                        <textarea id="txtQuery" rows="3" class="form-control"></textarea>
                    </div>
                </div>
                <hr />
                <div align="center">
                    <input type="button" id="btnSaving" class="btn btn-danger" value="Make Enquiry" onclick="SubmitEnquiry();" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/JS/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoadEnquiryList();
    });
    function LoadEnquiryList() {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: '@Url.Action("StudentEnquiryListView", "Course")',
            success: function (data) {
                $("#divEnquiry").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                alert("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var NewEnquiry = function () {
        $("#myModalEnquiry").modal("show");
    }
    var SubmitEnquiry = function () {
        var ddlSendTo = $("#ddlEnquiry").children("option:selected").val();
        var txtEnquiry = $("#txtQuery").val();
        if (ddlSendTo == "") {
            Swal.fire('Warning', 'Select enquire from', 'warning');
            return;
        }
        else if (txtEnquiry == "") {
            Swal.fire('Warning', 'Enter Enquiry', 'warning');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                url: '@Url.Action("SubmitEnquiry", "Course")',
                datatype: "json",
                type: "POST",
                data: JSON.stringify({ Dep: ddlSendTo, Enquiry: txtEnquiry }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        LoadEnquiryList();
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        Swal.fire('Warning', data.message, 'warning');
                        HideProgress();
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
                }
            });
        }
    }
</script>


