@model New_Student_Portal.ViewModel.Clearance_Codes
<style>
    thead {
        background-color: black;
        color: white;
    }
</style>
<div class="row">
    <div class="col-md-12">
        <hr />
        <p class="text-googleplus">
            You have successfully requested for clearance. Follow the approval level to know where
            the document is pending
        </p>
        <hr />
        @if (Model.print)
        {
            <div class="row">
                <div class="col-md-12">
                    <button class="btn btn-sm btn-danger" onclick="PrintClearanceReport(`@Model.DocNo`);">Print Clearance Report</button>
                    <hr />
                </div>
            </div>
        }
        <div class="row">
            <div class="col-md-12">
                <table class="table table-hover" width="100%">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Approval Level</th>
                            <th style="text-align:center">Status</th>
                            <th>Approver(s)</th>
                            <th>Rejection Comment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.ApprovalCode.Count() > 0)
                        {
                            int i = 1;
                            foreach (var c in Model.ApprovalCode)
                            {
                                if (c.CommentExist && c.Status != "Approved")
                                {
                                    <tr class="bg-soft-danger">
                                        <td>@i</td>
                                        <td>@c.ApprovalCode</td>
                                        <td align="center">
                                            @if (c.Status == "Open")
                                            {
                                                <span class="badge badge-outline-danger">Pending Approval</span>
                                            }
                                            @if (c.Status == "Created")
                                            {
                                                <span class="badge badge-outline-warning">Waiting Approval</span>
                                            }
                                            @if (c.Status == "Approved")
                                            {
                                                <span class="badge badge-outline-success">Approved</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-success" onclick="ViewApprovalTrail(`@Model.DocNo`, `@c.Sequence`);">View Approvers</button>
                                        </td>
                                        <td>
                                            @if (c.CommentExist)
                                            {
                                                <button class="btn btn-sm btn-danger" onclick="GetRejectionComments(`@Model.DocNo`,`@c.Sequence`);">View Comments</button>
                                            }
                                            else
                                            {
                                                <span class="badge badge-soft-warning">No Comment</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td>@c.ApprovalCode</td>
                                        <td align="center">
                                            @if (c.Status == "Open")
                                            {
                                                <span class="badge badge-outline-danger">Pending Approval</span>
                                            }
                                            @if (c.Status == "Created")
                                            {
                                                <span class="badge badge-outline-warning">Waiting Approval</span>
                                            }
                                            @if (c.Status == "Approved")
                                            {
                                                <span class="badge badge-outline-success">Approved</span>
                                            }
                                        </td>
                                        <td>
                                            <button class="btn btn-sm btn-success" onclick="ViewApprovalTrail(`@Model.DocNo`, `@c.Sequence`);">View Approvers</button>
                                        </td>
                                        <td>
                                            @if (c.CommentExist)
                                            {
                                                <button class="btn btn-sm btn-danger" onclick="GetRejectionComments(`@Model.DocNo`,`@c.Sequence`,`@c.ApprovalCode`);">View Comments</button>
                                            }
                                            else
                                            {
                                                <span class="badge badge-soft-warning">No Comment</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                i++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        $("#lblTitle").text("Clearance Approval Entries(Document No: @Model.DocNo)");
    });  
</script>



