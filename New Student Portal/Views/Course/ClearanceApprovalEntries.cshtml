@model New_Student_Portal.ViewModel.Clearance_Codes
<style>
    thead {
        background-color: black;
        color: white;
    }
</style>
<div class="row">
    <div class="col-md-12">
        <hr />
        <p class="text-googleplus">
            You have successfully requested for clearance. Follow the approval level to know where
            the document is pending
        </p>
        <hr />
        @if (Model.print)
        {
            <div class="row">
                <div class="col-md-12">
                    <button class="btn btn-sm btn-danger" onclick="PrintClearanceReport(`@Model.DocNo`);">Print Clearance Report</button>
                    <hr />
                </div>
            </div>
        }
        <div class="row">
            <div class="col-md-12">
                <table class="table table-hover" width="100%">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Approval Level</th>
                            <th style="text-align:center">Status</th>
                            <th>Rejection Comment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.ApprovalCode.Count() > 0)
                        {
                            int i = 1;
                            foreach (var c in Model.ApprovalCode)
                            {
                                if (c.CommentExist && c.Status != "Approved")
                                {
                                    <tr class="bg-soft-danger">
                                        <td>@i</td>
                                        <td>@c.ApprovalCode</td>
                                        <td align="center">
                                            @if (c.Status == "Open")
                                            {
                                                <span class="badge badge-outline-danger">Pending Approval</span>
                                            }
                                            @if (c.Status == "Created")
                                            {
                                                <span class="badge badge-outline-warning">Waiting Approval</span>
                                            }
                                            @if (c.Status == "Approved")
                                            {
                                                <span class="badge badge-outline-success">Approved</span>
                                            }
                                        </td>
                                        <td>
                                            @if (c.CommentExist)
                                            {
                                                <button class="btn btn-sm btn-success" onclick="GetRejectionComments(`@Model.DocNo`,`@c.Sequence`,`@c.ApprovalCode`);">View Comments</button>
                                            }
                                            else
                                            {
                                                <span class="badge badge-soft-warning">No Comment</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td>@i</td>
                                        <td>@c.ApprovalCode</td>
                                        <td align="center">
                                            @if (c.Status == "Open")
                                            {
                                                <span class="badge badge-outline-danger">Pending Approval</span>
                                            }
                                            @if (c.Status == "Created")
                                            {
                                                <span class="badge badge-outline-warning">Waiting Approval</span>
                                            }
                                            @if (c.Status == "Approved")
                                            {
                                                <span class="badge badge-outline-success">Approved</span>
                                            }
                                        </td>
                                        <td>
                                            @if (c.CommentExist)
                                            {
                                                <button class="btn btn-sm btn-success" onclick="GetRejectionComments(`@Model.DocNo`,`@c.Sequence`,`@c.ApprovalCode`);">View Comments</button>
                                            }
                                            else
                                            {
                                                <span class="badge badge-soft-warning">No Comment</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                i++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModal" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Rejection Comments under</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">             
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModalReport" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Clearance Report</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
                <iframe id="iframe" style="width:100%;height:500px"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/assets/js/ShowProgression.js"></script>s
<script type="text/javascript">
    $(document).ready(function () {
        $("#lblTitle").text("Clearance Approval Entries(Document No: @Model.DocNo)");
    });
    var GetRejectionComments = function (DocNo, Sequence, ApprovalLevel) {
        $("#lblComment").text(ApprovalLevel);
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo, Seq: Sequence }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Common/DocumentApprovalComments',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModalLinks").modal("hide");
                $("#myModal").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var PrintClearanceReport = function () {
        ShowProgress();
        $.ajax({
            url: "/Course/PrintClearanceForm",
            type: "POST",
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', data.message);
                    $("#myModalReport").modal("show");
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }

            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    };
</script>



