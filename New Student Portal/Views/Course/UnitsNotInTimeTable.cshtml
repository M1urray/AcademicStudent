@model  IEnumerable<New_Student_Portal.ViewModel.TimeTableView>
@{
    ViewBag.Title = "Units Not In TimeTable";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
    int i = 1;
}
<style>
    .checkboxClass {
        width: 20px;
        height: 20px;
        padding: 0px;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style> 
<div class="modal-content">
    <div class="modal-header" style="padding-top: 3px; padding-bottom: 3px">
        <h4 class="modal-title"><span class="spanClass">Registered Units Not in Timetable</span></h4>
    </div>
    <div class="modal-body">
        <div class="row">
            <div class="col-md-12">
                <p style="color:red">
                    The units listed below are units that you had registered before but the timetable was updated hence the venue,the sections
                    and periods changed. You need to select the units again as listed below and then click on "Update changes". If you no
                    longer want to take the Units, then drop them
                </p>
            </div>
            <div class="col-md-12 pre-scrollable">
                <table class="table table-bordered table-hover" id="tableUnits">
                    <thead style="background-color:black;color:white">
                        <tr>
                            <th width="10%" style="text-align:right">Select</th>
                            <th>
                                Unit
                            </th>
                            <th>
                                Section
                            </th>
                            <th>
                                Day of Week
                            </th>
                            <th>
                                Period
                            </th>
                            <th>
                                Campus
                            </th>
                            <th>
                                Lecture Room
                            </th>
                            <th>
                                Lecturer
                            </th>
                            <th>
                                Action
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (Model != null)
                            {
                                if (Model.Count() > 0)
                                {
                                    foreach (var item in Model)
                                    {
                                        <tr>
                                            <td align="center">
                                                <input type="checkbox" class="checkboxClass" id="@i" value="@item.CF" />
                                            </td>
                                            <td>
                                                @item.Unit
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Section)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Day_of_Week)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Period)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Campus)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Lecture_Room)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Lecturer)
                                            </td>
                                            <td align="center">
                                                <button class="btn btn-warning BtnPadding" onclick="DropUnit('@item.Semester','@item.Unit')">Drop</button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="7" style="color:red">
                                            No Records Found
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<div align="center">
    <hr />
    <input type="button" id="btnSaving" class="btn btn-danger" value="Update Changes" onclick="SubmitSelectedUnits('');" />
</div> 
<script type="text/javascript">
    var SubmitSelectedUnits = function (ClassCodeNeeded) {
        var UnitReg = new Array();
        $("#tableUnits tbody tr").each(function () {
            var row = $(this);
            if (row.find('input[type="checkbox"]').is(':checked')) {
                var Unit = {};
                Unit.UnitCode = row.find("td").eq(1).html();
                Unit.ClassCode = row.find("td").eq(2).html();
                Unit.Day = row.find("td").eq(3).html();
                Unit.Period = row.find("td").eq(4).html();
                Unit.Campus = row.find("td").eq(5).html();
                UnitReg.push(Unit);
            }
        });
        if (UnitReg.length < 1) {
            swal('Warning', 'You have not selected any unit', 'warning');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                type: "POST",
                url: '@Url.Action("UpdateRegisteredUnits", "Course")',
                data: JSON.stringify(UnitReg),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success == true) {
                        window.location = '@Url.Action("CourseRegistration", "Course")';
                    }
                    else {
                        HideProgress();
                        swal('Warning', data.message, 'warning');
                    }
                },
                error: function () {
                    HideProgress();
                    swal('Error', data.message, 'error');
                }
            });
        }
    }
    var DropUnit = function (sem, Unit) {
        var UnitFilters = {};
        UnitFilters.prog = "";
        UnitFilters.stage = "";
        UnitFilters.sem = sem;
        UnitFilters.Unit = Unit;
        ShowProgress();
        $.ajax({
            url: '@Url.Action("DropRegisteredUnit", "Course")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ Filters: UnitFilters }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success == true) {
                    window.location = '@Url.Action("CourseRegistration", "Course")';
                }
                else {
                    HideProgress();
                    swal('Warning', data.message, 'warning');
                }
            },
            error: function () {
                HideProgress();
                swal('Error', data.message, 'error');
            }
        });
    }
</script>

