
@{
    ViewBag.Title = "Lecturer Evaluation";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<style>
    .rowFocus {
        background-color: red;
        border: solid 1px lightblue;
    }

    .RemoverowFocus {
        background-color: white;
    }
</style>
<div class="card">
    <div class="card-body">
        <h4 class="modal-title"><span class="spanClass">Lecturer Evaluation Units</span></h4>
        <hr />
        <div id="divRegUnits"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModalLecturerEvaluationForm" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelT"></label></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/JS/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoadCurrentRegisteredUnits();
    });
    function LoadCurrentRegisteredUnits() {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: '@Url.Action("CurrentRegistredUnits", "Course")',
            success: function (data) {
                $("#divRegUnits").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                Swal.fire('Error',"There is some problem to process your request. Please try after some time",'error');
            }
        });
    }
    var SelectedRowUnit = function (unit) {
        $("#labelT").text("Lecturer Evaluation Form");
        ShowProgress();
        $.ajax({
            type: "POST",
            url: '@Url.Action("LecturerEvaluationForm", "Course")',
            data: JSON.stringify({ Unit: unit }),
            contentType: "application/json; charset=utf-8",
            dataType: "html",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalLecturerEvaluationForm").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Error', "There is some problem to process your request. Please try after some time", 'error');
            }
        });
    }
