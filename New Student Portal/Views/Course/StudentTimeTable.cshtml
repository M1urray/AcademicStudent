@model IEnumerable<New_Student_Portal.ViewModel.TimeTableView>
@{
    ViewBag.Title = "Student Time Table";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }
</style>
<div class="card">
    <div class="card-body">
        <div class="responsive-table-plugin">
            <div class="table-rep-plugin">
                <div class="table-responsive" data-pattern="priority-columns">
                    <table class="table table-bordered table-hover">
                        <thead>
                            <tr>
                                <th>
                                    Day of Week
                                </th>
                                <th>
                                    Unit
                                </th>
                                <th>
                                    Period
                                </th>
                                <th>
                                    Lecture Room
                                </th>
                                <th>
                                    Lecturer
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (Model != null)
                                {
                                    if (Model.Count() > 0)
                                    {
                                        foreach (var item in Model)
                                        {
                                                        <tr>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Day_of_Week)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Unit)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Period)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Lecture_Room)
                                                            </td>
                                                            <td>
                                                                @Html.DisplayFor(modelItem => item.Lecturer)
                                                            </td>
                                                        </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="5" style="color:red">
                                                No Records Found
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

