@model New_Student_Portal.ViewModel.StudentDetailView
@{
    ViewBag.Title = "GraduationRequest";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<style>
    .checkboxClass {
        width: 20px;
        height: 20px;
        padding: 0px;
    }

    label {
        font-weight: bold;
    }

    b {
        font-size: 12px;
    }

    .badge-outline-info {
        overflow-wrap: break-word;
    }
</style>
<div class="card">
    <div class="card-body">
        <input type="button" class="btn btn-danger btnClass" value="New Requisition" onclick="NewRequisition();" />
        <hr />
        <div id="divGradLines"></div>
    </div> <!-- end card-body -->
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModalUnits" tabindex="-1" role="dialog" aria-labelledby="scrollableModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelT"></label></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script src="~/JS/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoadGraduationLines();
    });
    function LoadGraduationLines() {
        ShowProgress();
        $.ajax({
            async: false,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: "/Course/GraduationRequisitionLine",
            success: function (data) {
                $("#divGradLines").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'There is some problem to process your request. Please try after some time', 'warning');
            }
        });
    }
    var NewRequisition = function () {
        var x = document.getElementById("labelT");
        x.innerHTML = 'New Requisition Form';
        ShowProgress();
        $.ajax({
            url: "/Course/NewGraduationRequistion",
            datatype: "json",
            type: "POST",
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalUnits").modal("show");
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var ddlGownInterest = function () {
        var Intrested = $("#ddlGown").children("option:selected").val();
        if (Intrested == "1") {
            LoadCampus();
            document.getElementById("ddlGownCollection").disabled = true;
            $("#DivCollPoint").show();
        }
        else {
            $("#DivCollPoint").hide();
        }
    };
    var LoadCampus = function () {
        ShowProgress();
        $.getJSON("/Course/GetCampusList", null,
            function (data) {
                $("#ddlGownCollection").empty().append('<option selected="selected" value="">--Select Collection Point--</option>');
                $.each(data.ListOfCampus, function () {
                    $("#ddlGownCollection").append($("<option></option>").val(this['Value']).html(this['Text']));
                });
                $('#ddlGownCollection').val("MAIN");
                HideProgress();
            });
    }
    var SubmitGraduationRequest = function () {
        var PersoanlEmail = $("#txtPersEmail").val();
        var CurrentProfession = $("#txtCrrProf").val();
        var CurrentInst = $("#txtCrrCompany").val();
        var CurrentPhoneNo = $("#txtPhoneNo").val();
        var CorrectName = $("#txtCorrectName").val();
        var Prog = $("#ddlProg").children("option:selected").val();
        //var Gown = $("#ddlGown").children("option:selected").val();
        //var collectionPoint = $("#ddlGownCollection").children("option:selected").val();
        var disclaimer = $('input[name="Accept"]').prop("checked");
        if (PersoanlEmail == "") {
            Swal.fire('Warning', 'Enter Your personal Email', 'warning');
            return;
        }
        else if (IsEmail(PersoanlEmail) == false) {
            Swal.fire('Warning', 'Enter a valid personal Email', 'warning');
            return false;
        }
        else if (CurrentProfession == "") {
            Swal.fire('Warning', 'Enter Your Curret profession', 'warning');
            return;
        }
        if (CurrentInst == "") {
            Swal.fire('Warning', 'Enter Your Institution/Company', 'warning');
            return;
        }
        else if (CurrentPhoneNo == "") {
            Swal.fire('Warning', 'Enter Your Curret Phone Number', 'warning');
            return;
        }
        else if (Prog == "") {
            Swal.fire('Warning', 'Select Graduating Programme', 'warning');
            return;
        }
        //else if (Gown == "") {
        //    Swal.fire('Warning', 'Confirm if you will be interested in a gown', 'warning');
        //    return;
        //}
        //else if (Gown == "1" && collectionPoint == "") {
        //    Swal.fire('Warning', 'Choose your collection Point', 'warning');
        //    return;
        //}
        else if (disclaimer == false) {
            Swal.fire('Warning', 'Confirm the desclaimer before saving', 'warning');
            return;
        }
        else {
            var GownIntest = false;
            //if (Gown == "1") {
            //    GownIntest = true;
            //}
            //else {
            //    GownIntest = false;
            //}
            var GradRequest = {};
            GradRequest.PersoanlEmail = PersoanlEmail;
            GradRequest.CrrProf = CurrentProfession;
            GradRequest.Company = CurrentInst;
            GradRequest.CrrPhoneNo = CurrentPhoneNo;
            GradRequest.Gown = GownIntest;
            GradRequest.CollectionPoint = "";
            GradRequest.Prog = Prog;
            GradRequest.CorrectName = CorrectName;
            ShowProgress();
            $.ajax({
                url: "/Course/SubmitGraduationRequest",
                datatype: "json",
                type: "POST",
                data: JSON.stringify({ regData: GradRequest }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        //document.getElementById("txtPersEmail").disabled = true;
                        //document.getElementById("txtCrrProf").disabled = true;
                        //document.getElementById("txtCrrCompany").disabled = true;
                        //document.getElementById("txtPhoneNo").disabled = true;
                        ////document.getElementById("ddlGown").disabled = true;
                        //$("#DivMessange").show();
                        //HideProgress();
                        //LoadGraduationInf(data.Doc, data.Balance);
                        //$("#DivDisclaimer").hide();
                        HideProgress();
                        LoadGraduationLines();
                        $("#myModalUnits").modal("hide");
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('Warning', data.message, 'warning');
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Error', err, 'error');
                }
            });
        }
    };
    var LoadGraduationInf = function (DocNo, Bal) {
        $.ajax({
            url: "/Course/GraduationRequestInfo",
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ DocNo: DocNo, Bal: Bal }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                $("#divGradInf").html(data);
            },
            error: function (err) {
                Swal.fire('Error', err, 'error');
            }
        });
    };
    function IsEmail(email) {
        var regex = /^([\w-\.]+)@@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.)|(([\w-]+\.)+))([a-zA-Z]{2,4}|[0-9]{1,3})(\]?)$/;
        if (!regex.test(email)) {
            return false;
        } else {
            return true;
        }
    }
    var ViewApprovalTrail = function (DocNo) {
        $("#labelT").text("Document Approval Trail");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Common/DocumentApprovalTrail',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModalUnits").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var ViewComments = function (DocNo) {
        $("#labelT").text("Document Comments");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '/Common/DocumentComments',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModalUnits").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>

