@model New_Student_Portal.ViewModel.StudentDetailView
@{
    ViewBag.Title = "Graduation Request";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<style>
    .checkboxClass {
        width: 20px;
        height: 20px;
        padding: 0px;
    }

    label {
        font-weight: bold;
    }

    b {
        font-size: 12px;
    }
</style>
<div class="modal-content">
    <div class="modal-header">
        <h4 class="modal-title"><span class="spanClass">Graduation Request Form</span></h4>
    </div>
    <div class="modal-body">
        <div id="divForm">
            <div class="row mb-1" style="background-color:cadetblue;" id="DivMessange">
                <div id="divGradInf"></div>
            </div>
            <div class="row  mb-1">
                <div class="col-md-6">
                    <label for="RegNo" class="lblClass">Registration No :</label>
                    <label class="badge badge-outline-success">@Model.No</label>
                </div>
                <div class="col-md-6">
                    <label for="fullName" class="lblClass">Full Name :</label>
                    <label class="badge badge-outline-success">@Model.Name</label>
                </div>
            </div>
            <div class="row  mb-1">
                <div class="col-md-6">
                    <label for="IDNo" class="lblClass">National ID :</label>
                    <label class="badge badge-outline-success">@Model.ID_No</label>
                </div>
                <div class="col-md-6">
                    <label for="IDaddress" class="lblClass">Address :</label>
                    <label class="badge badge-outline-success">@Model.Address</label>
                </div>
            </div>
            <div class="row  mb-1">
                <div class="col-md-6">
                    <label for="IDaddress" class="lblClass">Phone No :</label>
                    <label class="badge badge-outline-success">@Model.Phone_No</label>
                </div>
                <div class="col-md-6">
                    <label for="txtEmail" class="lblClass">Email :</label>
                    <label class="badge badge-outline-success">@Model.E_Mail</label>
                </div>
            </div>
            <div class="row  mb-1">
                <div class="col-md-12">
                    <label for="txtProg" class="lblClass">Programme :</label>
                    <label class="badge badge-outline-success">@Model.Prog (@Model.ProgName)</label>
                </div>
            </div>
            <hr />
            <div class="row  mb-1">
                <div class="col-md-6">
                    <label for="txtPersEmail" class="lblClass">Personal Email Address</label>
                    <input type="email" class="form-control" id="txtPersEmail" placeholder="Personal Email" autocomplete="off">
                </div>
                <div class="col-md-6">
                    <label for="txtCrrProf" class="lblClass">Current Profession</label>
                    <input type="text" class="form-control" id="txtCrrProf" placeholder="Current Profession" required="" autocomplete="off">
                </div>
            </div>
            <div class="row  mb-1">
                <div class="col-md-6">
                    <label for="txtCrrCompany" class="lblClass">Current Institution/Company</label>
                    <input type="text" class="form-control" id="txtCrrCompany" placeholder="Current Institution/Company" required="" autocomplete="off">
                </div>
                <div class="col-md-6">
                    <label for="txtPhoneNo" class="lblClass">Current Phone Number</label>
                    <input type="text" class="form-control" id="txtPhoneNo" placeholder="Current Phone Number" required="" autocomplete="off">
                </div>
            </div>
            @*<hr />
                <div class="row  mb-1" id="DivDisclaimer">
                    <div class="col-md-12" style="background-color:#938d8d;color:#051936">
                        <h4>Disclaimer</h4>
                        <p>
                            <input type="checkbox" name="Accept" class="checkbox-circle checkboxClass">
                            This is how your Name will appear on your certificate <b><u>@Model.Name</u></b>.
                            If not please visit the Admission Office for correction.
                        </p>
                        <p>
                            NOTE: If your name has changed, visit the Admission Office with evidence of Name change. e.g.
                            sGazette Notice, Marriage Certificate, National Identification Card.
                        </p>
                    </div>
                </div>*@
            <div align="center" id="divSubmitButton">
                <hr />
                <input type="button" id="btnSaving" class="btn btn-danger" value="Make Request" onclick="SubmitGraduationRequest();" />
            </div>
            <hr />
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
