@model New_Student_Portal.ViewModel.StudentCourseRegistration
<style>
    thead {
        background-color: black;
        color: white;
    }

    .alignC {
        text-align: center;
    }

    tfoot {
        background-color: #051936;
        color: #cbcc32;
    }

    b, strong {
        font-size: 12px;
        text-decoration: underline;
    }

    .spanClass {
        font-size: 16px;
        font-weight: bold;
    }
</style>
<div class="responsive-table-plugin">
    <div class="table-rep-plugin">
        <div class="table-responsive" data-pattern="priority-columns">
            <h4>Registration List</h4>
            <table id="tech-companies-1" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th class="alignC" width="10%">Action</th>
                        <th>
                            Semester
                        </th>
                        <th class="alignC">
                            Unit Taken
                        </th>
                        <th>
                            Settlement Type
                        </th>
                        <th>
                            Registration Date
                        </th>
                        <th class="alignC">
                            Total Billed
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model.ListOfCourseRegistration != null)
                        {
                            if (Model.ListOfCourseRegistration.Count() > 0)
                            {
                                int i = 0;
                                foreach (var item in Model.ListOfCourseRegistration)
                                {
                                    <tr>
                                        <td align="center">
                                            <a href="#" class="btn btn-danger btn-sm" onclick="ViewUnits('@item.RegID','@item.Programme','@item.Stage','@item.Semester','@item.Register_for');">View Units</a>
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Semester)
                                        </td>
                                        <td align="center">
                                            @Html.DisplayFor(modelItem => item.UnitsTaken)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Settlement_Type)
                                        </td>
                                        <td>
                                            @Convert.ToDateTime(item.Registration_Date).ToString("yy/MM/yyyy")
                                        </td>
                                        <td align="center">
                                            @Convert.ToDecimal(item.TotalBilled).ToString("#,##0.00")
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" style="color:red">
                                        No Records Found
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<hr />
<div class="row" style="background-color: white;padding: 17px; border: 5px solid #7ca23b; border-radius: 10px">
    <div class="col-md-12" style="padding: 5px">
        <h4>COURSE REGISTRATION</h4>
        <h6>Registration Semester : <span style="font-size:12px" class="badge badge-soft-pink"> @Session["CurrentSem"].ToString()</span></h6>
        <hr />
        <span style="font-size: 10pt; color: orangered">
            Click on the button "<strong><em>Get Courses to Register</em></strong>".
            Select your Courses and click button "<strong><em> Add Selected Courses to the Basket</em></strong>", Confirm them then Complete registration by clicking button"<strong><em> Complete Registration.</em></strong>" You can view Proforma Invoice by clicking button "<strong><em> View Proforma Invoice</em></strong>"
        </span>
        @*<div class="row" style="visibility:collapse">
                <div class="col-md-4">
                    <span style="font-size: 16px; font-weight: bold">Registration Type:</span>
                    <select class="form-control" id="RegType" name="RegType">
                        <option value="1">Norminal Role</option>
                    </select>
                </div>
            </div>*@
        <hr />
        <div class="row">
            <div class="col-md-4 DivHostelDetails" id="divHostelT">
                <span style="font-size: 16px; font-weight: bold">Student Residents:</span>
                <div class="mb-3">
                    <select class="form-select" id="ddlInterest" name="ddlInterest" onchange="GetHostelList();">
                        <option value="">Choose Appropriately</option>
                        <option value="1">University Accommodation</option>
                        <option value="2">Private Accommodation outside Campus</option>
                        <option value="3">University Partnership</option>
                        <option value="4">Dayscholar</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4" id="divHostel">
                <div id="DivAvaHost">
                    <span style="font-size: 16px; font-weight: bold">Available Hostels:</span>
                    <select class="form-select" id="ddlHostelList" name="ddlHostelList" onchange="ShowUnitsRegSec();">
                    </select>
                </div>
            </div>
            <div class="col-md-4">
            </div>
        </div>
    </div>
    <div id="divRegUnits" style="background-color: #c5c3c3">
        <hr />
        <div class="row">
            <div class="col-md-4"><h5>Current Programme</h5>(@Model.RegProg.CurrentProgDesc)</div>
            <div class="col-md-4">
                <span style="font-size: 16px; font-weight: bold">Unit Category:</span>
                @Html.DropDownListFor(m => m.Code, new SelectList(Model.ListOfUnitCategory, "Value", "Text", Model.Code), "--Select Unit Type--", new { @id = "ddlUnitType", @class = "form-select" })
            </div>
            <div class="col-md-4">
                <br />
                <input type="button" class="btn btn-danger" value="Get Courses to Register" onclick="GetUnits('@Model.HostelCode', '@Model.RegProg.CurrentProg','0');" />
            </div>
        </div>
        @if (Model.RegProg.OtherProg != "")
        {
            <hr />
            <div class="row">
                <div class="col-md-4"><h5>Other Programme</h5>(@Model.RegProg.OtherProgDesc)</div>
                <div class="col-md-4">
                    <span style="font-size: 16px; font-weight: bold">Unit Category:</span>
                    @Html.DropDownListFor(m => m.Code, new SelectList(Model.ListOfUnitCategory1, "Value", "Text", Model.Code), "--Select Unit Type--", new { @id = "ddlUnitType1", @class = "form-select" })
                </div>
                <div class="col-md-4">
                    <br />
                    <input type="button" class="btn btn-danger" value="Get Courses to Register" onclick="GetUnits('@Model.HostelCode', '@Model.RegProg.OtherProg','1');" />
                </div>
            </div>
        }
        @if (Model.RegProg.SecondConc != "")
        {
            <hr />
            <div class="row">
                <div class="col-md-4"><h5>Second Concentration</h5>(@Model.RegProg.SecondConcDesc)</div>
                <div class="col-md-4">
                    <span style="font-size: 16px; font-weight: bold">Unit Category:</span>
                    @Html.DropDownListFor(m => m.Code, new SelectList(Model.ListOfUnitCategory2, "Value", "Text", Model.Code), "--Select Unit Type--", new { @id = "ddlUnitType2", @class = "form-select" })
                </div>
                <div class="col-md-4">
                    <br />
                    <input type="button" class="btn btn-danger" value="Get Courses to Register" onclick="GetUnits('@Model.HostelCode','@Model.RegProg.SecondConc','2');" />
                </div>
            </div>
        }
        @if (Model.RegProg.Minor != "")
        {
            <hr />
            <div class="row">
                <div class="col-md-4"><h5>Minor</h5>(@Model.RegProg.MinorDesc)</div>
                <div class="col-md-4">
                    <span style="font-size: 16px; font-weight: bold">Unit Category:</span>
                    @Html.DropDownListFor(m => m.Code, new SelectList(Model.ListOfUnitCategory3, "Value", "Text", Model.Code), "--Select Unit Type--", new { @id = "ddlUnitType3", @class = "form-select" })
                </div>
                <div class="col-md-4">
                    <br />
                    <input type="button" class="btn btn-danger" value="Get Courses to Register" onclick="GetUnits('@Model.HostelCode', '@Model.RegProg.Minor','3');" />
                </div>
            </div>
        }
        <hr />
    </div>
    <hr />
    <h4>Basket Unit List</h4>
    <div class="responsive-table-plugin">
        <div class="table-rep-plugin">
            <div class="table-responsive" data-pattern="priority-columns">
                <table id="tech-companies-1" class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>
                                Programme
                            </th>
                            <th>
                                Unit
                            </th>
                            <th>
                                Unit Name
                            </th>

                            <th>
                                Stage
                            </th>
                            <th>
                                Semester
                            </th>
                            <th>
                                Action
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (Model.ListOfStudentBasketUnits != null)
                            {
                                if (Model.ListOfStudentBasketUnits.Count() > 0)
                                {
                                    foreach (var item in Model.ListOfStudentBasketUnits)
                                    {
                                        <tr>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Programme)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Unit)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Unit_Name)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Stage)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Semester)
                                            </td>
                                            <td>
                                                <a href="#" onclick="DropUnit('@item.Programme','@item.Stage','@item.Semester','@item.Unit');">Drop</a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" style="color:red">
                                            No Records Found
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <input type="button" class="btn btn-primary form-control" value="View Proforma Invoice" onclick="GetProformaInvoice();" />
            <hr />
        </div>
        <div class="col-md-4">
            <input type="button" class="btn btn-danger form-control" value="Complete Registration" onclick="RegisterSelectedUnits();" />
            <hr />
        </div>
        <div class="col-md-4">
            <input type="button" class="btn btn-primary form-control" value="Print Course Statement" onclick="PrintCourseStatement();" />
            <hr />
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        if ('@Model.HostelCode' != "") {
            $("#divHostelT").hide();
            $("#divRegUnits").show();
        }
        else {
            $("#divHostelT").show();
            $("#divRegUnits").hide();
        }
        $("#divHostel").hide();
    });
    var ShowUnitsRegSec = function () {
        var Hostel = $("#ddlHostelList").children("option:selected").val();
        if (Hostel == "") {
            $("#divRegUnits").hide();
        }
        else {
            $("#divRegUnits").show();
        };
    };
    var GetHostelList = function () {
        var Interest = $("#ddlInterest").children("option:selected").val();
        if (Interest == "") {
            $("#ddlHostelList option").remove();
            $('#ddlHostelList').empty().append('<option selected="selected" value="">--Select Hostel--</option>');
            $("#divHostel").hide();
            $("#divRegUnits").hide();
        }
        else {
            if (Interest == "1") {
                ShowProgress();
                $("#divRegUnits").hide();
                $("#ddlHostelList option").remove();
                $('#ddlHostelList').empty().append('<option selected="selected" value="">--Select Hostel--</option>');

                $.getJSON("/Welfare/GetHostelList",
                    function (data) {
                        if (data.success == true) {
                            $('#ddlHostelList').empty().append('<option selected="selected" value="">--Select Hostel--</option>');
                            $.each(data.message.ListOfHostels, function () {
                                $("#ddlHostelList").append($("<option></option>").val(this['Value']).html(this['Text']));
                            });
                            $("#divHostel").show();
                            HideProgress();
                        }
                        else {
                            HideProgress();
                            Swal.fire('Warning', data.message, 'warning');
                        }
                    });
            }
            else {
                $("#ddlHostelList option").remove();
                $('#ddlHostelList').empty().append('<option selected="selected" value="">--Select Hostel--</option>');
                $("#divHostel").hide();
                $("#divRegUnits").show();
            }
        }
    }
</script>
