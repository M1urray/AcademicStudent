@model New_Student_Portal.ViewModel.StudentCourseRegistration
<style>
    thead {
        background-color: black;
        color: white;
    }

    tfoot {
        background-color: #051936;
        color: #cbcc32;
    }

    b, strong {
        font-size: 12px;
        text-decoration: underline;
    }

    .spanClass {
        font-size: 16px;
        font-weight: bold;
    }
</style>
<div class="pre-scrollable">
    <h4>Course Registration List</h4>
    <div class="responsive-table-plugin">
        <div class="table-rep-plugin">
            <div class="table-responsive" data-pattern="priority-columns">
                <table class="table table-bordered table-hover">
                    <thead>
                        <tr>
                            <th>Action</th>
                            <th>
                                Programme
                            </th>
                            <th>
                                Stage
                            </th>
                            <th>
                                Semester
                            </th>
                            <th align="center">
                                Unit Taken
                            </th>
                            <th>
                                Register for
                            </th>
                            <th>
                                Settlement Type
                            </th>
                            <th>
                                Registration Date
                            </th>
                            <th align="center">
                                Total Billed
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (Model.ListOfCourseRegistration != null)
                            {
                                if (Model.ListOfCourseRegistration.Count() > 0)
                                {
                                    foreach (var item in Model.ListOfCourseRegistration)
                                    {
                                        <tr>
                                            <td>
                                                <a href="#" onclick="ViewUnits('@item.RegID','@item.Programme','@item.Stage','@item.Semester','@item.Register_for');">View Units</a>
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Programme)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Stage)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Semester)
                                            </td>
                                            <td align="center">
                                                @Html.DisplayFor(modelItem => item.UnitsTaken)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Register_for)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Settlement_Type)
                                            </td>
                                            <td>
                                                @Convert.ToDateTime(item.Registration_Date).ToString("yy/MM/yyyy")
                                            </td>
                                            <td align="center">
                                                @Convert.ToDecimal(item.TotalBilled).ToString("#,##0.00")
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" style="color:red">
                                            No Records Found
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
<hr />
<div class="row" style="background-color: white; font-size: 8pt; padding: 17px; border: 5px solid #7ca23b; border-radius: 10px">
    <div class="col-md-12" style="padding: 5px">
        <h4>COURSE REGISTRATION</h4>
        <br />
        <b>Registration Semester : </b>
        @Session["CurrentSem"].ToString()
        <br />
        <br />
        <span style="font-size: 10pt; color: orangered">
            To register for course(s), Choose"<strong><em> Registration Type</em></strong>" then Click on the button "<strong><em>Get Courses to Register</em></strong>".
            Select your Courses and click button "<strong><em> Add Selected Courses to the Basket</em></strong>", Confirm them then Complete registration by clicking button"<strong><em> Complete Registration.</em></strong>"
        </span>
        <br />
        <br />
        <div class="row">
            <div class="col-md-4">
                <span style="font-size: 16px; font-weight: bold">Registration Type:</span>
                <select class="form-control" id="RegType" name="RegType">
                    <option value="">--Registration Type--</option>
                    <option value="0">Semester Units Registration</option>
                    <option value="1"> Bonus Course Registration</option>
                    @*<option value="2">Supplementary</option>w
                        <option value="3">Retake</option>*@
                </select>
            </div>
        </div>
        <br />
        <input type="button" class="btn btn-danger" value="Get Courses to Register" onclick="GetUnits();" />
        <hr style="border: 1px solid black" />
    </div>
    <div class="col-md-12" style="background-color: white; font-size: 8pt; padding: 5px">
        <h4>Basket Unit List</h4>
        <div class="responsive-table-plugin">
            <div class="table-rep-plugin">
                <div class="table-responsive" data-pattern="priority-columns">
                    <table class="table table-bordered table-hover" id="SelectedUnits">
                        <thead>
                            <tr>
                                <th>
                                    Programme
                                </th>
                                <th>
                                    Unit
                                </th>
                                <th>
                                    Unit Name
                                </th>

                                <th>
                                    Stage
                                </th>
                                <th>
                                    Semester
                                </th>
                                <th>
                                    Action
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (Model.ListOfStudentBasketUnits != null)
                                {
                                    if (Model.ListOfStudentBasketUnits.Count() > 0)
                                    {
                                        foreach (var item in Model.ListOfStudentBasketUnits)
                                        {
                                            <tr>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Programme)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Unit)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Unit_Name)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Stage)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Semester)
                                                </td>
                                                <td>
                                                    <a href="#" onclick="DropUnit('@item.Programme','@item.Stage','@item.Semester','@item.Unit');">Drop</a>
                                                </td>
                                            </tr>
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" style="color:red">
                                                No Records Found
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    <hr />
    <div class="row">
        @*<div class="col-md-4">
                <input type="button" class="btn btn-primary form-control" value="View Proforma Invoice" onclick="GetProformaInvoice();" />
                <hr />
            </div>*@
        <div class="col-md-12">
            <input type="button" class="btn btn-danger form-control" value="Complete Registration" onclick="RegisterSelectedUnits();" />
            <hr />
        </div>
        @*<div class="col-md-4">
                <input type="button" class="btn btn-primary form-control" value="Print Course Statement" onclick="PrintCourseStatement();" />
                <hr />
            </div>*@
    </div>
    <hr />
    <div class="row">
            <span style="font-size: 16px; font-weight: bold">Kindly make payment to MPESA Paybill 942780 and use Account Number as @Session["Username"]</span>
    </div>
