@model New_Student_Portal.ViewModel.StudentCourseRegistration
<style>
    thead {
        background-color: black;
        color: white;
    }

    .alignC {
        text-align: center;
    }

    tfoot {
        background-color: #051936;
        color: #cbcc32;
    }

    b, strong {
        font-size: 12px;
        text-decoration: underline;
    }

    .spanClass {
        font-size: 16px;
        font-weight: bold;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div class="responsive-table-plugin">
    <div class="table-rep-plugin">
        <div class="table-responsive" data-pattern="priority-columns">
            <h4>Registration List</h4>
            <table id="tech-companies-1" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th class="alignC" width="10%">Action</th>
                        @*<th>
                            Stage
                        </th>*@
                        <th>
                            Semester
                        </th>
                        <th class="alignC">
                            Unit Taken
                        </th>
                        <th>
                            Settlement Type
                        </th>
                        <th>
                            Registration Date
                        </th>
                        <th>
                            Register For
                        </th>
                        <th class="alignC">
                            Unposted Charges
                        </th>
                        <th class="alignC">
                            Total Billed
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model.ListOfCourseRegistration != null)
                        {
                            if (Model.ListOfCourseRegistration.Count() > 0)
                            {
                                int i = 0;
                                foreach (var item in Model.ListOfCourseRegistration)
                                {
                                    <tr>
                                        <td align="center">
                                            <a href="#" class="btn btn-danger btn-sm" onclick="ViewUnits('@item.RegID','@item.Programme','@item.Stage','@item.Semester','@item.Register_for');">View Units</a>
                                        </td>
                                        @*<td>
                                            @Html.DisplayFor(modelItem => item.Stage)
                                        </td>*@
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Semester)
                                        </td>
                                        <td align="center">
                                            @Html.DisplayFor(modelItem => item.UnitsTaken)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Settlement_Type)
                                        </td>
                                        <td>
                                            @Convert.ToDateTime(item.Registration_Date).ToString("yy/MM/yyyy")
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Register_for)
                                        </td>
                                        <td align="center">
                                            @Convert.ToDecimal(item.UnpostedCharges).ToString("#,##0.00")
                                        </td>
                                        <td align="center">
                                            @Convert.ToDecimal(item.TotalBilled).ToString("#,##0.00")
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" style="color:red">
                                        No Records Found
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<hr />
<div class="row" style="background-color: white;padding: 17px; border: 5px solid #7ca23b; border-radius: 10px">
    <div class="col-md-12" style="padding: 5px">
        <h4>COURSE REGISTRATION</h4>
        <h6>Registration Semester : <span style="font-size:12px" class="badge badge-soft-pink"> @Session["CurrentSem"].ToString()</span></h6>
        <hr />
        <span style="font-size: 10pt; color: orangered">
            Click on the button "<strong><em>Get Courses to Register</em></strong>".
            Select your Courses and click button "<strong><em> Add Selected Courses to the Basket</em></strong>", Confirm them then Complete registration by clicking button"<strong><em> Complete Registration.</em></strong>" You can view Proforma Invoice by clicking button "<strong><em> View Proforma Invoice</em></strong>"
        </span>
        <hr />
        <div style="background-color: #afaaaa;padding:10px">
            <h4>Filters</h4>
            <hr />
            <div class="row">
                <div class="col-md-4">
                    <span style="font-size: 16px; font-weight: bold">Registration Type:</span>
                    <select class="form-select" id="RegType" name="RegType" onchange="ShowBasketUnits();">
                        
                        <option value="1" selected>Normal</option>
                        <option value="2">Supplementary</option>
                        <option value="3">Retake</option>
                    </select>
                </div>
                <div class="col-md-4" id="divStage">
                    <span style="font-size: 16px; font-weight: bold">Unit Category:</span>
                    @Html.DropDownListFor(model => model.Code, Model.ListOfUnitCategory, "--Select Unit Category --", new { @class = "form-select", @id = "ddlStage", @onchange = "ShowProgOption();" })
                </div>
                <div class="col-md-4" id="divOption">
                    <span style="font-size: 16px; font-weight: bold">Programme Option:</span>
                    <select class="form-select" id="ddlProgOption" name="ddlProgOption">
                    </select>
                </div>
            </div>
            <hr />
            <div align="center">
                <input type="button" class="btn btn-danger" value="Get Units" onclick="GetUnits(`@Model.RegProg.CurrentProg`);" />
            </div>
        </div>
        <hr />
        <div id="divBasket">
            <h4>Basket Unit List</h4>
            <div id="divBasketList"></div>
            <hr />
            <div class="row">
                <div class="col-md-4">
                    <input type="button" class="btn btn-primary form-control" value="View Proforma Invoice" onclick="GetProformaInvoice();" />
                    <hr />
                </div>
                <div class="col-md-4">
                    <input type="button" class="btn btn-danger form-control" value="Complete Registration" onclick="RegisterSelectedUnits();" />
                    <hr />
                </div>
                <div class="col-md-4">
                    <input type="button" class="btn btn-primary form-control" value="Print Course Statement" onclick="PrintCourseStatement();" />
                    <hr />
                </div>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        if (`@Model.RegT` == "") {
            $("#divBasket").show();
            ShowBasketUnits();
        }
        else {
            $("#RegType").val(`@Model.RegT`);
            LoadBasketUnits(`@Model.RegT`);
        }
        //$("#divStage").hide();
        $("#divOption").hide();
    });
    var RegTypeChanged = function () {
        var RegT = $("#RegType").children("option:selected").val();
        if (RegT == "1" || RegT == "2" || RegT == "3") {
            $("#divStage").show();
        }
        else {
            $("#divStage").hide();
        }
    };
    var ShowBasketUnits = function () {
        var RegT = $("#RegType").children("option:selected").val();
        
        if (RegT == "") {
            $("#divBasket").hide();
        }
        else {
            if (RegT == "1" || RegT == "2" || RegT == "3") {
                $("#divStage").show();
            }
            else {
                $("#divStage").hide();
            }
            $("#divBasket").show();
            LoadBasketUnits(RegT);
        }
    }
    function LoadBasketUnits(RegT) {
        //ShowProgress();
        $.ajax({
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ RegT: RegT }),
            contentType: "application/json; charset = utf-8",
            url: '@Url.Action("GetBasketUnitRegistration", "Course")',
            success: function (data) {
                $("#divBasketList").html(data);
                //HideProgress();
            },
            error: function () {
                //HideProgress();
                Swal.fire('Warning', 'There is some problem to process your request. Please try after some time', 'warning');
            }
        });
    }
    var ShowProgOption = function () {
            $("#ddlProgOption option").remove();
            $('#ddlProgOption').empty().append('<option selected="selected" value="">--Select Programme Option--</option>');
            $("#divOption").hide();
            $.getJSON('@Url.Action("GetProgrammeOptions", "Course")', { Prog: `@Model.RegProg.CurrentProg`},
                    function (data) {
                        if (data.success == true) {
                            if (data.message.ListOfValues.length > 0) {
                                $('#ddlProgOption').empty().append('<option selected="selected" value="">--Select Programme Option--</option>');
                                $.each(data.message.ListOfValues, function () {
                                    $("#ddlProgOption").append($("<option></option>").val(this['Value']).html(this['Text']));
                                });
                                if (`@Model.RegProg.Programme_Option` != "") {
                                    $('#ddlProgOption').Value(@Model.RegProg.Programme_Option);
                                }
                                $("#divOption").show();
                            }
                            HideProgress();
                        }
                        else {
                            HideProgress();
                            Swal.fire('Warning', data.message, 'warning');
                        }
                    });
    };
</script>
