@model New_Student_Portal.ViewModel.StudentCourseRegistration
<style>
    thead {
        background-color: black;
        color: white;
    }

    .alignC {
        text-align: center;
    }

    tfoot {
        background-color: #051936;
        color: #cbcc32;
    }

    b, strong {
        font-size: 12px;
        text-decoration: underline;
    }

    .spanClass {
        font-size: 16px;
        font-weight: bold;
    }
</style>
<hr />
<div class="row" style="background-color: white;padding: 17px; border: 5px solid #7ca23b; border-radius: 10px">
    <div class="col-md-12" style="padding: 5px">
        <h4>COURSE REGISTRATION</h4>
        <h6>Registration Semester : <span style="font-size:12px" class="badge badge-soft-pink"> @Session["CurrentSem"].ToString()</span></h6>
        <hr />
        <span style="font-size: 10pt; color: orangered">
            Select Registration Type then click "<strong><em>Get Courses to Register</em></strong>".
            "<strong><em> Add Selected Courses to the Basket</em></strong>", Confirm them then Complete registration by clicking button"<strong><em> Complete Registration.</em></strong>" You can view Proforma Invoice by clicking button "<strong><em> View Proforma Invoice</em></strong>"
        </span>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <span style="font-size: 16px; font-weight: bold">Registration Type:</span>
                <select class="form-select" id="RegType" name="RegType" onchange="ShowStageReg();">
                    <option value="">----</option>
                    @if (Model.RegT == "N")
                    {
                        <option value="0">Normal Registration</option>
                    }
                    @if (Model.RegT == "S")
                    {
                        <option value="2">Supplementary</option>
                    }
                    @if (Model.RegT == "R")
                    {
                        <option value="3">Retake</option>
                    }
                    <option value="4">Special Exams</option>
                </select>
            </div>
            <div class="col-md-6" id="divStage">
                <span style="font-size: 16px; font-weight: bold">Stage:</span>
                @Html.DropDownListFor(model => model.Code, Model.ListOfStages, "--select Stage--", new { @class = "form-select", @id = "ddlStage" })
            </div>
        </div>
        <hr />
    </div>
    <div id="divRegUnits" style="background-color: #c5c3c3">
        <hr />
        <div class="row">
            <div class="col-md-4"><h5>Current Programme</h5>(@Model.RegProg.CurrentProgDesc)</div>
            @*<div class="col-md-4">
                    <span style="font-size: 16px; font-weight: bold">Unit Category:</span>
                    @Html.DropDownListFor(m => m.Code, new SelectList(Model.ListOfUnitCategory, "Value", "Text", Model.Code), "--Select Unit Type--", new { @id = "ddlUnitType", @class = "form-select" })
                </div>*@
            <div class="col-md-4">
                <br />
                <input type="button" class="btn btn-danger" value="Get Courses to Register" onclick="GetUnits('@Model.RegProg.CurrentProg');" />
            </div>
        </div>
        <hr />
    </div>
    <hr />
    <h4>Basket Unit List</h4>
    <div class="responsive-table-plugin">
        <div class="table-rep-plugin">
            <div class="table-responsive" data-pattern="priority-columns">
                <table id="tblUnitBasket" class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>
                                Programme
                            </th>
                            <th>
                                Unit
                            </th>
                            <th>
                                Unit Name
                            </th>

                            <th>
                                Stage
                            </th>
                            <th>
                                Semester
                            </th>
                            <th>
                                Action
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            if (Model.ListOfStudentBasketUnits != null)
                            {
                                if (Model.ListOfStudentBasketUnits.Count() > 0)
                                {
                                    foreach (var item in Model.ListOfStudentBasketUnits)
                                    {
                                        <tr class="rowUnits">
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Programme)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Unit)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Unit_Name)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Stage)
                                            </td>
                                            <td>
                                                @Html.DisplayFor(modelItem => item.Semester)
                                            </td>
                                            <td>
                                                <button class="btn btn-danger" onclick="DropUnit('@item.Programme','@item.Stage','@item.Semester','@item.Unit');">Drop</button>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" style="color:red">
                                            No Records Found
                                        </td>
                                    </tr>

                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <hr />
    <div class="row">
        <div class="col-md-4">
            <input type="button" class="btn btn-primary form-control" value="View Proforma Invoice" onclick="GetProformaInvoice();" />
            <hr />
        </div>
        <div class="col-md-4">
            <input type="button" class="btn btn-danger form-control" value="Complete Registration" onclick="RegisterSelectedUnits();" />
            <hr />
        </div>
        <div class="col-md-4">
            <input type="button" class="btn btn-primary form-control" value="Print Course Statement" onclick="PrintCourseStatement();" />
            <hr />
        </div>
    </div>
</div>
<hr />
<div class="responsive-table-plugin">
    <div class="table-rep-plugin">
        <div class="table-responsive" data-pattern="priority-columns">
            <h4>Registration List</h4>
            <table id="tech-companies-1" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th class="alignC" width="10%">Action</th>
                        <th>
                            Programme
                        </th>
                        <th>
                            Stage
                        </th>
                        <th>
                            Semester
                        </th>
                        <th class="alignC">
                            Unit Taken
                        </th>
                        <th>
                            Settlement Type
                        </th>
                        @*<th>
                            Registration Date
                        </th>*@
                        <th class="alignC">
                            Total Billed
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model.ListOfCourseRegistration != null)
                        {
                            if (Model.ListOfCourseRegistration.Count() > 0)
                            {
                                int i = 0;
                                foreach (var item in Model.ListOfCourseRegistration)
                                {
                                    <tr>
                                        <td align="center">
                                            <a href="#" class="btn btn-danger btn-sm" onclick="ViewUnits('@item.RegID','@item.Programme','@item.Stage','@item.Semester','@item.Register_for');">View Units</a>
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Programme)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Stage)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Semester)
                                        </td>
                                        <td align="center">
                                            @Html.DisplayFor(modelItem => item.UnitsTaken)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Settlement_Type)
                                        </td>
                                        @*<td>
                                            @Convert.ToDateTime(item.Registration_Date).ToString("yy/MM/yyyy")
                                        </td>*@
                                        <td align="center">
                                            @Convert.ToDecimal(item.TotalBilled).ToString("#,##0.00")
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" style="color:red">
                                        No Records Found
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#divStage").hide();
    });
    var ShowStageReg = function () {
        var RegT = $("#RegType").children("option:selected").val();
        if (RegT == "2" || RegT == "3") {
            $("#divStage").show();
        }
        else {
            $("#divStage").hide();
        };
        if (RegT == "4") {
            window.location = "/Course/StudentRequisitions";
        };
    };
</script>
