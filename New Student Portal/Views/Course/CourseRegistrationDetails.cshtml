@model New_Student_Portal.ViewModel.StudentCourseRegistration
<style>
    thead {
        background-color: black;
        color: white;
    }

    .alignC {
        text-align: center;
    }

    tfoot {
        background-color: #051936;
        color: #cbcc32;
    }

    b, strong {
        font-size: 12px;
        text-decoration: underline;
    }

    .spanClass {
        font-size: 16px;
        font-weight: bold;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div class="responsive-table-plugin">
    <div class="table-rep-plugin">
        <div class="table-responsive" data-pattern="priority-columns">
            <h4>Registration List</h4>
            <table id="tech-companies-1" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th class="alignC" width="10%">Action</th>
                        @*<th>
                                Stage
                            </th>*@
                        <th>
                            Semester
                        </th>
                        <th class="alignC">
                            Unit Taken
                        </th>
                        <th>
                            Settlement Type
                        </th>
                        <th>
                            Registration Date
                        </th>
                        <th>
                            Register For
                        </th>
                        <th class="alignC">
                            Unposted Charges
                        </th>
                        <th class="alignC">
                            Total Billed
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model.ListOfCourseRegistration != null)
                        {
                            if (Model.ListOfCourseRegistration.Count() > 0)
                            {
                                int i = 0;
                                foreach (var item in Model.ListOfCourseRegistration)
                                {
                                    <tr>
                                        <td align="center">
                                            <a href="#" class="btn btn-danger btn-sm" onclick="ViewUnits('@item.RegID','@item.Programme','@item.Stage','@item.Semester','@item.Register_for');">View Units</a>
                                        </td>
                                        @*<td>
                                                @Html.DisplayFor(modelItem => item.Stage)
                                            </td>*@
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Semester)
                                        </td>
                                        <td align="center">
                                            @Html.DisplayFor(modelItem => item.UnitsTaken)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Settlement_Type)
                                        </td>
                                        <td>
                                            @Convert.ToDateTime(item.Registration_Date).ToString("yy/MM/yyyy")
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Register_for)
                                        </td>
                                        <td align="center">
                                            @Convert.ToDecimal(item.UnpostedCharges).ToString("#,##0.00")
                                        </td>
                                        <td align="center">
                                            @Convert.ToDecimal(item.TotalBilled).ToString("#,##0.00")
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="9" style="color:red">
                                        No Records Found
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<hr />

