@model IEnumerable<New_Student_Portal.ViewModel.StudentReqLines>
<style>
    thead {
        background-color: black;
        color: white;
    }

    tfoot {
        background-color: #051936;
        color: #cbcc32;
    }
    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div class="pre-scrollable">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>
                    Unit Code
                </th>
                <th>
                    Unit Description
                </th>
                <th align="center">Action</th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null)
                {
                    if (Model.Count() > 0)
                    {
                        foreach (var item in Model)
                        {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Unit)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.UnitName)
                            </td>
                            <td>
                                <button id="btnEval" class="btn btn-warning BtnPadding" onclick="SelectedRowUnit('@item.Unit');">Drop</button>
                            </td>
                        </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="color:red">
                                No Registered Units for evaluation Found
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
