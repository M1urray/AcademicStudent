@model New_Student_Portal.ViewModel.RequisitionLines
<style>
    thead {
        background-color: black;
        color: white;
    }

    tfoot {
        background-color: #051936;
        color: #cbcc32;
    }

    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div class="pre-scrollable">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>
                    Unit Code
                </th>
                <th>
                    Unit Description
                </th>
                @if (Model.Status == "Approved" && (Model.RegT == "Special Exams" || Model.RegT == "Exam Challenge"))
                {
                    <th>
                        Lecture
                    </th>
                    <th>
                        Section
                    </th>
                }
                @if (Model.Status == "Open")
                {
                    <th align="center">Action</th>
                }
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null)
                {
                    if (Model.ListLines.Count() > 0)
                    {
                        foreach (var item in Model.ListLines)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Unit)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.UnitName)
                                </td>
                                @if (Model.Status == "Approved" && (Model.RegT == "Special Exams" || Model.RegT == "Exam Challenge"))
                                {
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Lecturer)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Section)
                                    </td>
                                }
                                @if (Model.Status == "Open")
                                {
                                    <td>
                                        <button id="btnEval" class="btn btn-warning BtnPadding" onclick="SelectedRowUnit('@item.Unit');">Drop</button>
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="color:red">
                                No Registered Units for evaluation Found
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
