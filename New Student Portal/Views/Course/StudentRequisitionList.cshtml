@model IEnumerable<New_Student_Portal.ViewModel.StudentReqs>
<style>
    thead {
        background-color: black;
        color: white;
    }

    tfoot {
        background-color: #051936;
        color: #cbcc32;
    }

    b, strong {
        font-size: 12px;
        text-decoration: underline;
    }

    .spanClass {
        font-size: 16px;
        font-weight: bold;
    }
</style>
<div class="pre-scrollable">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th></th>
                <th>
                    Code
                </th>
                <th>
                    Date
                </th>
                <th>
                    Requistion Type
                </th>

                <th>
                    Semester
                </th>
                <th>
                    Status
                </th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null)
                {
                    if (Model.Count() > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <a href="#" onclick="SelectedRow('@item.Code');">Select</a>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Code)
                                </td>
                                <td>
                                    @Convert.ToDateTime(item.Date).ToString("yy/MM/yyyy")
                                </td>
                                <td>
                                    @if (item.Requisition_Type == "Drop Courses" || item.Requisition_Type == "Special Exams")
                                    {
                                        @Html.DisplayFor(modelItem => item.Requisition_Type) <button class="btn btn-primary btnClass" onclick="ViewLines('@item.Code');">(@item.LinesCounter Units)</button>
                                    }
                                    else
                                    {
                                        @Html.DisplayFor(modelItem => item.Requisition_Type)
                                    }
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Semester)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Status)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="color:red">
                                No Records Found
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>






