@model IEnumerable<New_Student_Portal.ViewModel.StudentReqs>
<style>
    thead {
        background-color: black;
        color: white;
    }

    tfoot {
        background-color: #051936;
        color: #cbcc32;
    }

    b, strong {
        font-size: 12px;
        text-decoration: underline;
    }

    .spanClass {
        font-size: 16px;
        font-weight: bold;
    }
</style>
<div class="pre-scrollable">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>
                    Code
                </th>
                <th>
                    Date
                </th>
                <th>
                    Requistion Type
                </th>

                <th>
                    Semester
                </th>
                <th>
                    Status
                </th>
                <th>
                    Action
                </th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null)
                {
                    if (Model.Count() > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Code)
                                </td>
                                <td>
                                    @Convert.ToDateTime(item.Date).ToString("yy/MM/yyyy")
                                </td>
                                <td>
                                    @if (item.Requisition_Type == "Exemption" || item.Requisition_Type == "Drop Courses" || item.Requisition_Type == "Special Exams" || item.Requisition_Type == "Exam Challenge" || item.Requisition_Type == "Withdrawal")
                                    {
                                        @Html.DisplayFor(modelItem => item.Requisition_Type) <button class="btn btn-primary btnClass" onclick="ViewLines('@item.Code', '@item.Status', '@item.Requisition_Type');">(@item.LinesCounter Units)</button>
                                    }
                                    else
                                    {
                                        @Html.DisplayFor(modelItem => item.Requisition_Type)
                                    }
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Semester)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Status)
                                </td>

                                <td>
                                    @if (item.ApprovalCount > 0 && item.Status == "Pending Approval")
                                    {
                                        <button class="btn btn-sm btn-success" onclick="ViewApprovalTrail('@item.Code');">Approval Trail</button>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <button class="btn btn-sm btn-danger" onclick="ViewComments('@item.Code');">View Comment</button>
                                    }
                                    else if (item.Status == "Approved" && (item.Requisition_Type == "Special Exams" || item.Requisition_Type == "Exam Challenge"))
                                    {
                                        <button class="btn btn-sm btn-danger" onclick="ViewLines('@item.Code', '@item.Status', '@item.Requisition_Type');">Assigned Lecturer</button>
                                    }
                                    else if (item.Status == "Approved" && item.Requisition_Type == "Transit To Next Programme Level")
                                    {
                                        <button class="btn btn-sm btn-danger" onclick="GetAdmissionLetters('@item.Code');">Print Admission Letter</button>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-warning">No Action</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="color:red">
                                No Records Found
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>







