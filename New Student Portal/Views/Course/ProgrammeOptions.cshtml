@model New_Student_Portal.ViewModel.ProgrammeOptionsList
<div class="container">
    <div class="row">
        <div class="col-md-6">
            <b>Choose Programme Option :</b>
            @Html.DropDownListFor(model => model.Option, Model.ListOfProgOption, "--select Option--", new { @class = "form-control", id = "ddlOption" })
        </div>
        <div class="col-md-6"></div>
    </div>
    <hr />
    <input type="button" class="btn btn-danger" value="Get Programme Courses" onclick="GetProgOptionUnits()" />
</div>

