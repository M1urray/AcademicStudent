@model New_Student_Portal.ViewModel.GetRegisteredUnit
<style>
    .checkboxClass {
        width: 20px;
        height: 20px;
        padding: 0px;
    }

    thead {
        background-color: black;
        color: white;
    }
</style>
<div class="pre-scrollable">
    <table class="table table-border-style" id="tbRegUnits">
        <thead>
            <tr>
                <th>Action</th>
                <th>
                    Unit
                </th>
                <th>
                    Description
                </th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.ListOfRegUnit != null)
                {
                    if (Model.ListOfRegUnit.Count() > 0)
                    {
                        foreach (var item in Model.ListOfRegUnit)
                        {
                            <tr>
                                <td align="center">
                                    <input type="checkbox" class="checkboxClass" />
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Unit)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Unit_Name)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" style="color:red">No Units Found</td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>


