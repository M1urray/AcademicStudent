<div class="container">
    <div class="col-md-12" style="background-color: white">
        <div class="row">
            <div class="col-md-12">
                <span style="font-weight: bold">Choose the Type of Requisition</span>
                <select class="form-select" id="ReqType" name="RegType" onchange="ShowRequiredDiv()">
                    <option value="">--Select Requisition Type--</option>
                    @*<option value="1">Campus Transfer</option>*@
                    @*<option value="2">Change of Major</option>*@
                    <option value="3">Deferment Request</option>
                    <option value="4">Re-Admission After Deferment</option>
                    @*<option value="5">Re-Admission After Suspension</option>*@
                    @*<option value="8">Special Exams</option>
                    <option value="9">Official Transcript</option>*@
                    @*<option value="11">Drop Courses</option>*@
                    @*<option value="12">Programme Minor</option>
                    <option value="13">Double Major</option>
                    <option value="14">Double Concentration</option>*@
                    @*<option value="16"> Missing Grade</option>*@
                    @*<option value="17">Exemption</option>*@
                    @*<option value="18">Exam Challenge</option>
                    <option value="19">Transit To Next Programme Level</option>
                    <option value="20">Withdrawal</option>*@
                </select>
            </div>
        </div>
    </div>
    <div><hr /></div>
    <div id="RegForm">
        <div style="background-color: white;" id="CampusChange">
            <div class="row">
                <div class="col-md-6">
                    <span style="font-weight: bold">Campus To</span>
                    <select class="form-select" id="ddlCampus" name="ddlCampus">
                    </select>
                </div>
            </div>
        </div>
        <div style="background-color: white;" id="DivReqData">
            <div class="row">
                <div class="col-md-12">
                    <span style="font-weight: bold"><label id="lblTle"></label></span>
                    <p style="color:red"><i><label id="lblTText"></label></i></p>
                    <div id="divRegUnits"></div>
                </div>
            </div>
        </div>
        <br />
        <div class="row">
            <div class="col-md-12">
                <span class="font-weight-bold"><label id="lblTitle"></label></span>
                <textarea class="form-control" id="txtRemarks"></textarea>
            </div>
        </div>
        <hr />
        <div align="center">
            <input type="button" class="btn btn-danger" value="Submit Requisition" onclick="SubmitStudentRequistion();" />
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#RegForm").hide();
        $("#ReqType,#ddlCampus").select2({
            dropdownParent: $('#myModalUnits'),
            width: '100%'
        });
    });
    var ShowRequiredDiv = function () {
        var regType = $("#ReqType").children("option:selected").val();
        if (regType == "") {
            $("#RegForm").hide();
        }
        else {
            $("#RegForm").show();
            HideSections();
            if (regType == "1") {
                $("#CampusChange").show();
                $("#lblTitle").text("Give Reason for the change");
                LoadCampus();
            }
            else if (regType == "3") {
                $("#lblTitle").text("Give Reason for the defferement");
            }
            else if (regType == "4") {
                $("#lblTitle").text("Give Reason for the Re-Admission after deferment");
            }
            else if (regType == "5") {
                $("#lblTitle").text("Give Reason for the Re-Admission after Suspension");
            }
            else if (regType == "6") {
                $("#lblTitle").text("Give Reason for the Re-Admission after Suspension");
            }
            else if (regType == "10") {
                $("#lblTitle").text("Give Reason for the Clearance Requisition");
            }
            else if (regType == "8" || regType == "11" || regType == "20") {
                $("#lblTle").text("Registered Courses");
                $("#DivReqData").show();
                if (regType == "8") {
                    $("#lblTText").text("Select the courses you want special exams");
                    $("#lblTitle").text("Give Reason for the Special exams");
                }
                if (regType == "11") {
                    $("#lblTText").text("Select the courses you want to drop");
                    $("#lblTitle").text("Give Reason for the drop of Course(s)");
                }
                if (regType == "20") {
                    $("#lblTText").text("Select the courses you want to Withdraw");
                    $("#lblTitle").text("Give Reason for the Withdrawal");
                }
                ShowProgress();
                $.ajax({
                    async: true,
                    type: "POST",
                    dataType: 'HTML',
                    data: JSON.stringify({ RegType: regType }),
                    contentType: "application/json; charset = utf-8",
                    url: '@Url.Action("GetCurrentRegisteredUnits", "Course")',
                    success: function (data) {
                        $("#divRegUnits").html(data);
                        HideProgress();
                    },
                    error: function () {
                        HideProgress();
                        alert("There is some problem to process your request. Please try after some time");
                    }
                });
            }
            else if (regType == "9") {
                $("#lblTle").text("Official Transcipt");
                $("#DivReqData").show();
                $("#lblTitle").text("Give Reason for the Official Transcript");

                ShowProgress();
                $.ajax({
                    async: true,
                    type: "POST",
                    dataType: 'HTML',
                    data: JSON.stringify({ RegType: regType }),
                    contentType: "application/json; charset = utf-8",
                    url: '@Url.Action("OfficialTranscript", "Course")',
                    success: function (data) {
                        $("#divRegUnits").html(data);
                        HideProgress();
                    },
                    error: function () {
                        HideProgress();
                        alert("There is some problem to process your request. Please try after some time");
                    }
                });
            }
            else if (regType == "2" || regType == "12" || regType == "13" || regType == "14") {
                $("#lblTText").text("Select the Programme");
                $("#lblTitle").text("Give Reason for the request");
                $("#DivReqData").show();
                ShowProgress();
                $.ajax({
                    async: true,
                    type: "POST",
                    dataType: 'HTML',
                    contentType: "application/json; charset=utf-8",
                    data: JSON.stringify({ type: regType }),
                    processData: false,
                    url: '@Url.Action("ProgrammeListViewMinorMajor", "Course")',
                    success: function (data) {
                        $("#divRegUnits").html(data);
                        HideProgress();
                    },
                    error: function () {
                        HideProgress();
                        alert("There is some problem to process your request. Please try after some time");
                    }
                });
            }
            else if (regType == "16") {
                $("#lblTle").text("Registered Courses");
                $("#lblTText").text("Select the courses with Missing Grade(s)");
                $("#lblTitle").text("Give Reason for the Missing Grade(s)");
                ShowProgress();
                $.ajax({
                    async: true,
                    type: "GET",
                    dataType: 'HTML',
                    contentType: false,
                    processData: false,
                    url: '@Url.Action("GetUnitsWithMissingGrades", "Course")',
                    success: function (data) {
                        $("#divRegUnits").html(data);
                        HideProgress();
                    },
                    error: function () {
                        HideProgress();
                        alert("There is some problem to process your request. Please try after some time");
                    }
                });
            }
            else if (regType == "17") {
                $("#lblTText").text("Select the courses you want Exemptions");
                $("#lblTitle").text("Give Reason for the Exemptions");
                $("#DivReqData").show();
                ShowProgress();
                $.ajax({
                    async: true,
                    type: "GET",
                    dataType: 'HTML',
                    contentType: false,
                    processData: false,
                    url: '@Url.Action("GetUnitsForExemptions", "Course")',
                    success: function (data) {
                        $("#divRegUnits").html(data);
                        HideProgress();
                    },
                    error: function () {
                        HideProgress();
                        alert("There is some problem to process your request. Please try after some time");
                    }
                });
            }
            else if (regType == "18") {
                $("#lblTText").text("Select the courses you want Exam Challenge");
                $("#lblTitle").text("Give Reason for the Exam Challenge");
                $("#DivReqData").show();
                ShowProgress();
                $.ajax({
                    async: true,
                    type: "GET",
                    dataType: 'HTML',
                    contentType: false,
                    processData: false,
                    url: '@Url.Action("GetExamChallengeUnits", "Course")',
                    success: function (data) {
                        $("#divRegUnits").html(data);
                        HideProgress();
                    },
                    error: function () {
                        HideProgress();
                        alert("There is some problem to process your request. Please try after some time");
                    }
                });
            }
            else if (regType == "19") {
                $("#lblTitle").text("Give Reason for the Transit");
                $("#DivReqData").show();
                ShowProgress();
                $.ajax({
                    async: true,
                    type: "GET",
                    dataType: 'HTML',
                    contentType: false,
                    processData: false,
                    url: '@Url.Action("GetProgrammeTransit", "Course")',
                    success: function (data) {
                        $("#divRegUnits").html(data);
                        HideProgress();
                    },
                    error: function () {
                        HideProgress();
                        alert("There is some problem to process your request. Please try after some time");
                    }
                });
            }
            else {
                HideSections();
            };
        }
    }
    var HideSections = function () {
        $("#CampusChange").hide();
        $("#DivReqData").hide();
    };
    var LoadCampus = function () {
        ShowProgress();
        $.getJSON('@Url.Action("GetCampusList", "Course")', null,
            function (data) {
                $("#ddlCampus").empty().append('<option selected="selected" value="">--Select Campus--</option>');
                $.each(data.ListOfCampus, function () {
                    $("#ddlCampus").append($("<option></option>").val(this['Value']).html(this['Text']));
                });
                HideProgress();
            });
    }
</script>
