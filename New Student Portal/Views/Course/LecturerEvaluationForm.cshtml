
@model New_Student_Portal.ViewModel.Evaluation_Form
@{
    string Cat = "";
}
<style>
    .RadioClass {
        width: 20px;
        height: 20px;
        padding: 0px;
    }

    label {
        vertical-align: -webkit-baseline-middle;
    }
</style>
<div class="modal-content">
    <div class="modal-body" style="font-size: 12px">
        <p style="font-size: 14px; font-weight: bold; text-decoration: underline;">
            Introduction
        </p>
        <p>
            <u><b>PURPOSE AND CONFIDENTIALITY</b></u><br />
            The purpose of this evaluation is to provide feedback about the course presentation to help in future
            improvement. Please rate the statements given by choosing the most appropriate score as per the
            following scale:
        </p>
        <p style="font-weight:bold">
            1=Strongly Disagree; 2=Disagree; 3=Neutral; 4=Agree; 5=Strongly Agree
        </p>
        <hr />
        <div class="panel panel-default">
            <div class="panel-body pre-scrollable">
                <table style="width: 100%;">
                    <thead>
                        <tr>
                            <th colspan="4">Lecturer Information</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="font-weight:bold; width:20%">Lecturer Name:</td>
                            <td style="width:80%">
                                <asp:Label ID="lblLecturerName" runat="server" class="label label-info">@Model.LecDet.LecName</asp:Label>
                            </td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold">Unit Code :</td>
                            <td>
                                <asp:Label ID="lblUnitCode" class="label label-info">@Model.LecDet.Unit</asp:Label>
                            </td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold">Unit Name :</td>
                            <td>
                                <asp:Label ID="lblUnitName" runat="server" class="label label-info">@Model.LecDet.UnitName</asp:Label>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <hr style="border-bottom:3px solid Black" />
        <div id="Step1">
            <div class="panel panel-default">
                @foreach (var c in Model.Eval_Form_Quiz.Where(x => x.order == 1))
                {
                    Cat = "";
                    <div class="panel-heading" style="font-weight: bold">
                        @c.Category
                    </div>
                    <div class="responsive-table-plugin">
                        <div class="table-rep-plugin">
                            <div class="table-responsive" data-pattern="priority-columns">
                                <table class="table table-border-style" id="TB1">
                                    <thead>
                                        <tr>
                                            <th width="50%">Question</th>
                                            <th width="10%" style="text-align:center">Strongly Disagree</th>
                                            <th width="10%" style="text-align:center">Disagree</th>
                                            <th width="10%" style="text-align:center">Neutral</th>
                                            <th width="10%" style="text-align:center">Agree</th>
                                            <th width="10%" style="text-align:center">Strongly Agree</th>
                                        </tr>
                                    </thead>
                                    @{ int i = 1;}
                                    <tbody>
                                        @foreach (var d in c.Eval_Quiz)
                                        {
                                            string name = "Ans" + i.ToString();

                                            <tr>
                                                <td>
                                                    @i. @d.Quiz
                                                    <input type="hidden" value="@d.Quiz" id="@i" />
                                                </td>
                                                @for (int j = 1; j < 6; j++)
                                                {
                                                    string ID = "Ans1" + j.ToString();
                                                    <td align="center">
                                                        <input id="@ID" name="@name" type="radio" value="@j" class="RadioClass" />
                                                    </td>

                                                }
                                            </tr>
                                            i++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    Cat = c.Category;
                }
            </div>
            <hr />
            <div class="row">
                <div class="d-inline col-8 col-sm-8 col-md-8" style="text-align:center">Steps 1 of 3</div>
                <div class="d-inline col-4 col-sm-4 col-md-4" style="text-align:right">
                    <button class="btn btn-sm btn-success" onclick="NextStep('2',true,false,'@Cat');">Next >>></button>
                </div>
            </div>
        </div>
        <div class="d-none" id="Step2">
            <div class="panel panel-default">
                @foreach (var c in Model.Eval_Form_Quiz.Where(x => x.order == 2))
                {
                    Cat = "";
                    <div class="panel-heading" style="font-weight: bold">
                        @c.Category
                    </div>
                    <div class="responsive-table-plugin">
                        <div class="table-rep-plugin">
                            <div class="table-responsive" data-pattern="priority-columns">
                                <table class="table table-border-style" id="TB2">
                                    <thead>
                                        <tr>
                                            <th width="50%">Question</th>
                                            <th width="10%" style="text-align:center">Strongly Disagree</th>
                                            <th width="10%" style="text-align:center">Disagree</th>
                                            <th width="10%" style="text-align:center">Neutral</th>
                                            <th width="10%" style="text-align:center">Agree</th>
                                            <th width="10%" style="text-align:center">Strongly Agree</th>
                                        </tr>
                                    </thead>
                                    @{ int i = 1;}
                                    <tbody>
                                        @foreach (var d in c.Eval_Quiz)
                                        {
                                            string name = "Ans2" + i.ToString();

                                            <tr>
                                                <td>
                                                    @i. @d.Quiz
                                                    <input type="hidden" value="@d.Quiz" id="@i" />
                                                </td>
                                                @for (int j = 1; j < 6; j++)
                                                {
                                                    string ID = "Ans2" + j.ToString();
                                                    <td align="center">
                                                        <input id="@ID" name="@name" type="radio" value="@j" class="RadioClass" />
                                                    </td>

                                                }
                                            </tr>
                                            i++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    Cat = c.Category;
                }
            </div>
            <hr />
            <div class="row">
                <div class="d-inline col-4 col-sm-4 col-md-4">
                    <button class="btn btn-sm btn-primary" onclick="PreviousStep('1');"><<< Back</button>
                </div>
                <div class="d-inline col-4 col-sm-4 col-md-4" style="text-align:center">Steps 2 of 3</div>
                <div class="d-inline col-4 col-sm-4 col-md-4" style="text-align:right">
                    <button class="btn btn-sm btn-success" onclick="NextStep('3',false,false,'@Cat');">Next >>></button>
                </div>
            </div>
        </div>                
        <div class="d-none" id="Step3">
            <div class="panel panel-default">
                <div class="panel-heading" style="font-weight: bold">
                    1. What did you like the most about the unit? What shouldn't we change?
                </div>
                <div class="panel-body">
                    <textarea id="txtContrb" class="form-control"></textarea>
                </div>
                <div class="panel-heading" style="font-weight: bold">
                    2. What did you like the least about the unit? What should we definitely change?
                </div>
                <div class="panel-body">
                    <textarea id="txtImprivents" class="form-control"></textarea>
                </div>
                <div class="panel-heading" style="font-weight: bold">
                    3. Any other information you wish the lecturer to Know?
                </div>
                <div class="panel-body">
                    <textarea id="txtOtherComment" class="form-control"></textarea>
                </div>
            </div>
            <hr />
            <div class="row">
                <div class="d-inline col-4 col-sm-4 col-md-4">
                    <button class="btn btn-sm btn-primary" onclick="PreviousStep('2');"><<< Back</button>
                </div>
                <div class="d-inline col-4 col-sm-4 col-md-4" style="text-align:center">Steps 3 of 3</div>
                <div class="d-inline col-4 col-sm-4 col-md-4" style="text-align:right">
                </div>
            </div>
            <br />
            <div align="center">
                <button class="btn btn-sm btn-danger" onclick="CompleteEvaluation(`@Model.LecDet.Unit`,`@Model.LecDet.UnitName`,`@Model.LecDet.LecNo`);">Complete Evaluation</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var NextStep = function (step, FirstStep, LastStep,Cat) {
        var Lecturer = {};

        Lecturer.LecName = `@Model.LecDet.LecName`;;
        Lecturer.LecNo = `@Model.LecDet.LecNo`;
        Lecturer.Unit = `@Model.LecDet.Unit`;;
        Lecturer.UnitName = `@Model.LecDet.UnitName`;;
        Lecturer.Comments = "";
      //var Mode = "";
        var LecEval = new Array();
      //var ELearning = new Array();
        if (step == "2") {
            var SaveData = false;
            var ErroMsg = "";
            $("#TB1 tbody tr").each(function (index) {
                SaveData = false;
                ErroMsg = "";
                if ($("input[name=Ans" + (index + 1) +"]").is(':checked')) {
                    $(this).removeClass("rowFocus");
                    SaveData = true;
                }
                else {
                    $(this).addClass("rowFocus");
                    SaveData = false;
                    ErroMsg = "Answer question " + (index + 1) + "";
                    return false;
                }
            });
            if (SaveData == false) {
                Swal.fire('Warning', ErroMsg, 'warning');
                return;
            }
            else {
                $("#TB1 tbody tr").each(function (index) {
                    var EvalQuiz = {};
                    EvalQuiz.QuizCategory = Cat;
                    EvalQuiz.Quiz = $(this).find("input[type='hidden']").val();
                    EvalQuiz.Score = $("input[name=Ans" + (index + 1) + "]:checked").val();
                    LecEval.push(EvalQuiz);
                });
            }
        }
        if (step == "3") {
            var SaveData = false;
            var ErroMsg = "";
            $("#TB2 tbody tr").each(function (index) {
                SaveData = false;
                ErroMsg = "";
                if ($("input[name=Ans2" + (index + 1) + "]").is(':checked')) {
                    $(this).removeClass("rowFocus");
                    SaveData = true;
                }
                else {
                    $(this).addClass("rowFocus");
                    SaveData = false;
                    ErroMsg = "Answer question " + (index + 1) + "";
                    return false;
                }
            });
            if (SaveData == false) {
                Swal.fire('Warning', ErroMsg, 'warning');
                return;
            }
            else {
                $("#TB2 tbody tr").each(function (index) {
                    var EvalQuiz = {};
                    EvalQuiz.QuizCategory = Cat;
                    EvalQuiz.Quiz = $(this).find("input[type='hidden']").val();
                    EvalQuiz.Score = $("input[name=Ans2" + (index + 1) + "]:checked").val();
                    LecEval.push(EvalQuiz);
                });
            }
        }
        if (step == "4") {
            var SaveData = false;
            var ErroMsg = "";

            $("#TB3 tbody tr").each(function (index) {
                SaveData = false;
                ErroMsg = "";
                if ($("input[name=Ans3" + (index + 1) + "]").is(':checked')) {
                    $(this).removeClass("rowFocus");
                    SaveData = true;
                }
                else {
                    $(this).addClass("rowFocus");
                    SaveData = false;
                    ErroMsg = "Answer question " + (index + 1) + "";
                    return false;
                }
            });
            if (SaveData == false) {
                Swal.fire('Warning', ErroMsg, 'warning');
                return;
            }
            else {
                $("#TB3 tbody tr").each(function (index) {
                    var EvalQuiz = {};
                    EvalQuiz.QuizCategory = Cat;
                    EvalQuiz.Quiz = $(this).find("input[type='hidden']").val();
                    EvalQuiz.Score = $("input[name=Ans3" + (index + 1) + "]:checked").val();
                    LecEval.push(EvalQuiz);
                });
            }
        }
        ShowProgress();
        $.ajax({
            type: "POST",
            url: "/LecturerEvaluation/SaveSectionData",
            data: JSON.stringify({ Lec: Lecturer, lecQuiz: LecEval, SectionOne: FirstStep, LastSection: LastStep }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    if (step == "2") {
                        $("#Step1").addClass("d-none");
                        $("#Step2").removeClass("d-none");
                    }
                    if (step == "3") {
                        $("#Step2").addClass("d-none");
                        $("#Step3").removeClass("d-none");
                    }
                    if (step == "4") {
                        $("#Step3").addClass("d-none");
                        $("#Step4").removeClass("d-none");
                    }
                    if (step == "5") {
                        $("#Step4").addClass("d-none");
                        $("#Step5").removeClass("d-none");
                    }
                    if (step == "6") {
                        $("#Step5").addClass("d-none");
                        $("#Step6").removeClass("d-none");
                    }
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    HideProgress();
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function () {
                HideProgress();
                Swal.fire('Error', data.message, 'error');
            }
        });
    };
    var PreviousStep = function (step) {
        if (step == "1") {
            $("#Step2").addClass("d-none");
            $("#Step1").removeClass("d-none");
        }
        if (step == "2") {
            $("#Step3").addClass("d-none");
            $("#Step2").removeClass("d-none");
        }
        if (step == "3") {
            $("#Step4").addClass("d-none");
            $("#Step3").removeClass("d-none");
        }
        if (step == "4") {
            $("#Step5").addClass("d-none");
            $("#Step4").removeClass("d-none");
        }
    };
</script>
