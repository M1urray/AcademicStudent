<script type="text/javascript">
    var NextStep = function (step, FirstStep, LastStep,Cat) {
        var Lecturer = {};

        Lecturer.LecName = `@Model.LecDet.LecName`;;
        Lecturer.LecNo = `@Model.LecDet.LecNo`;
        Lecturer.Unit = `@Model.LecDet.Unit`;;
        Lecturer.UnitName = `@Model.LecDet.UnitName`;;
        Lecturer.Comments = "";
      //var Mode = "";
        var LecEval = new Array();
      //var ELearning = new Array();
        if (step == "2") {
            var SaveData = false;
            var ErroMsg = "";
            $("#TB1 tbody tr").each(function (index) {
                SaveData = false;
                ErroMsg = "";
                if ($("input[name=Ans" + (index + 1) +"]").is(':checked')) {
                    $(this).removeClass("rowFocus");
                    SaveData = true;
                }
                else {
                    $(this).addClass("rowFocus");
                    SaveData = false;
                    ErroMsg = "Answer question " + (index + 1) + "";
                    return false;
                }
            });
            if (SaveData == false) {
                Swal.fire('Warning', ErroMsg, 'warning');
                return;
            }
            else {
                $("#TB1 tbody tr").each(function (index) {
                    var EvalQuiz = {};
                    EvalQuiz.QuizCategory = Cat;
                    EvalQuiz.Quiz = $(this).find("input[type='hidden']").val();
                    EvalQuiz.Score = $("input[name=Ans" + (index + 1) + "]:checked").val();
                    LecEval.push(EvalQuiz);
                });
            }
        }
        if (step == "3") {
            var SaveData = false;
            var ErroMsg = "";
            $("#TB2 tbody tr").each(function (index) {
                SaveData = false;
                ErroMsg = "";
                if ($("input[name=Ans2" + (index + 1) + "]").is(':checked')) {
                    $(this).removeClass("rowFocus");
                    SaveData = true;
                }
                else {
                    $(this).addClass("rowFocus");
                    SaveData = false;
                    ErroMsg = "Answer question " + (index + 1) + "";
                    return false;
                }
            });
            if (SaveData == false) {
                Swal.fire('Warning', ErroMsg, 'warning');
                return;
            }
            else {
                $("#TB2 tbody tr").each(function (index) {
                    var EvalQuiz = {};
                    EvalQuiz.QuizCategory = Cat;
                    EvalQuiz.Quiz = $(this).find("input[type='hidden']").val();
                    EvalQuiz.Score = $("input[name=Ans2" + (index + 1) + "]:checked").val();
                    LecEval.push(EvalQuiz);
                });
            }
        }
        if (step == "4") {
            var SaveData = false;
            var ErroMsg = "";

            $("#TB3 tbody tr").each(function (index) {
                SaveData = false;
                ErroMsg = "";
                if ($("input[name=Ans3" + (index + 1) + "]").is(':checked')) {
                    $(this).removeClass("rowFocus");
                    SaveData = true;
                }
                else {
                    $(this).addClass("rowFocus");
                    SaveData = false;
                    ErroMsg = "Answer question " + (index + 1) + "";
                    return false;
                }
            });
            if (SaveData == false) {
                Swal.fire('Warning', ErroMsg, 'warning');
                return;
            }
            else {
                $("#TB3 tbody tr").each(function (index) {
                    var EvalQuiz = {};
                    EvalQuiz.QuizCategory = Cat;
                    EvalQuiz.Quiz = $(this).find("input[type='hidden']").val();
                    EvalQuiz.Score = $("input[name=Ans3" + (index + 1) + "]:checked").val();
                    LecEval.push(EvalQuiz);
                });
            }
        }
        ShowProgress();
        $.ajax({
            type: "POST",
            url: "/LecturerEvaluation/SaveSectionData",
            data: JSON.stringify({ Lec: Lecturer, lecQuiz: LecEval, SectionOne: FirstStep, LastSection: LastStep }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    if (step == "2") {
                        $("#Step1").addClass("d-none");
                        $("#Step2").removeClass("d-none");
                    }
                    if (step == "3") {
                        $("#Step2").addClass("d-none");
                        $("#Step3").removeClass("d-none");
                    }
                    if (step == "4") {
                        $("#Step3").addClass("d-none");
                        $("#Step4").removeClass("d-none");
                    }
                    if (step == "5") {
                        $("#Step4").addClass("d-none");
                        $("#Step5").removeClass("d-none");
                    }
                    if (step == "6") {
                        $("#Step5").addClass("d-none");
                        $("#Step6").removeClass("d-none");
                    }
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    HideProgress();
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function () {
                HideProgress();
                Swal.fire('Error', data.message, 'error');
            }
        });
    };
    var NextStep5 = function (OnlineCat, FaceCat) {
        var Mode = "";
        if (!$("input[name=AnsStM").is(':checked')) {
            Swal.fire('Warning', "Select Study Mode", 'warning');
            return false;
        }
        else {
            Mode = $("input[name=AnsStM]:checked").val();

            var Lecturer = {};

            Lecturer.LecName = `@Model.LecDet.LecName`;;
            Lecturer.LecNo = `@Model.LecDet.LecNo`;
            Lecturer.Unit = `@Model.LecDet.Unit`;;
            Lecturer.UnitName = `@Model.LecDet.UnitName`;;
            Lecturer.Comments = "";

            var LecEval = new Array();
            var ELearning = new Array();

            var SaveData = false;
            var ErroMsg = "";
            if (Mode == "1") {
                var QuizText = "";

                if (!$("input[name=AnsMat").is(':checked')) {
                    Swal.fire('Warning', "Answer question 1", 'warning');
                    return false;
                }
                else if (!$("input[name=AnsEL]").is(':checked')) {
                    Swal.fire('Warning', "Answer question 2", 'warning');
                    return false;
                }
                else if (!$("input[type=checkbox][name=ModesS]").is(':checked')) {
                    Swal.fire('Warning', "You have not selected any Modes of learning used", 'warning');
                    return false;
                }
                else if (!$("input[type=checkbox][name=Challenge]").is(':checked')) {
                    Swal.fire('Warning', "You have not selected any challenges faced", 'warning');
                    return false;
                }
                else {
                    var EvalQuiz = {};
                    EvalQuiz.QuizCategory = OnlineCat;
                    EvalQuiz.Quiz = $("#hidden1").val();
                    EvalQuiz.Score = $("input[name=AnsMat]:checked").val();
                    LecEval.push(EvalQuiz);

                    var EvalQuiz = {};
                    EvalQuiz.QuizCategory = OnlineCat;
                    EvalQuiz.Quiz = $("#hidden2").val();
                    EvalQuiz.Score = $("input[name=AnsEL]:checked").val();
                    LecEval.push(EvalQuiz);

                    QuizText = $("#hidden3").val();

                    $('input[type=checkbox][name=ModesS]').each(function (index) {
                        var OnlineQ = {};
                        if ($("#chckBox" + (index + 1) + "").is(':checked')) {
                            OnlineQ.Quiz = QuizText;
                            OnlineQ.Asnwer = $("#chckBox" + (index + 1) + "").val();
                            OnlineQ.Cat = "1";
                            ELearning.push(OnlineQ);
                        }
                    });
                    if ($("#txtOther1").val() != "") {
                        var OnlineQ = {};
                        OnlineQ.Quiz = QuizText;
                        OnlineQ.Asnwer = $("#txtOther1").val();
                        OnlineQ.Cat = "1";
                        ELearning.push(OnlineQ);
                    }
                    QuizText = "";

                    QuizText = $("#hidden4").val();
                    $('input[type=checkbox][name=Challenge]').each(function (index) {
                        var OnlineQ = {};
                        if ($("#chckBoxChallg" + (index + 1) + "").is(':checked')) {
                            OnlineQ.Quiz = QuizText;
                            OnlineQ.Asnwer = $("#chckBoxChallg" + (index + 1) + "").val();
                            OnlineQ.Cat = "2";
                            ELearning.push(OnlineQ);
                        }
                    });
                    if ($("#txtOther2").val() != "") {
                        var OnlineQ = {};
                        OnlineQ.Quiz = QuizText;
                        OnlineQ.Asnwer = $("#txtOther2").val();
                        OnlineQ.Cat = "2";
                        ELearning.push(OnlineQ);
                    }

                    ShowProgress();
                    $.ajax({
                        type: "POST",
                        url: "/LecturerEvaluation/SaveELearningCourseEvaluation",
                        data: JSON.stringify({ Lec: Lecturer, lecQuiz: LecEval, EQuiz: ELearning }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (data) {
                            if (data.success == true) {
                                HideProgress();
                                $("#Step4").addClass("d-none");
                                $("#Step5").removeClass("d-none");
                                Swal.fire('Success', data.message, 'success');
                            }
                            else {
                                HideProgress();
                                Swal.fire('Warning', data.message, 'warning');
                            }
                        },
                        error: function () {
                            HideProgress();
                            Swal.fire('Error', data.message, 'error');
                        }
                    });
                }
            }
            if (Mode == "2") {
                $("#TB4 tbody tr").each(function (index) {
                    SaveData = false;
                    ErroMsg = "";
                    if ($("input[name=Ans4" + (index + 1) + "]").is(':checked')) {
                        $(this).removeClass("rowFocus");
                        SaveData = true;
                    }
                    else {
                        $(this).addClass("rowFocus");
                        SaveData = false;
                        ErroMsg = "Answer question " + (index + 1) + "";
                        return false;
                    }
                });
                if (SaveData == false) {
                    Swal.fire('Warning', ErroMsg, 'warning');
                    return;
                }
                else {
                    $("#TB4 tbody tr").each(function (index) {
                        var EvalQuiz = {};
                        EvalQuiz.QuizCategory = FaceCat;
                        EvalQuiz.Quiz = $(this).find("input[type='hidden']").val();
                        EvalQuiz.Score = $("input[name=Ans4" + (index + 1) + "]:checked").val();
                        LecEval.push(EvalQuiz);
                    });
                    ShowProgress();
                    $.ajax({
                        type: "POST",
                        url: "/LecturerEvaluation/SaveSectionData",
                        data: JSON.stringify({ Lec: Lecturer, lecQuiz: LecEval, SectionOne: false, LastSection: false }),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (data) {
                            if (data.success == true) {
                                HideProgress();
                                $("#Step4").addClass("d-none");
                                $("#Step5").removeClass("d-none");
                                Swal.fire('Success', data.message, 'success');
                            }
                            else {
                                HideProgress();
                                Swal.fire('Warning', data.message, 'warning');
                            }
                        },
                        error: function () {
                            HideProgress();
                            Swal.fire('Error', data.message, 'error');
                        }
                    });
                }
            }
        }
    };
    var PreviousStep = function (step) {
        if (step == "1") {
            $("#Step2").addClass("d-none");
            $("#Step1").removeClass("d-none");
        }
        if (step == "2") {
            $("#Step3").addClass("d-none");
            $("#Step2").removeClass("d-none");
        }
        if (step == "3") {
            $("#Step4").addClass("d-none");
            $("#Step3").removeClass("d-none");
        }
        if (step == "4") {
            $("#Step5").addClass("d-none");
            $("#Step4").removeClass("d-none");
        }
        if (step == "5") {
            $("#Step6").addClass("d-none");
            $("#Step5").removeClass("d-none");
        }
    };
    var StudyMode = function (Type) {
        if (Type == "1") {
            $("#Online").removeClass("d-none");
            $("#FaceToFace").addClass("d-none");
        }
        else {
            $("#Online").addClass("d-none");
            $("#FaceToFace").removeClass("d-none");
        }
    };
</script>
