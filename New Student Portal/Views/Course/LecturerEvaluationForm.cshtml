@model New_Student_Portal.ViewModel.Lecturer
<div class="modal-content">
    <div class="modal-header" style="padding-top: 3px; padding-bottom: 3px">
        <h4 class="modal-title"><b>Lecturer Evaluation</b></h4>
    </div>
    <div class="modal-body" style="font-size: 12px">
        <p style="font-size: 14px; font-weight: bold; text-decoration: underline;">
            Introduction
        </p>
        <p>
            <u><b>PURPOSE AND CONFIDENTIALITY</b></u><br />
            The purpose of this evaluation is to provide feedback about the course presentation to help in future
            improvement. Please rate the statements given by choosing the most appropriate score as per the
            following scale:
        </p>
        <p style="font-weight:bold">1=Poor; 2=Reasonable; 3=Satisfactory; 4=Good; 5=Very good</p>
        <hr />
        <div class="panel panel-default">
            <div class="panel-body pre-scrollable">
                <table style="width: 100%;">
                    <thead>
                        <tr>
                            <th colspan="4">Lecturer Information</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="font-weight:bold; width:20%">Lecturer Name:</td>
                            <td style="width:80%">
                                <label id="lblLecturerName" class="label label-info">@Model.LecName</label>
                                <input type="hidden" id="lblLectNo" value="@Model.LecNo" />
                            </td>
                        </tr>                        
                        <tr>
                            <td style="font-weight:bold">Unit Code :</td>
                            <td>
                                <label id="lblUnitCode" class="label label-info">@Model.Unit</label>
                            </td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold">Unit Name :</td>
                            <td>
                                <label id="lblUnitName" class="label label-info">@Model.UnitName</label>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <hr />
        <div class="panel panel-default">
            <div class="panel-heading" style="font-weight: bold">
                A. Objective
            </div>
            <div class="panel-body pre-scrollable">
                <table class="table table-border-style" id="TB1">
                    <tbody>
                        <tr>
                            <td>
                                1. Clarity of the course objectives
                            </td>
                            <td>
                                <input id="Ans11" name="Ans1" type="radio" value="1" /> Poor&nbsp;
                                <input id="Ans12" name="Ans1" type="radio" value="2" /> Reasonable&nbsp;
                                <input id="Ans13" name="Ans1" type="radio" value="3" /> Satisfactory&nbsp;
                                <input id="Ans14" name="Ans1" type="radio" value="4" /> Good&nbsp;
                                <input id="Ans15" name="Ans1" type="radio" value="5" /> Very good
                            </td>
                        </tr>
                        <tr>
                            <td>
                                2. Achievement of the course objectives
                            </td>
                            <td>
                                <input id="Ans21" name="Ans2" type="radio" value="1" /> Poor&nbsp;
                                <input id="Ans22" name="Ans2" type="radio" value="2" /> Reasonable&nbsp;
                                <input id="Ans23" name="Ans2" type="radio" value="3" /> Satisfactory&nbsp;
                                <input id="Ans24" name="Ans2" type="radio" value="4" /> Good&nbsp;
                                <input id="Ans25" name="Ans2" type="radio" value="5" /> Very good
                            </td>
                        </tr>
                        <tr>
                            <td>
                                3. Relevance of course to program objectives
                            </td>
                            <td>
                                <input id="Ans31" name="Ans3" type="radio" value="1" /> Poor&nbsp;
                                <input id="Ans32" name="Ans3" type="radio" value="2" /> Reasonable&nbsp;
                                <input id="Ans33" name="Ans3" type="radio" value="3" /> Satisfactory&nbsp;
                                <input id="Ans34" name="Ans3" type="radio" value="4" /> Good&nbsp;
                                <input id="Ans35" name="Ans3" type="radio" value="5" /> Very good
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading" style="font-weight: bold">
                B. Course Content and methodology
            </div>
            <div class="panel-body">
                <div class="panel-body pre-scrollable">
                    <table class="table table-border-style" id="TB2">
                        <tbody>
                            <tr>
                                <td>
                                    4. Presents course concepts and theories in a clear
                                    and interesting way
                                </td>
                                <td>
                                    <input id="Ans211" name="Ans21" type="radio" value="1" /> Poor&nbsp;
                                    <input id="Ans212" name="Ans21" type="radio" value="2" /> Reasonable&nbsp;
                                    <input id="Ans213" name="Ans21" type="radio" value="3" /> Satisfactory&nbsp;
                                    <input id="Ans214" name="Ans21" type="radio" value="4" /> Good&nbsp;
                                    <input id="Ans215" name="Ans21" type="radio" value="5" /> Very good
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    5.Clarity in presentation of course content
                                </td>
                                <td>
                                    <input id="Ans221" name="Ans22" type="radio" value="1" /> Poor&nbsp;
                                    <input id="Ans222" name="Ans22" type="radio" value="2" /> Reasonable&nbsp;
                                    <input id="Ans223" name="Ans22" type="radio" value="3" /> Satisfactory&nbsp;
                                    <input id="Ans224" name="Ans22" type="radio" value="4" /> Good&nbsp;
                                    <input id="Ans225" name="Ans22" type="radio" value="5" /> Very good
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    6. Coverage of course syllabus within the given time
                                </td>
                                <td>
                                    <input id="Ans231" name="Ans23" type="radio" value="1" /> Poor&nbsp;
                                    <input id="Ans232" name="Ans23" type="radio" value="2" /> Reasonable&nbsp;
                                    <input id="Ans233" name="Ans23" type="radio" value="3" /> Satisfactory&nbsp;
                                    <input id="Ans234" name="Ans23" type="radio" value="4" /> Good&nbsp;
                                    <input id="Ans235" name="Ans23" type="radio" value="5" /> Very good
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading" style="font-weight: bold">
                C. Materials and Physical Facilities
            </div>
            <div class="panel-body pre-scrollable">
                <table class="table table-border-style" id="TB3">
                    <tbody>
                        <tr>
                            <td>
                                7. Relevance and sufficiency of teaching materials
                            </td>
                            <td>
                                <input id="Ans311" name="Ans31" type="radio" value="1" /> Poor&nbsp;
                                <input id="Ans312" name="Ans31" type="radio" value="2" /> Reasonable&nbsp;
                                <input id="Ans313" name="Ans31" type="radio" value="3" /> Satisfactory&nbsp;
                                <input id="Ans314" name="Ans31" type="radio" value="4" /> Good&nbsp;
                                <input id="Ans315" name="Ans31" type="radio" value="5" /> Very good
                            </td>
                        </tr>
                        <tr>
                            <td>
                                8. Guidance on source of internet material
                            </td>
                            <td>
                                <input id="Ans321" name="Ans32" type="radio" value="1" /> Poor&nbsp;
                                <input id="Ans322" name="Ans32" type="radio" value="2" /> Reasonable&nbsp;
                                <input id="Ans323" name="Ans32" type="radio" value="3" /> Satisfactory&nbsp;
                                <input id="Ans324" name="Ans32" type="radio" value="4" /> Good&nbsp;
                                <input id="Ans325" name="Ans32" type="radio" value="5" /> Very good
                            </td>
                        </tr>
                        <tr>
                            <td>
                                9. Guidance on the use of library material
                            </td>
                            <td>
                                <input id="Ans331" name="Ans33" type="radio" value="1" /> Poor&nbsp;
                                <input id="Ans332" name="Ans33" type="radio" value="2" /> Reasonable&nbsp;
                                <input id="Ans333" name="Ans33" type="radio" value="3" /> Satisfactory&nbsp;
                                <input id="Ans334" name="Ans33" type="radio" value="4" /> Good&nbsp;
                                <input id="Ans335" name="Ans33" type="radio" value="5" /> Very good
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading" style="font-weight: bold">
                D. Assignments
            </div>
            <div class="panel-body pre-scrollable">
                <table class="table table-border-style" id="TB4">
                    <tbody>
                        <tr>
                            <td>
                                10. Relevance and usefulness of course assignments
                            </td>
                            <td>
                                <input id="Ans411" name="Ans41" type="radio" value="1" /> Poor&nbsp;
                                <input id="Ans412" name="Ans41" type="radio" value="2" /> Reasonable&nbsp;
                                <input id="Ans413" name="Ans41" type="radio" value="3" /> Satisfactory&nbsp;
                                <input id="Ans414" name="Ans41" type="radio" value="4" /> Good&nbsp;
                                <input id="Ans415" name="Ans41" type="radio" value="5" /> Very good
                            </td>
                        </tr>
                        <tr>
                            <td>
                                11. Gives relevant and challenging assignments/tests
                            </td>
                            <td>
                                <input id="Ans421" name="Ans42" type="radio" value="1" /> Poor&nbsp;
                                <input id="Ans422" name="Ans42" type="radio" value="2" /> Reasonable&nbsp;
                                <input id="Ans423" name="Ans42" type="radio" value="3" /> Satisfactory&nbsp;
                                <input id="Ans424" name="Ans42" type="radio" value="4" /> Good&nbsp;
                                <input id="Ans425" name="Ans42" type="radio" value="5" /> Very good
                            </td>
                        </tr>
                        <tr>
                            <td>
                                12. Marks assignments promptly
                            </td>
                            <td>
                                <input id="Ans431" name="Ans43" type="radio" value="1" /> Poor&nbsp;
                                <input id="Ans432" name="Ans43" type="radio" value="2" /> Reasonable&nbsp;
                                <input id="Ans433" name="Ans43" type="radio" value="3" /> Satisfactory&nbsp;
                                <input id="Ans434" name="Ans43" type="radio" value="4" /> Good&nbsp;
                                <input id="Ans435" name="Ans43" type="radio" value="5" /> Very good
                            </td>
                        </tr>
                        <tr>
                            <td>
                                13. Gives helpful feedback on assignments and tests
                            </td>
                            <td>
                                <input id="Ans441" name="Ans44" type="radio" value="1" /> Poor&nbsp;
                                <input id="Ans442" name="Ans44" type="radio" value="2" /> Reasonable&nbsp;
                                <input id="Ans443" name="Ans44" type="radio" value="3" /> Satisfactory&nbsp;
                                <input id="Ans444" name="Ans44" type="radio" value="4" /> Good&nbsp;
                                <input id="Ans445" name="Ans44" type="radio" value="5" /> Very good
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading" style="font-weight: bold">
                E. Availability of lecturer
            </div>
            <div class="panel-body pre-scrollable">
                <table class="table table-border-style" id="TB5">
                    <tbody>
                        <tr>
                            <td>
                                14. Punctuality and availability during class sessions
                            </td>
                            <td>
                                <input id="Ans511" name="Ans51" type="radio" value="1" /> Poor&nbsp;
                                <input id="Ans512" name="Ans51" type="radio" value="2" /> Reasonable&nbsp;
                                <input id="Ans513" name="Ans51" type="radio" value="3" /> Satisfactory&nbsp;
                                <input id="Ans514" name="Ans51" type="radio" value="4" /> Good&nbsp;
                                <input id="Ans515" name="Ans51" type="radio" value="5" /> Very good
                            </td>
                        </tr>
                        <tr>
                            <td>
                                15. Availability for consultation outside class time
                            </td>
                            <td>
                                <input id="Ans521" name="Ans52" type="radio" value="1" /> Poor&nbsp;
                                <input id="Ans522" name="Ans52" type="radio" value="2" /> Reasonable&nbsp;
                                <input id="Ans523" name="Ans52" type="radio" value="3" /> Satisfactory&nbsp;
                                <input id="Ans524" name="Ans52" type="radio" value="4" /> Good&nbsp;
                                <input id="Ans525" name="Ans52" type="radio" value="5" /> Very good
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading" style="font-weight: bold">
                F. Course Delivery
            </div>
            <div class="panel-body pre-scrollable">
                <table class="table table-border-style" id="TB6">
                    <tbody>
                        <tr>
                            <td>
                                16. Facilitates meaningful and active class participation by students
                            </td>
                            <td>
                                <input id="Ans611" name="Ans61" type="radio" value="1" /> Poor&nbsp;
                                <input id="Ans612" name="Ans61" type="radio" value="2" /> Reasonable&nbsp;
                                <input id="Ans613" name="Ans61" type="radio" value="3" /> Satisfactory&nbsp;
                                <input id="Ans614" name="Ans61" type="radio" value="4" /> Good&nbsp;
                                <input id="Ans615" name="Ans61" type="radio" value="5" /> Very good
                            </td>
                        </tr>
                        <tr>
                            <td>
                                17. Answers questions clearly
                            </td>
                            <td>
                                <input id="Ans621" name="Ans62" type="radio" value="1" /> Poor&nbsp;
                                <input id="Ans622" name="Ans62" type="radio" value="2" /> Reasonable&nbsp;
                                <input id="Ans623" name="Ans62" type="radio" value="3" /> Satisfactory&nbsp;
                                <input id="Ans624" name="Ans62" type="radio" value="4" /> Good&nbsp;
                                <input id="Ans625" name="Ans62" type="radio" value="5" /> Very good
                            </td>
                        </tr>
                        <tr>
                            <td>
                                18. Is open to diverse viewpoints
                            </td>
                            <td>
                                <input id="Ans631" name="Ans63" type="radio" value="1" /> Poor&nbsp;
                                <input id="Ans632" name="Ans63" type="radio" value="2" /> Reasonable&nbsp;
                                <input id="Ans633" name="Ans63" type="radio" value="3" /> Satisfactory&nbsp;
                                <input id="Ans634" name="Ans63" type="radio" value="4" /> Good&nbsp;
                                <input id="Ans635" name="Ans63" type="radio" value="5" /> Very good
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="panel panel-default">
            <div class="panel-heading" style="font-weight: bold">
                G. Comments and any other area of improvement of the course
            </div>
            <div class="panel-body">
                <textarea id="txtComments" class="form-control"></textarea>
            </div>
        </div>
        <br />
        <div align="center">
            <input type="submit" value="Submit Form" class="btn btn-danger" onclick="SubmitEvaluationForm();" style="color: palevioletred" />
        </div>
    </div>
</div>
