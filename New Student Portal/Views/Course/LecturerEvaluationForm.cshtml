
@model New_Student_Portal.ViewModel.Evaluation_Form
@{
    string Cat = "";
}
<style>
    .RadioClass {
        width: 20px;
        height: 20px;
        padding: 0px;
    }

    label {
        vertical-align: -webkit-baseline-middle;
    }
</style>
<div class="modal-content">
    <div class="modal-body" style="font-size: 12px">
        <p style="font-size: 14px; font-weight: bold; text-decoration: underline;">
            Introduction
        </p>
        <p>
            <u><b>PURPOSE AND CONFIDENTIALITY</b></u><br />
            The purpose of this evaluation is to provide feedback about the course presentation to help in future
            improvement. Please rate the statements given by choosing the most appropriate score as per the
            following scale:
        </p>
        <p style="font-weight:bold">
            1=Strongly Disagree; 2=Disagree; 3=Neutral; 4=Agree; 5=Strongly Agree
        </p>
        <hr />
        <div class="panel panel-default">
            <div class="panel-body pre-scrollable">
                <table style="width: 100%;">
                    <thead>
                        <tr>
                            <th colspan="4">Lecturer Information</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="font-weight:bold; width:20%">Lecturer Name:</td>
                            <td style="width:80%">
                                <asp:Label ID="lblLecturerName" runat="server" class="label label-info">@Model.LecDet.LecName</asp:Label>
                            </td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold">Unit Code :</td>
                            <td>
                                <asp:Label ID="lblUnitCode" class="label label-info">@Model.LecDet.Unit</asp:Label>
                            </td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold">Unit Name :</td>
                            <td>
                                <asp:Label ID="lblUnitName" runat="server" class="label label-info">@Model.LecDet.UnitName</asp:Label>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
        <hr style="border-bottom:3px solid Black" />
        <div id="Step1">
            <div class="panel panel-default">
                @foreach (var c in Model.Eval_Form_Quiz.Where(x => x.order == 1))
                {
                    Cat = "";
                    <div class="panel-heading" style="font-weight: bold">
                        @c.Category
                    </div>
                    <div class="responsive-table-plugin">
                        <div class="table-rep-plugin">
                            <div class="table-responsive" data-pattern="priority-columns">
                                <table class="table table-border-style" id="TB1">
                                    <thead>
                                        <tr>
                                            <th width="50%">Question</th>
                                            <th width="10%" style="text-align:center">Strongly Disagree</th>
                                            <th width="10%" style="text-align:center">Disagree</th>
                                            <th width="10%" style="text-align:center">Neutral</th>
                                            <th width="10%" style="text-align:center">Agree</th>
                                            <th width="10%" style="text-align:center">Strongly Agree</th>
                                        </tr>
                                    </thead>
                                    @{ int i = 1;}
                                    <tbody>
                                        @foreach (var d in c.Eval_Quiz)
                                        {
                                            string name = "Ans" + i.ToString();

                                            <tr>
                                                <td>
                                                    @i. @d.Quiz
                                                    <input type="hidden" value="@d.Quiz" id="@i" />
                                                </td>
                                                @for (int j = 1; j < 6; j++)
                                                {
                                                    string ID = "Ans1" + j.ToString();
                                                    <td align="center">
                                                        <input id="@ID" name="@name" type="radio" value="@j" class="RadioClass" />
                                                    </td>

                                                }
                                            </tr>
                                            i++;
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                    Cat = c.Category;
                }
            </div>
            <hr />
            <div class="row">
                <div class="d-inline col-8 col-sm-8 col-md-8" style="text-align:center">Steps 1 of 5</div>
                <div class="d-inline col-4 col-sm-4 col-md-4" style="text-align:right">
                    <button class="btn btn-sm btn-success" onclick="NextStep('2',true,false,'@Cat');">Next >>></button>
                </div>
            </div>
        </div>
        <div class="d-none" id="Step2">
