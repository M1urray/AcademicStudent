@model New_Student_Portal.ViewModel.StudentCourseDetails
@{
    ViewBag.Title = "Course Registration";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<div class="card">
    <div class="card-body">
        <div id="divCourseReg"></div>
    </div> <!-- end card-body -->
    <div class="row" style="background-color: white;padding: 17px; border: 5px solid #7ca23b; border-radius: 10px">
        <div class="col-md-12" style="padding: 5px">
            <h4>COURSE REGISTRATION</h4>
            <h6>Registration Semester : <span style="font-size:12px" class="badge badge-soft-pink"> @Session["CurrentSem"].ToString()</span></h6>
            <hr />
            <span style="font-size: 10pt; color: orangered">
                Click on the button "<strong><em>Get Courses to Register</em></strong>".
                Select your Courses and click button "<strong><em> Add Selected Courses to the Basket</em></strong>", Confirm them then Complete registration by clicking button"<strong><em> Complete Registration.</em></strong>" You can view Proforma Invoice by clicking button "<strong><em> View Proforma Invoice</em></strong>"
            </span>
            <hr />
            <div style="background-color: #afaaaa;padding:10px">
                <h4>Filters</h4>
                <hr />
                <div class="row">
                    <div class="col-md-4">
                        <span style="font-size: 16px; font-weight: bold">Registration Type:</span>
                        <select class="form-select" id="RegType" name="RegType" onchange="ShowBasketUnits();">
                            <option value="">--Registration Type--</option>
                            <option value="0">Nominal Roll</option>
                            @* <option value="2">Supplementary</option> *@
                            @* <option value="3">Retake</option> *@
                        </select>
                    </div>
                </div>
                <div id="divGetUnits">
                    <hr />
                    <div align="center">
                        <input type="button" class="btn btn-danger" id="btnSumit" value="Get Units" onclick="GetUnits();" />
                    </div>
                </div>
            </div>
            <hr />
            @*<div class="row">
                <div class="col-md-4">
                    <input type="button" class="btn btn-primary form-control" value="View Proforma Invoice" onclick="GetProformaInvoice();" />
                    <hr />
                </div>
            </div>*@
        </div>
    </div>

</div> <!-- end card-->
@*//////////////////////Modal////////////////////////////*@
<div id="myModalUnits" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelT"></label></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModalReports" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelTitle"></label></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBodyReport">
                <iframe id="iframe" style="width:100%;height:450px"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#divGetUnits").hide();

        LoadCourseRegistrationDetails("");
    });
    var ShowBasketUnits = function () {
        var RegT = $("#RegType").children("option:selected").val();

        if (RegT == "") {
            $("#divGetUnits").hide();
        }
        else {
            if (RegT == "0") {
                $("#btnSumit").val("Sign Norminal Roll");
            }
            else {
                $("#btnSumit").val("Get Units");
            }
            $("#divGetUnits").show();
        }
    }
    function LoadCourseRegistrationDetails(RegT) {
        ShowProgress();
        $.ajax({
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ RegT: RegT }),
            contentType: "application/json; charset = utf-8",
            url: '@Url.Action("CourseRegistrationDetails", "Course")',
            success: function (data) {
                $("#divCourseReg").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'There is some problem to process your request. Please try after some time', 'warning');
            }
        });
    }
    var ViewUnits = function (RegID, prog, stage, sem, regFor) {
        var x = document.getElementById("labelT");
        x.innerHTML = 'Student Units';
        var StudentUnits = {};
        StudentUnits.Programme = prog;
        StudentUnits.Stage = stage;
        StudentUnits.Semester = sem;
        StudentUnits.RegFor = regFor;
        StudentUnits.RegID = RegID;
        ShowProgress();
        $.ajax({
            url: '@Url.Action("ViewStudentRegisteredUnits", "Course")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ Filters: StudentUnits }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalUnits").modal("show");
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var GetUnits = function () {
        var regType = $("#RegType").children("option:selected").val();
        var title = "Units Registration";
        if (regType == "") {
            Swal.fire('Warning', 'Kindly select the Registration Type', 'warning');
            return;
        }
        else {
            var x = document.getElementById("labelT");
            x.innerHTML = title;
            if (regType == "0") {
                //ShowProgress();
                $.ajax({
                    url: '@Url.Action("SignNorminalRoll", "Course")',
                    datatype: "json",
                    type: "POST",
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        //HideProgress();
                        if (data.success == true) {
                            //HideProgress();
                            LoadCourseRegistrationDetails(regType);
                            Swal.fire('Success', data.message, 'success');
                        }
                        else {
                            HideProgress();
                            Swal.fire('Warning', data.message, 'warning');
                        }
                    },
                    error: function () {
                        HideProgress();
                        Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
                    }
                });
            }
            else {
                ShowProgress();
                $.ajax({
                    url: '@Url.Action("GetProgramUnits", "Course")',
                    datatype: "json",
                    type: "POST",
                    data: JSON.stringify({ RegType: regType}),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        HideProgress();
                        LoadCourseRegistrationDetails(regType);
                        $("#modalBody").html(data);
                        $("#myModalUnits").modal("show");
                    },
                    error: function () {
                        HideProgress();
                        Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
                    }
                });
            }
        }
    }
    var SubmitSelectedUnits = function (regT) {
        var unitReg = new Array();
        var regType = $("#RegType").children("option:selected").val();
        $("#tblProgUnit tbody tr").each(function () {
            var row = $(this);
//            if (row.find('input[type="checkbox"]').is(':checked')) {
                var Unit = {};
                Unit.UnitCode = row.find("td").eq(1).html();
                Unit.ClassCode = row.find("td").eq(2).html();
                Unit.Day = row.find("td").eq(4).html();
                Unit.Period = row.find("td").eq(5).html();
                Unit.Campus = row.find("td").eq(6).html();
                unitReg.push(Unit);
//            }
        });
        if (unitReg.length < 1) {
            Swal.fire('Warning', 'You have not selected any unit', 'warning');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                type: "POST",
                url: '@Url.Action("SaveSelectedUnits", "Course")',
                data: JSON.stringify({ UnitReg: unitReg, RegT: regType }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        LoadBasketUnits(regT);
                        $("#myModalUnits").modal("hide");
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('Warning', data.message, 'warning');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            });
        }
    }
    var DropUnit = function (prog, stage, sem, Unit) {
        var regType = $("#RegType").children("option:selected").val();
        var UnitFilters = {};
        UnitFilters.prog = prog;
        UnitFilters.stage = stage;
        UnitFilters.sem = sem;
        UnitFilters.Unit = Unit;
        ShowProgress();
        $.ajax({
            url: '@Url.Action("DropBasketUnit", "Course")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ Filters: UnitFilters }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    LoadCourseRegistrationDetails(regType);
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    HideProgress();
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function () {
                HideProgress();
                Swal.fire('Error', data.message, 'error');
            }
        });
    }
    var RegisterSelectedUnits = function () {
        var regType = $("#RegType").children("option:selected").val();
        if (regType == "") {
            Swal.fire('Warning', 'Kindly select the Registration Type', 'warning');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                type: "POST",
                url: '@Url.Action("RegisterSelectedUnits", "Course")',
                data: JSON.stringify({ RegT: regType }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success == true) {
                        if (data.Redirect == true) {
                            window.location = data.message;
                        }
                        else {
                            HideProgress();
                            LoadCourseRegistrationDetails(regType);
                            Swal.fire('Success', data.message, 'success');

                        }
                    }
                    else {
                        HideProgress();
                        LoadCourseRegistrationDetails(regType);
                        Swal.fire('Error', data.message, 'error');
                    }
                },
                error: function (data) {
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            });
        }
    }
    var DropRegisteredUnit = function (button, prog, sem, Unit, RegFor) {
        var regType = $("#RegType").children("option:selected").val();
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'No, cancel!',
            confirmButtonClass: 'btn btn-success mt-2',
            cancelButtonClass: 'btn btn-danger ms-2 mt-2',
            buttonsStyling: false
        }).then(function (result) {
            if (result.value) {
                var UnitFilters = {};
                UnitFilters.prog = prog;
                //UnitFilters.stage = stage;
                UnitFilters.sem = sem;
                UnitFilters.Unit = Unit;
                //UnitFilters.UnitName = UnitName;
                UnitFilters.RegFor = RegFor;
                ShowProgress();
                $.ajax({
                    url: '@Url.Action("DropRegisteredUnit", "Course")',
                    datatype: "json",
                    type: "POST",
                    data: JSON.stringify({ Filters: UnitFilters }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        if (data.success == true) {
                            HideProgress();
                            Swal.fire('Success', data.message, 'success');
                            LoadCourseRegistrationDetails(regType);

                            var row = $(button).closest("TR");
                            var table = $("#tbRegUnits")[0];
                            //Delete the Table row using it's Index.
                            table.deleteRow(row[0].rowIndex);
                        }
                        else {
                            HideProgress();
                            Swal.fire('Warning', data.message, 'warning');
                        }
                    },
                    error: function () {
                        HideProgress();
                        Swal.fire('Error', data.message, 'error');
                    }
                });
            } else if (result.dismiss === Swal.DismissReason.cancel) {
                Swal.fire({
                    title: 'Cancelled',
                    text: 'Unit has not been dropped. Its safe',
                    icon: 'error',
                    confirmButtonColor: "#1abc9c",
                });
            }
        });
    }
    var PrintCourseStatement = function () {
        var x = document.getElementById("labelTitle");
        x.innerHTML = 'Course Statement';
        ShowProgress();
        $.ajaxSetup({
            cache: false
        });
        $.ajax({
            url: '@Url.Action("PrintCourseStatement", "ViewDocuments")',
            type: "POST",
            datatype: "json",
            cache: false,
            contentType: "application/json; charset = utf-8",
            processData: false,
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', data.message);
                    $("#myModalReports").modal("show");
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }

            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var GetProformaInvoice = function () {
        var x = document.getElementById("labelTitle");
        x.innerHTML = 'Proforma Invoice';
        ShowProgress();
        $.ajax({
            url: '@Url.Action("ProformaInvoice", "ViewDocuments")',
            type: "POST",
            //async: false,
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', "data:application/pdf;base64," + data.message);
                    $("#myModalReports").modal("show");
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>

