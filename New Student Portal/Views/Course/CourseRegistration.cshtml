@model New_Student_Portal.ViewModel.StudentCourseDetails
@{
    ViewBag.Title = "Course Registration";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<div class="card">
    <div class="card-body">
        <div id="divCourseReg"></div>
    </div> <!-- end card-body -->
</div> <!-- end card-->
@*//////////////////////Modal////////////////////////////*@
<div id="myModalUnits" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelT"></label></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModalReports" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelTitle"></label></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBodyReport">
                <iframe id="iframe" style="width:100%;height:450px"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        LoadCourseRegistrationDetails("");
    });
    function LoadCourseRegistrationDetails(RegT) {
        ShowProgress();
        $.ajax({
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ RegT: RegT }),
            contentType: "application/json; charset = utf-8",
            url: '@Url.Action("CourseRegistrationDetails", "Course")',
            success: function (data) {
                $("#divCourseReg").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'There is some problem to process your request. Please try after some time', 'warning');
            }
        });
    }
    var ViewUnits = function (RegID, prog, stage, sem, regFor) {
        var x = document.getElementById("labelT");
        x.innerHTML = 'Student Units';
        var StudentUnits = {};
        StudentUnits.Programme = prog;
        StudentUnits.Stage = stage;
        StudentUnits.Semester = sem;
        StudentUnits.RegFor = regFor;
        StudentUnits.RegID = RegID;
        ShowProgress();
        $.ajax({
            url: '@Url.Action("ViewStudentRegisteredUnits", "Course")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ Filters: StudentUnits }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalUnits").modal("show");
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var GetUnits = function (Prog) {
        var regType = $("#RegType").children("option:selected").val();
        var Stage = $("#ddlStage").children("option:selected").val();
        var Option = $("#ddlProgOption").children("option:selected").val();
        var Title = "Units Registration";
        if (regType == "") {
            Swal.fire('Warning', 'Kindly select the Registration Type', 'warning');
            return;
        }
        else if ((Stage == "") && (regType == "2" || regType=="3")) {
            Swal.fire('Warning', 'Kindly select Stage', 'warning');
            return;
        }
        else {
            ShowProgress();
                var x = document.getElementById("labelT");
                x.innerHTML = Title;
                $.ajax({
                    url: '@Url.Action("GetProgramUnits", "Course")',
                    datatype: "json",
                    type: "POST",
                    data: JSON.stringify({ RegType: regType, Prog: Prog, Stage: Stage, Option: Option }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        HideProgress();
                        LoadCourseRegistrationDetails(regType);
                        $("#modalBody").html(data);
                        $("#myModalUnits").modal("show");
                    },
                    error: function () {
                        HideProgress();
                        Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
                    }
                });
        }
    }
    var GetFreeElectiveUnits = function () {
        ShowProgress();
        var x = document.getElementById("labelT");
        x.innerHTML = 'Free Elective Course Registration';

        $.ajax({
            url: '@Url.Action("GetFreeElectiveUnits", "Course")',
            datatype: "json",
            type: "POST",
            //data: JSON.stringify({ Type: regType, HostelCode: HostelCode }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                $("#modalBody").html(data);
                $("#myModalUnits").modal("show");
                HideProgress();
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var SubmitSelectedUnits = function (RegT,Stage) {
        var UnitReg = new Array();
        $("#tblProgUnit tbody tr").each(function () {
            var row = $(this);
            if (row.find('input[type="checkbox"]').is(':checked')) {
                var Unit = {};
                Unit.UnitCode = row.find("td").eq(1).html();
                UnitReg.push(Unit);
            }
        });
        if (UnitReg.length < 1) {
            Swal.fire('Warning', 'You have not selected any unit', 'warning');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                type: "POST",
                url: '@Url.Action("SaveSelectedUnits", "Course")',
                data: JSON.stringify({ UnitReg: UnitReg, RegT: RegT, Stage:Stage }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        LoadCourseRegistrationDetails(RegT);
                        $("#myModalUnits").modal("hide");
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('Warning', data.message, 'warning');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            });
        }
    }
    var DropUnit = function (prog, stage, sem, Unit) {
        var regType = $("#RegType").children("option:selected").val();
        var UnitFilters = {};
        UnitFilters.prog = prog;
        UnitFilters.stage = stage;
        UnitFilters.sem = sem;
        UnitFilters.Unit = Unit;
        ShowProgress();
        $.ajax({
            url: '@Url.Action("DropBasketUnit", "Course")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ Filters: UnitFilters }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    LoadCourseRegistrationDetails(regType);
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    HideProgress();
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function () {
                HideProgress();
                Swal.fire('Error', data.message, 'error');
            }
        });
    }
    var RegisterSelectedUnits = function () {
        var regType = $("#RegType").children("option:selected").val();
        if (regType == "") {
            Swal.fire('Warning', 'Kindly select the Registration Type', 'warning');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                type: "POST",
                url: '@Url.Action("RegisterSelectedUnits", "Course")',
                data: JSON.stringify({ RegT: regType }),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success == true) {
                        if (data.Redirect == true) {
                            window.location = data.message;
                        }
                        else {
                            HideProgress();
                            LoadCourseRegistrationDetails(regType);
                            Swal.fire('Success', data.message, 'success');
                        }
                    }
                    else {
                        HideProgress();
                        LoadCourseRegistrationDetails(regType);
                        Swal.fire('Error', data.message, 'error');
                    }
                },
                error: function (data) {
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            });
        }
    }
    var DropRegisteredUnit = function (button, prog, sem, Unit, UnitName, RegFor) {
        var regType = $("#RegType").children("option:selected").val();
        Swal.fire({
            title: 'Are you sure?',
            text: "You won't be able to revert this!",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, delete it!',
            cancelButtonText: 'No, cancel!',
            confirmButtonClass: 'btn btn-success mt-2',
            cancelButtonClass: 'btn btn-danger ms-2 mt-2',
            buttonsStyling: false
        }).then(function (result) {
            if (result.value) {
                var UnitFilters = {};
                UnitFilters.prog = prog;
                //UnitFilters.stage = stage;
                UnitFilters.sem = sem;
                UnitFilters.Unit = Unit;
                UnitFilters.UnitName = UnitName;
                UnitFilters.RegFor = RegFor;
                ShowProgress();
                $.ajax({
                    url: '@Url.Action("DropRegisteredUnit", "Course")',
                    datatype: "json",
                    type: "POST",
                    data: JSON.stringify({ Filters: UnitFilters }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        if (data.success == true) {
                            HideProgress();
                            Swal.fire('Success', data.message, 'success');
                            LoadCourseRegistrationDetails(regType);

                            var row = $(button).closest("TR");
                            var table = $("#tbRegUnits")[0];
                            //Delete the Table row using it's Index.
                            table.deleteRow(row[0].rowIndex);
                        }
                        else {
                            HideProgress();
                            Swal.fire('Warning', data.message, 'warning');
                        }
                    },
                    error: function () {
                        HideProgress();
                        Swal.fire('Error', data.message, 'error');
                    }
                });
            } else if (result.dismiss === Swal.DismissReason.cancel) {
                Swal.fire({
                    title: 'Cancelled',
                    text: 'Unit has not been dropped. Its safe',
                    icon: 'error',
                    confirmButtonColor: "#1abc9c",
                });
            }
        });
    }
    var PrintCourseStatement = function () {
        var x = document.getElementById("labelTitle");
        x.innerHTML = 'Course Statement';
        ShowProgress();
        $.ajax({
            url: '@Url.Action("PrintCourseStatement", "Course")',
            type: "POST",
            //async: false,
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', data.message);
                    $("#myModalReports").modal("show");
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }

            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var GetProformaInvoice = function () {
        var x = document.getElementById("labelTitle");
        x.innerHTML = 'Proforma Invoice';
        ShowProgress();
        $.ajax({
            url: '@Url.Action("ProformaInvoice", "ViewDocuments")',
            type: "POST",
            //async: false,
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', data.message);
                    $("#myModalReports").modal("show");
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>

