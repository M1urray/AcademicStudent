@model New_Student_Portal.ViewModel.StudentCourseDetails
@{
    ViewBag.Title = "Course Registration";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<div class="card">
    <div class="card-body">
        <hr />
        <div id="divCourseReg"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModalUnits" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelT"></label></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModalReports" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelTitle"></label></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBodyReport">
                <iframe id="iframe" style="width:100%;height:450px"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        LoadCourseRegistrationDetails();
    });
    function LoadCourseRegistrationDetails() {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: '@Url.Action("CourseRegistrationDetails", "Course")',
            success: function (data) {
                $("#divCourseReg").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'There is some problem to process your request. Please try after some time', 'warning');
            }
        });
    }
    var ViewUnits = function (RegID, prog, stage, sem, regFor) {
        var x = document.getElementById("labelT");
        x.innerHTML = 'Student Units';
        var StudentUnits = {};
        StudentUnits.Programme = prog;
        StudentUnits.Stage = stage;
        StudentUnits.Semester = sem;
        StudentUnits.RegFor = regFor;
        StudentUnits.RegID = RegID;
        ShowProgress();
        $.ajax({
            url: '@Url.Action("ViewStudentRegisteredUnits", "Course")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ Filters: StudentUnits }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalUnits").modal("show");
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var GetUnits = function () {
        var regType = $("#RegType").children("option:selected").val();
        if (regType == "") {
            Swal.fire('Warning', 'Select Registration Type', 'warning');
            return;
        }
        ShowProgress();
        var x = document.getElementById("labelT");
        x.innerHTML = 'Course Registration';
        $.ajax({
            url: '@Url.Action("GetProgramUnits", "Course")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ Type: regType }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                $("#modalBody").html(data);
                $("#myModalUnits").modal("show");
                HideProgress();
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var SubmitResidenceOption = function () {
        var residency = $("#ddlResidency").children("option:selected").val();
        if (residency == "") {
            Swal.fire('Error', 'Select your residency', 'error');
            return;
        }
        else {
            if (residency == "1") {
                $.ajax({
                    url: '@Url.Action("SaveResidenctInformation", "Course")',
                    datatype: "json",
                    type: "POST",
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        $("#modalBody").html(data);
                        $("#myModalUnits").modal("show");
                        HideProgress();
                    },
                    error: function () {
                        HideProgress();
                        Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
                    }
                });
            }
            else {
                $.ajax({
                    url: '@Url.Action("GetNonResidencyForm", "Course")',
                    datatype: "json",
                    type: "POST",
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        $("#modalBody").html(data);
                        $("#myModalUnits").modal("show");
                        HideProgress();
                    },
                    error: function () {
                        HideProgress();
                        Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
                    }
                });
            }
        }
    };
    var GetProgOptionUnits = function () {
        ShowProgress();
        var ProgOption = $("#ddlOption").children("option:selected").val();
        $.ajax({
            url: '@Url.Action("GetProgramUnitsWithOptions", "Course")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ Option: ProgOption, Type: "1" }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModalUnits").modal("show");
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var SubmitResidenceForm = function () {
        var Premise = $("#txtPremise").val();
        var roomNo = $("#txtRoomNo").val();
        var LandLoard = $("#txtLardLord").val();
        var caretaker = $("#txtCaretaker").val();
        var witness = $("#txtWitness").val();
        var areaName = $("#txtAreaName").val();
        if (Premise == "") {
            Swal.fire('Warning', 'State the premise', 'warning');
            return;
        }
        else if (roomNo == "") {
            Swal.fire('Warning', 'State the Room Number', 'warning');
            return;
        }
        else if (LandLoard == "") {
            Swal.fire('Warning', 'State the Name of the landloard', 'warning');
            return;
        }
        else if (caretaker == "") {
            Swal.fire('Warning', 'State the Name of the caretaker', 'warning');
            return;
        }
        else if (areaName == "") {
            Swal.fire('Warning', 'State the area name', 'warning');
            return;
        }
        else {
            var NonResidenceData = {};
            NonResidenceData.Premise = Premise;
            NonResidenceData.RoomNo = roomNo;
            NonResidenceData.LandLoard = LandLoard;
            NonResidenceData.Caretaker = caretaker;
            NonResidenceData.Witness = witness;
            NonResidenceData.AreaName = areaName;
            ShowProgress();
            $.ajax({
                url: '@Url.Action("SaveNonResidencedata", "Course")',
                datatype: "json",
                type: "POST",
                data: JSON.stringify({ ResData: NonResidenceData }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    $("#modalBody").html(data);
                    $("#myModalUnits").modal("show");
                    HideProgress();
                },
                error: function () {
                    HideProgress();
                    Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
                }
            });
        }
    }
    var SubmitSelectedUnits = function () {
        var UnitReg = new Array();
        $("#tblProgUnit tbody tr").each(function () {
            var row = $(this);
            if (row.find('input[type="checkbox"]').is(':checked')) {
                var Unit = {};
                Unit.UnitCode = row.find("td").eq(1).html();
                UnitReg.push(Unit);
            }
        });
        $("#tblProgUnitRequired tbody tr").each(function () {
            var row = $(this);
            if (row.find('input[type="checkbox"]').is(':checked')) {
                var Unit = {};
                Unit.UnitCode = row.find("td").eq(1).html();
                UnitReg.push(Unit);
            }
        });
        $("#tblProgUnitElective tbody tr").each(function () {
            var row = $(this);
            if (row.find('input[type="checkbox"]').is(':checked')) {
                var Unit = {};
                Unit.UnitCode = row.find("td").eq(1).html();
                UnitReg.push(Unit);
            }
        });
        if (UnitReg.length < 1) {
            Swal.fire('Warning', 'You have not selected any unit', 'warning');
            return;
        }
        else {
            $("#myModalUnits").modal("hide");
            ShowProgress();
            $.ajax({
                type: "POST",
                url: '@Url.Action("SaveSelectedUnits", "Course")',
                data: JSON.stringify(UnitReg),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        LoadCourseRegistrationDetails();
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('Warning', data.message, 'warning');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            });
        }
    }

    var SubmitSelectedBonusCourses = function () {
        var UnitReg = new Array();
        $("#tblProgUnit tbody tr").each(function () {
            var row = $(this);
            if (row.find('input[type="radio"]').is(':checked')) {
                var Unit = {};
                Unit.UnitCode = row.find("td").eq(1).html();
                UnitReg.push(Unit);
            }
        });
        $("#tblProgUnitRequired tbody tr").each(function () {
            var row = $(this);
            if (row.find('input[type="radio"]').is(':checked')) {
                var Unit = {};
                Unit.UnitCode = row.find("td").eq(1).html();
                UnitReg.push(Unit);
            }
        });
        $("#tblProgUnitElective tbody tr").each(function () {
            var row = $(this);
            if (row.find('input[type="radio"]').is(':checked')) {
                var Unit = {};
                Unit.UnitCode = row.find("td").eq(1).html();
                UnitReg.push(Unit);
            }
        });
        if (UnitReg.length < 1) {
            Swal.fire('Warning', 'You have not selected any unit', 'warning');
            return;
        }
        else {
            $("#myModalUnits").modal("hide");
            ShowProgress();
            $.ajax({
                type: "POST",
                url: '@Url.Action("SaveSelectedUnits", "Course")',
                data: JSON.stringify(UnitReg),
                contentType: "application/json; charset=utf-8",
                dataType: "json",
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        LoadCourseRegistrationDetails();
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('Warning', data.message, 'warning');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('Error', data.message, 'error');
                }
            });
        }
    }
    var DropUnit = function (prog, stage, sem, Unit) {
        var UnitFilters = {};
        UnitFilters.prog = prog;
        UnitFilters.stage = stage;
        UnitFilters.sem = sem;
        UnitFilters.Unit = Unit;
        ShowProgress();
        $.ajax({
            url: '@Url.Action("DropBasketUnit", "Course")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ Filters: UnitFilters }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    LoadCourseRegistrationDetails();
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    HideProgress();
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function () {
                HideProgress();
                Swal.fire('Error', data.message, 'error');
            }
        });
    }
    var RegisterSelectedUnits = function () {
        ShowProgress();
        $.ajax({
            type: "POST",
            url: '@Url.Action("RegisterSelectedUnits", "Course")',
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    LoadCourseRegistrationDetails();
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    HideProgress();
                    LoadCourseRegistrationDetails();
                    Swal.fire('Error', data.message, 'error');
                }
            },
            error: function (data) {
                HideProgress();
                Swal.fire('Error', data.message, 'error');
            }
        });
    }
    var DropRegisteredUnit = function (button, prog, stage, sem, Unit, UnitName, RegFor) {
        Swal.fire({
            title: "Are you sure?",
            text: "You want to drop unit <b>" + UnitName + "</b>",
            type: "warning",
            showCancelButton: true,
            confirmButtonColor: '#3085d6',
            cancelButtonColor: '#d33',
            confirmButtonText: "Yes, Drop it!",
            closeOnConfirm: false,
            html: true
        },
            function () {
                var UnitFilters = {};
                UnitFilters.prog = prog;
                UnitFilters.stage = stage;
                UnitFilters.sem = sem;
                UnitFilters.Unit = Unit;
                UnitFilters.UnitName = UnitName;
                UnitFilters.RegFor = RegFor;
                ShowProgress();
                $.ajax({
                    url: '@Url.Action("DropRegisteredUnit", "Course")',
                    datatype: "json",
                    type: "POST",
                    data: JSON.stringify({ Filters: UnitFilters }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        if (data.success == true) {
                            HideProgress();
                            Swal.fire('Success', data.message, 'success');
                            LoadCourseRegistrationDetails();

                            var row = $(button).closest("TR");
                            var table = $("#tbRegUnits")[0];
                            //Delete the Table row using it's Index.
                            table.deleteRow(row[0].rowIndex);
                        }
                        else {
                            HideProgress();
                            Swal.fire('Warning', data.message, 'warning');
                        }
                    },
                    error: function () {
                        HideProgress();
                        Swal.fire('Error', data.message, 'error');
                    }
                });
            });
    }
    var PrintCourseStatement = function () {
        var x = document.getElementById("labelTitle");
        x.innerHTML = 'Course Statement';
        ShowProgress();
        $.ajaxSetup({
            cache: false
        });
        $.ajax({
            url: '@Url.Action("PrintCourseStatement", "ViewDocuments")',
            type: "POST",
            datatype: "json",
            cache: false,
            contentType: "application/json; charset = utf-8",
            processData: false,
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', data.message);
                    $("#myModalReports").modal("show");
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }

            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var GetProformaInvoice = function () {
        var x = document.getElementById("labelTitle");
        x.innerHTML = 'Proforma Invoice';
        ShowProgress();
        $.ajaxSetup({
            cache: false
        });
        $.ajax({
            url: '@Url.Action("ProformaInvoice", "ViewDocuments")',
            type: "POST",
            datatype: "json",
            cache: false,
            contentType: "application/json; charset = utf-8",
            processData: false,
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', data.message);
                    $("#myModalReports").modal("show");
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>

