@model New_Student_Portal.ViewModel.GetRegisteredUnit
@using System.Globalization;
@{
    bool droUnit = false;
    if (Model.RegDeadlineDate != "")
    {
        DateTime regDeadLine = DateTime.ParseExact(Model.RegDeadlineDate.Replace("-", "/"), "dd/MM/yyyy", CultureInfo.InvariantCulture);
        if (regDeadLine >= DateTime.Today)
        {
            droUnit = true;
        }
        else
        {
            droUnit = false;
        }
    }
}
<style>
    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
</style>
<div class="responsive-table-plugin">
    <div class="table-rep-plugin">
        <div class="table-responsive" data-pattern="priority-columns">
            <table class="table" id="tbRegUnits">
                <thead>
                    <tr>
                        <th>
                            Programme
                        </th>
                        <th>
                            Stage
                        </th>
                        <th>
                            Semester
                        </th>
                        <th>
                            Unit
                        </th>
                        <th>
                            Description
                        </th>
                        <th>
                            Register for
                        </th>
                        @if (droUnit)
                        {
                            <th>
                                Action
                            </th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model.ListOfRegUnit != null)
                        {
                            if (Model.ListOfRegUnit.Count() > 0)
                            {
                                foreach (var item in Model.ListOfRegUnit)
                                {
                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Programme)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Stage)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Semester)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Unit)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Unit_Name)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.RegFor)
                                        </td>
                                        @if (droUnit)
                                        {
                                            <td align="center">
                                                <button class="btn btn-warning BtnPadding" onclick="DropRegisteredUnit(this,'@item.Programme','@item.Stage','@item.Semester','@item.Unit','@item.Unit_Name','@item.RegFor')">Drop</button>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" style="color:red">No Units Found</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" style="color:red">@ViewBag.Error</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


