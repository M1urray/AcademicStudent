@model IEnumerable<New_Student_Portal.ViewModel.StudentDetailView>
<style>
    thead {
        background-color: black;
        color: white;
    }

    tfoot {
        background-color: #051936;
        color: #cbcc32;
    }

    b, strong {
        font-size: 12px;
        text-decoration: underline;
    }

    .spanClass {
        font-size: 16px;
        font-weight: bold;
    }
</style>
<div class="pre-scrollable">
    <table class="table table-bordered table-responsive table-hover">
        <thead>
            <tr>
                <th>
                    Code
                </th>
                <th>
                    Date
                </th>
                <th>
                    Programme
                </th>

                @*<th>
                    Semester
                </th>*@
                <th>
                    Status
                </th>
                <th>
                    Action
                </th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model != null)
                {
                    if (Model.Count() > 0)
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.DocNo)
                                </td>
                                <td>
                                    @Convert.ToDateTime(item.DateRequested).ToString("yy/MM/yyyy")
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.ProgName)
                                </td>
                                @*<td>
                                    @Html.DisplayFor(modelItem => item.Semester)
                                </td>*@
                                <td>
                                    @Html.DisplayFor(modelItem => item.Status)
                                </td>
                                <td>
                                    @if (item.Status == "Pending Approval")
                                    {
                                        <button class="btn btn-sm btn-success" onclick="ViewApprovalTrail('@item.DocNo');">Approval Trail</button>
                                    }
                                    else if (item.Status == "Rejected")
                                    {
                                        <button class="btn btn-sm btn-danger" onclick="ViewComments('@item.DocNo');">View Comment</button>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-warning">No Action</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="color:red">
                                No Records Found
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>








