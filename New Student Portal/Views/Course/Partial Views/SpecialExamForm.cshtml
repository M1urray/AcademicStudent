@model New_Student_Portal.ViewModel.GetRegisteredUnit
<style>
    .checkboxClass {
        width: 20px;
        height: 20px;
        padding: 0px;
    }

    thead {
        background-color: black;
        color: white;
    }
</style>
<div class="pre-scrollable">
    <table class="table table-border-style" id="tbRegUnits">
        <thead>
            <tr>
                <th>Action</th>
                <th>
                    Unit
                </th>
                <th>
                    Description
                </th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.ListOfRegUnit != null)
                {
                    if (Model.ListOfRegUnit.Count() > 0)
                    {
                        foreach (var item in Model.ListOfRegUnit)
                        {
                            <tr>
                                <td align="center">
                                    <input type="checkbox" class="checkboxClass" />
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Unit)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Unit_Name)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" style="color:red">No Units Found</td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
    <hr />
    <div class="row">
        <div class="col-md-12">
            <span style="font-weight: bold">Special Exam reasons</span>
            @Html.DropDownListFor(model => model.Code, Model.ListOfSpecExmReasons, "--select Special Exam reason--", new { @class = "form-select", @id = "ddlSpcExmreason" })
        </div>
        <div class="col-md-12">
            <hr />
            <span style="font-weight: bold">Attach Reason</span>
            <input type="file" class="form-control" id="fileReasonAttachment" />
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#ddlSpcExmreason").select2({
            dropdownParent: $('#myModalUnits'),
            width: '100%'
        });
    });
</script>




