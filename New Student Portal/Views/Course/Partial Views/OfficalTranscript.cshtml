@model New_Student_Portal.ViewModel.DropdownListValues
<div class="row">
    <div class="col-md-6">
        <span style="font-weight: bold">Programme</span>
        @Html.DropDownListFor(model => model.Code, Model.ListOfValues, "--select Programme--", new { @class = "form-select", id = "ddlSTDProg" })
    </div>
    <div class="col-md-6">
        <span style="font-weight: bold">No. of Copies</span>
        <input type="text" id="txtNoCopies" class="form-control" onkeypress="return functionx(event)" />
    </div>
</div>
<script type="text/javascript">
    function functionx(evt) {
        if (evt.charCode > 31 && (evt.charCode < 48 || evt.charCode > 57)) {
            Swal.fire("Error", "Please enter only numeric characters in the text box", "error");
            return false;
        }
    }
</script>