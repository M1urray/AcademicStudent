@model New_Student_Portal.ViewModel.ProgrammeConcentration
<div class="row">
    <div class="col-md-12">
        <span style="font-weight: bold">Programme @Model.Conc</span>
        @Html.DropDownListFor(model => model.Code, Model.ListOfConcentration, "--select Option--", new { @class = "form-select", id = "ddlConcentration" })
    </div>
</div>
@if (@Model.RegType == "2")
{
    <hr />
    <div class="row">
        <div class="col-md-12">
            <div class="form-group">
                @Html.Label("Attach High School Certificate", htmlAttributes: new { @class = "control-label col-md-12" })
                <div class="col-md-12">
                    <table id="tableAttachments" width="100%" class="table table-bordered table-hover">
                        <tbody>
                            <tr>
                                <td>
                                    <input type="file" id="CertfileAttachment" class="form-control" required="" />
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}
<script type="text/javascript">
    $(document).ready(function () {
        $("#ddlConcentration").select2({
            dropdownParent: $('#myModalUnits'),
            width: '100%'
        });
    });
</script>
