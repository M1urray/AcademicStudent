@model New_Student_Portal.ViewModel.StudentDetailView
<div class="card">
    <div class="card-body">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="RegNo" class="lblClass">Registration No:</label>
                    <label class="badge badge-outline-info">@Model.No</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="fullName" class="lblClass">Full Name:</label>
                    <label class="badge badge-outline-info">@Model.Name</label>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="txtTel" class="lblClass">Telephone:</label>
                    <label class="badge badge-outline-info">@Model.Phone_No</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="txtEmail" class="lblClass">Email:</label>
                    <label class="badge badge-outline-info">@Model.E_Mail</label>
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="txtPersEmail" class="lblClass">Personal Email Address</label>
                    <input type="email" class="form-control" id="txtPersEmail" placeholder="Personal Email" autocomplete="off">
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="txtCrrProf" class="lblClass">Current Profession</label>
                    <input type="text" class="form-control" id="txtCrrProf" placeholder="Current Profession" required="" autocomplete="off">
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="txtCrrCompany" class="lblClass">Current Institution/Company</label>
                    <input type="text" class="form-control" id="txtCrrCompany" placeholder="Current Institution/Company" required="" autocomplete="off">
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group">
                    <label for="txtPhoneNo" class="lblClass">Current Phone Number</label>
                    <input type="text" class="form-control" id="txtPhoneNo" placeholder="Current Phone Number" required="" autocomplete="off">
                </div>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label for="txtPersEmail" class="lblClass">Graduating Programme</label>
                    @Html.DropDownListFor(m => m.Enrolled_Prog.Code, new SelectList(Model.Enrolled_Prog.ListOfProgrammes, "Value", "Text", Model.Enrolled_Prog.Code), "--Select Programme--", new { @id = "ddlProg", @class = "form-select" })
                </div>
            </div>
        </div>
        <hr />
        @*<div class="row">
                <div class="col-md-12">
                    <div class="form-group">
                        <label for="txtProg" class="lblClass">Programme</label>
                        <label class="badge badge-info">@Model.Prog (@Model.ProgName)</label>
                    </div>
                </div>
            </div>
            <hr />*@
        <div align="center">
            <input type="button" id="btnSaving" class="btn btn-danger" value="Make Request" onclick="SubmitClearanceRequest(`@Model.No`,`@Model.Prog`);" />
        </div>
        <hr />
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        $("#lblTitle").text("New Clearance Form");
    });
</script>
