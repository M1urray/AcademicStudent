
@{
    ViewBag.Title = "Student Requisitions";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<style>
    .btnClass {
        padding: 2px;
        font-size: 12px;
    }

    .selectedTableRow {
        background: #2a2b2b;
        color: white;
    }
</style>
<div class="modal-content">
    <div class="modal-body pre-scrollable">
        <input type="button" class="btn btn-danger btnClass" value="New Requisition" onclick="NewRequisition();" />
        <hr />
        <div class="responsive-table-plugin">
            <div class="table-rep-plugin">
                <div class="table-responsive" data-pattern="priority-columns">
                    <div id="divRequisitionList"></div>
                </div>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModalUnits" tabindex="-1" role="dialog" aria-labelledby="scrollableModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelT"></label></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Admission Letter////////////////////////////*@
<div class="modal fade" id="myModalReport" tabindex="-1" role="dialog" aria-labelledby="scrollableModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Admission Letter</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
                <iframe id="iframe" style="width:100%;height:600px"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        LoadStudentRequistionList();
    });
    function LoadStudentRequistionList() {
        ShowProgress();
        $.ajax({
            cache: false,
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: '@Url.Action("StudentRequisitionList", "Course")',
            success: function (data) {
                $("#divRequisitionList").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                alert("There is some problem to process your request. Please try after some time");
            }
        });
    }
    var NewRequisition = function () {
        var x = document.getElementById("labelT");
        x.innerHTML = 'New Requisition';
        ShowProgress();
        $.ajax({
            url: '@Url.Action("NewRequistion", "Course")',
            datatype: "json",
            type: "POST",
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalUnits").modal("show");
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var SubmitStudentRequistion = function () {
        var Campus = $("#ddlCampus").children("option:selected").val();
        var Remarks = $("#txtRemarks").val();
        var RegType = $("#ReqType").children("option:selected").val();
        var Prog = $("#ddlProgramme").children("option:selected").val();
        var ProgConcMajor = $("#ddlConcentration").children("option:selected").val();
        var ProgTransit = $("#ddlProgrammeTransit").children("option:selected").val();
        var NoOfCopies = "0";
        var ProgC = "";
        if (RegType == "9") {
            NoOfCopies = $("#txtNoCopies").val();
            ProgC = $("#ddlSTDProg").children("option:selected").val();
        }
        if (RegType == "") {
            Swal.fire('Warning', 'Select Requisition Type', 'warning');
            return false;
        }
        else if (RegType == "1" && Campus == "") {
            Swal.fire('Warning', 'Select Campus to tranfer to', 'warning');
            return false;
        }
        else if ((RegType == "9") && (NoOfCopies == "0" || NoOfCopies == "")) {
            Swal.fire('Warning', 'Enter Number of Copies', 'warning');
            return false;
        }
        else if (RegType == "9" && ProgC == "") {
            Swal.fire('Warning', 'Select Programme', 'warning');
            return false;
        }
        else if ((RegType == "12") && (ProgConcMajor == "")) {
            Swal.fire('Warning', 'Select Programme Minors', 'warning');
            return false;
        }
        else if ((RegType == "13") && (ProgConcMajor == "")) {
            Swal.fire('Warning', 'Select Programme Majors', 'warning');
            return false;
        }
        else if ((RegType == "14") && (ProgConcMajor == "")) {
            Swal.fire('Warning', 'Select Programme Concentration', 'warning');
            return false;
        }
        else if ((RegType == "19") && (ProgTransit == "")) {
            Swal.fire('Warning', 'Select Programme you want to transit to', 'warning');
            return false;
        }
        else if (Remarks == "") {
            Swal.fire('Warning', 'Give Reason for the requisition', 'warning');
            return false;
        }
        else {
            var StudentReqs = {};
            StudentReqs.StdNo = `@Model.StdNo`;
            StudentReqs.Semester = `@Model.CurrentSem`;
            if (RegType == "2") {
                StudentReqs.Prog = ProgConcMajor;
            }
            else if (RegType == "9") {
                StudentReqs.Prog = ProgC;
            }
            else if (RegType == "19") {
                StudentReqs.Prog = ProgTransit;
            }
            else {
                StudentReqs.Prog = `@Model.Prog`;
            }
            if (RegType == "12" || RegType == "13" || RegType == "14") {
                StudentReqs.Concentration = ProgConcMajor;
            }
            StudentReqs.Campus = Campus;
            StudentReqs.NoOfCopies = NoOfCopies;
            StudentReqs.Requisition_Type = RegType;
            StudentReqs.Remarks = Remarks.replace(/(\r\n|\n|\r)/gm, " ");
            if (RegType == "2") {
                var filename1; var base64String1; var filetype1;
                var files1 = document.getElementById('CertfileAttachment').files;
                if (files1.length) {
                    var file1 = files1[0];
                    var blob1 = file1.slice();
                    filetype1 = file1.type;
                    filename1 = file1.name;
                    var reader1 = new FileReader();
                    reader1.onloadend = function (evt) {
                        if (evt.target.readyState == FileReader.DONE) { // DONE == 2
                            var cont1 = evt.target.result
                            base64String1 = getB64Str(cont1);
                        };
                        ShowProgress();
                        $.ajax({
                            url: '@Url.Action("SubmitStudentProgrammeChangeRequest", "Course")',
                            datatype: "json",
                            type: "POST",
                            data: JSON.stringify({ regData: StudentReqs, base64Upload: base64String1, fileName: filename1, Extn: filetype1 }),
                            contentType: "application/json; charset = utf-8",
                            success: function (data) {
                                if (data.success == true) {
                                    HideProgress();
                                    LoadStudentRequistionList();
                                    $("#myModalUnits").modal("hide");
                                    Swal.fire('Success', data.message, 'success');
                                }
                                else {
                                    HideProgress();
                                    Swal.fire('Warning', data.message, 'warning');
                                }
                            },
                            error: function (erro) {
                                HideProgress();
                                Swal.fire('Error', erro.message, 'error');
                            }
                        });
                    };
                    reader1.readAsArrayBuffer(blob1);
                }
                else {
                    Swal.fire('Warning', 'Attach high school Certificate', 'warning');
                    return;
                }
            }
            else if (RegType == "8" || RegType == "11" || RegType == "20") {
                var StudentReqLines = new Array();
                $("#tbRegUnits tbody tr").each(function () {
                    var row = $(this);
                    if (row.find('input[type="checkbox"]').is(':checked')) {
                        var RegLine = {};
                        RegLine.Unit = row.find("td").eq(1).html();
                        RegLine.UnitName = row.find("td").eq(2).html();
                        StudentReqLines.push(RegLine);
                    }
                });
                if (StudentReqLines.length < 1) {
                    Swal.fire('Warning', 'You have not selected any unit', 'warning');
                    return;
                }
                ShowProgress();
                $.ajax({
                    url: '@Url.Action("SaveStudentRequisitionWithLines", "Course")',
                    datatype: "json",
                    type: "POST",
                    data: JSON.stringify({ regData: StudentReqs, StdRegLines: StudentReqLines }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        if (data.success == true) {
                            HideProgress();
                            LoadStudentRequistionList();
                            $("#myModalUnits").modal("hide");
                            Swal.fire('Success', data.message, 'success');
                        }
                        else {
                            HideProgress();
                            Swal.fire('Error', data.message, 'error');
                        }
                    },
                    error: function () {
                        if (data.success == false) {
                            HideProgress();
                            Swal.fire('Error', data.message, 'error');
                        }
                    }
                });
            }
            else if (RegType == "17") {
                var filename; var base64String; var filetype;
                var files = document.getElementById('ExmptfileAttachment').files;
                if (files.length) {
                    var file = files[0];
                    var blob = file.slice();
                    filetype = file.type;
                    filename = file.name;
                    var reader = new FileReader();
                    reader.onloadend = function (evt) {
                        if (evt.target.readyState == FileReader.DONE) { // DONE == 2
                            var cont = evt.target.result
                            base64String = getB64Str(cont);
                        };
                        var StudentReqLines = new Array();
                         $("#tblExemption tbody tr").each(function () {
                                var row = $(this);
                                var RegLine = {};
                                RegLine.Unit = row.find("td").eq(0).html();
                                RegLine.UnitName = row.find("td").eq(1).html();
                                RegLine.EquivalentUnit = row.find("td").eq(2).html();
                                StudentReqLines.push(RegLine);
                            });
                        if (StudentReqLines.length < 1) {
                            Swal.fire('Warning', 'You have not added any unit', 'warning');
                            return;
                        }
                        ShowProgress();
                        $.ajax({
                            url: '@Url.Action("SubmitStudentExemptionRequest", "Course")',
                            datatype: "json",
                            type: "POST",
                            data: JSON.stringify({ regData: StudentReqs, StdRegLines: StudentReqLines, base64Upload: base64String, fileName: filename, Extn: filetype }),
                            contentType: "application/json; charset = utf-8",
                            success: function (data) {
                                if (data.success == true) {
                                    HideProgress();
                                    LoadStudentRequistionList();
                                    $("#myModalUnits").modal("hide");
                                    Swal.fire('Success', data.message, 'success');
                                }
                                else {
                                    HideProgress();
                                    Swal.fire('Warning', data.message, 'warning');
                                }
                            },
                            error: function (erro) {
                                HideProgress();
                                Swal.fire('Error', erro.message, 'error');
                            }
                        });
                    };
                    reader.readAsArrayBuffer(blob);
                }
                else {
                    Swal.fire('Warning', 'Attach results slip', 'warning');
                    return;
                }
            }
            else if (RegType == "18") {
                var filename; var base64String; var filetype;
                var files = document.getElementById('ExmptfileAttachment').files;
                if (files.length) {
                    var file = files[0];
                    var blob = file.slice();
                    filetype = file.type;
                    filename = file.name;
                    var reader = new FileReader();
                    reader.onloadend = function (evt) {
                        if (evt.target.readyState == FileReader.DONE) { // DONE == 2
                            var cont = evt.target.result
                            base64String = getB64Str(cont);
                        };
                        var StudentReqLines = new Array();
                        $("#tblExemption tbody tr").each(function () {
                            var row = $(this);
                            var RegLine = {};
                            RegLine.Unit = row.find("td").eq(0).html();
                            RegLine.UnitName = row.find("td").eq(1).html();
                            RegLine.EquivalentUnit = row.find("td").eq(2).html();
                            StudentReqLines.push(RegLine);
                        });
                        if (StudentReqLines.length < 1) {
                            Swal.fire('Warning', 'You have not added any unit', 'warning');
                            return;
                        }
                        ShowProgress();
                        $.ajax({
                            url: '@Url.Action("SubmitStudentExamChallengeRequest", "Course")',
                            datatype: "json",
                            type: "POST",
                            data: JSON.stringify({ regData: StudentReqs, StdRegLines: StudentReqLines, base64Upload: base64String, fileName: filename, Extn: filetype }),
                            contentType: "application/json; charset = utf-8",
                            success: function (data) {
                                if (data.success == true) {
                                    HideProgress();
                                    LoadStudentRequistionList();
                                    $("#myModalUnits").modal("hide");
                                    Swal.fire('Success', data.message, 'success');
                                }
                                else {
                                    HideProgress();
                                    Swal.fire('Warning', data.message, 'warning');
                                }
                            },
                            error: function (erro) {
                                HideProgress();
                                Swal.fire('Error', erro.message, 'error');
                            }
                        });
                    };
                    reader.readAsArrayBuffer(blob);
                }
                else {
                    Swal.fire('Warning', 'Attach results slip', 'warning');
                    return;
                }
            }
            else {
                ShowProgress();
                $.ajax({
                    url: '@Url.Action("SaveStudentRequisition", "Course")',
                    datatype: "json",
                    type: "POST",
                    data: JSON.stringify({ regData: StudentReqs }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        if (data.success == true) {
                            HideProgress();
                            LoadStudentRequistionList();
                            $("#myModalUnits").modal("hide");
                            Swal.fire('Success', data.message, 'success');
                        }
                        else {
                            HideProgress();
                            Swal.fire('Success', data.message, 'success');
                        }
                    },
                    error: function () {
                        if (data.success == false) {
                            HideProgress();
                            Swal.fire('Error', data.message, 'error');
                        }
                    }
                });
            }
        }
    }
    var ViewLines = function (DocNo,Status,RegT) {
        var x = document.getElementById("labelT");
        x.innerHTML = 'Requisition Lines';
        ShowProgress();
        $.ajax({
            url: '@Url.Action("GetRequistionLines", "Course")',
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo, Status: Status, RegT: RegT }),
            type: "POST",
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalUnits").modal("show");
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    };
    function getB64Str(buffer) {
        var binary = '';
        var bytes = new Uint8Array(buffer);
        var len = bytes.byteLength;
        for (var i = 0; i < len; i++) {
            binary += String.fromCharCode(bytes[i]);
        }
        return window.btoa(binary);
    }
    var ViewApprovalTrail = function (DocNo) {
        $("#labelT").text("Document Approval Trail");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("DocumentApprovalTrail", "Course")',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModalUnits").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var ViewComments = function (DocNo) {
        $("#labelT").text("Document Comments");
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ DocNo: DocNo }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("DocumentComments", "Common")',
            success: function (data) {
                $("#modalBody").html(data);
                HideProgress();
                $("#myModalUnits").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var GetAdmissionLetters = function (DocNo) {
        ShowProgress();
        $.ajax({
            url: '@Url.Action("AdmissionLetter", "ViewDocuments")',
            data: JSON.stringify({ AppNo: DocNo }),
            datatype: "json",
            type: "POST",
            contentType: "application/json; charset = utf-8",
            type: "POST",
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', data.message);
                    $("#myModalReport").modal("show");
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }

            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    };
</script>

