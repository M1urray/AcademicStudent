@model New_Student_Portal.ViewModel.UnitSubject
@{
    string ClassCodeNeeded = "";
    int i = 1;
}
<style>
    .checkboxClass {
        width: 20px;
        height: 20px;
        padding: 0px;
    }

    td, th {
        white-space: normal;
    }

    .hide {
        display: none;
    }

    .pre-scrollable {
        max-height: 300px;
        border: 2px solid black;
    }
</style>
<div class="responsive-table-plugin">
    <div class="table-rep-plugin">
        <div class="table-responsive" data-pattern="priority-columns">
            <table id="tblProgUnit" class="table table-striped table-hover" style="font-size:11px">
                <thead>
                    <tr>
                        <th width="10%" style="text-align:right">Select</th>
                        <th width="30%">
                            Course
                        </th>
                        <th width="60%">
                            Desription
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model.ListOfCoreUnitsSubjects != null && Model.ListOfCoreUnitsSubjects.Count() > 0)
                        {
                            foreach (var item in Model.ListOfCoreUnitsSubjects)
                            {
                                <tr>
                                    <td align="center">
                                        <input type="checkbox" class="checkboxClass" id="@i" value="@item.CF" />
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Code)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Desription)
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="3">
                                    No Records Found
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<hr />
<div align="center">
    <hr />
    <input type="button" id="btnSaving" class="btn btn-danger" value="Add Selected Units to Basket" onclick="SubmitSelectedUnits(`@Model.RegT`,`@Model.Stage`);" />
</div>
