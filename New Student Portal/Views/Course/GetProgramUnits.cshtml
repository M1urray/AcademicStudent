@model New_Student_Portal.ViewModel.UnitSubject
@{
    string ClassCodeNeeded = "";
    int i = 1;
}
<style>
    .checkboxClass {
        width: 20px;
        height: 20px;
        padding: 0px;
    }

    td, th {
        white-space: normal;
    }

    .hide {
        display: none;
    }

    .pre-scrollable {
        max-height: 300px;
        border: 2px solid black;
    }
</style>
<div class="responsive-table-plugin">
    <div class="table-rep-plugin">
        <div class="table-responsive" data-pattern="priority-columns">
            <table id="tblProgUnit" class="table table-striped table-hover" style="font-size:11px">
                <thead>
                    <tr>
                        <th class="hide "width="10%" style="text-align:right">Select</th>
                        <th width="15%">
                            Course
                        </th>
                        <th width="15%" style="text-align:center">
                            Section
                        </th>
                        <th width="30%">
                            Description
                        </th>
                        <th width="15%">
                            Day
                        </th>
                        <th width="15%">
                            Period
                        </th>
                        <th width="15%">
                            Campus
                        </th>
                        <th width="15%">
                            Lecturer
                        </th>
                        <th class="hide">
                        </th>
                        <th class="hide">
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model.ListOfCoreUnitsSubjects != null && Model.ListOfCoreUnitsSubjects.Count() > 0)
                        {
                            foreach (var item in Model.ListOfCoreUnitsSubjects)
                            {
                                <tr>
                                    <td align="center" class="hide">
                                        <input type="" class="checkboxClass" id="@i" value="@item.CF" />
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Code)
                                    </td>
                                    <td align="center">
                                        @Html.DisplayFor(modelItem => item.Class)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Desription)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Day)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Period)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Campus)
                                    </td>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.Lec)
                                    </td>
                                    <td class="hide">
                                        @Html.DisplayFor(modelItem => item.HasPrelqUnit)
                                    </td>
                                    <td class="hide">
                                        @Html.DisplayFor(modelItem => item.ClassFull)
                                    </td>
                                </tr>
                                i++;
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8">
                                    No Records Found
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<hr />
<div align="center">
    <hr />
    <input type="button" id="btnSaving" class="btn btn-danger" value="Add Units to Basket" onclick="SubmitSelectedUnits('@ClassCodeNeeded');" />
</div>
