@model New_Student_Portal.ViewModel.LecturerEvaluationUnits
<style>
    thead {
        background-color: black;
        color: white;
    }

    tfoot {
        background-color: #051936;
        color: #cbcc32;
    }

    b, strong {
        font-size: 12px;
        text-decoration: underline;
    }

    .spanClass {
        font-size: 16px;
        font-weight: bold;
    }

    .btnPadding {
        padding: 5px;
        font-size: 10px;
    }
</style>
<div class="pre-scrollable">
    <table class="table table-bordered table-hover">
        <thead>
            <tr>
                <th>Action</th>
                <th>
                    Unit Code
                </th>
                <th>
                    Unit Description
                </th>
            </tr>
        </thead>
        <tbody>
            @{
                if (Model.ListOfRegisteredUnits != null)
                {
                    if (Model.ListOfRegisteredUnits.Count() > 0)
                    {
                        foreach (var item in Model.ListOfRegisteredUnits)
                        {
                            <tr>
                                <td>
                                    <button id="btnEval" class="btn btn-danger btnPadding" onclick="SelectedRowUnit('@item.Unit', '@item.Section');">Evaluate</button>
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Unit)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Unit_Name)
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" style="color:red">
                                No Registered Units for evaluation Found
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
</div>
