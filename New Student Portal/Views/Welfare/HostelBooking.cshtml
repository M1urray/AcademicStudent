@{
    ViewBag.Title = "Hostel Booking";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<style>
    b {
        font-size: 14px;
    }
</style>
<div class="modal-content">
    <div class="modal-body pre-scrollable">
        <div id="divHostelBooking"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModalUnits" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelT"></label></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
                <iframe id="iframe" style="width:100%;height:450px"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        LoadHostelDetails();
    });
    function LoadHostelDetails() {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: "/Welfare/HostelAccommondation",
            success: function (data) {
                $("#divHostelBooking").html(data);
                $('#ddlRoom').empty().append('<option selected="selected" value="0">--Select Room--</option>');
                $('#ddlSpace').empty().append('<option selected="selected" value="0">--Select Space--</option>');
                HideProgress();
            },
            error: function () {
                HideProgress();
                Swal.fire('Error', 'There is some problem to process your request. Please try after some time', 'error');
            }
        });
    }
    var SubmitBookedSpace = function () {
        Swal.fire({
            title: 'Are you sure?',
            text: "You want to book this space",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Book it!',
            cancelButtonText: 'No, cancel!',
            confirmButtonClass: 'btn btn-success mt-2',
            cancelButtonClass: 'btn btn-danger ms-2 mt-2',
            buttonsStyling: false
        }).then(function (result) {
            if (result.value) {
                var Hostels = $("#ddlHostel").children("option:selected").val();
                var Rooms = $("#ddlRoom").children("option:selected").val();
                var Spaces = $("#ddlSpace").children("option:selected").val();
                var RoomCost = $('#lblCost').text();
                if (Hostels == "") {
                    Swal.fire('Error', 'Select Hostel', 'error');
                    return;
                }
                else if (Rooms == "") {
                    Swal.fire('Error', 'Select Room', 'error');
                    return;
                }
                else if (Spaces == "") {
                    Swal.fire('Error', 'Select Space', 'error');
                    return;
                }
                else if (RoomCost < 1) {
                    Swal.fire('Error', 'Room Cost cannot be 0(zero)', 'error');
                    return;
                }
                else {
                    var BookedSpaceDetails = {};
                    BookedSpaceDetails.Hostel = Hostels;
                    BookedSpaceDetails.Room = Rooms;
                    BookedSpaceDetails.Space = Spaces;
                    BookedSpaceDetails.Cost = RoomCost;

                    ShowProgress();
                    $.ajax({
                        type: "POST",
                        url: "/Welfare/SaveSelectedSpace",
                        data: JSON.stringify(BookedSpaceDetails),
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",
                        success: function (data) {
                            if (data.success == true) {
                                HideProgress();
                                LoadHostelDetails();
                                Swal.fire('Success', data.message, 'success');
                            }
                        },
                        error: function () {
                            if (data.success == false) {
                                HideProgress();
                                Swal.fire('Error', data.message, 'error');
                            }
                        }
                    });
                }
            } else if (result.dismiss === Swal.DismissReason.cancel) {
                Swal.fire({
                    title: 'Cancelled',
                    text: 'You space booking has been cancelled',
                    icon: 'error',
                    confirmButtonColor: "#1abc9c",
                });
            }
        });
    }
    var PrintHostelInvoice = function () {
        $("#labelT").text("Hostel Invoice Printout");
        ShowProgress();
        $.ajaxSetup({
            cache: false
        });
        $.ajax({
            url: '/Welfare/PrintHostelInvoice',
            type: "POST",
            datatype: "json",
            cache: false,
            async: false,
            contentType: "application/json; charset = utf-8",
            processData: false,
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', data.message);
                    $("#myModalUnits").modal("show");
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                }
                HideProgress();
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var PrintHostelClearanceForm = function () {
        $("#labelT").text("Hostel Clearance Form");
        ShowProgress();
        $.ajaxSetup({
            cache: false
        });
        $.ajax({
            url: '/Welfare/PrintHostelClearanceForm',
            type: "POST",
            datatype: "json",
            cache: false,
            contentType: "application/json; charset = utf-8",
            processData: false,
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', data.message);
                    $("#myModalUnits").modal("show");
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                }
                HideProgress();
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>


