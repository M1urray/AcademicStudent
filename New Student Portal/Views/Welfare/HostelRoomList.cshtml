@{
    ViewBag.Title = "Hostel Room List";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }
</style>
<div style="background-color: black;">
    <a href="#" onclick="HostelBookingLink();" style="color:yellow"><<< Back To Hostel List</a>
</div>
<div class="card">
    <hr />
    <div class="modal-header" style="padding-top: 3px; padding-bottom: 3px">
        <h4 class="modal-title"><span class="spanClass">Hostel Block Rooms(<label id="lblHostel"></label>)</span></h4>
    </div>
    <div class="card-body">
        <div id="divRoomList"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModalRoomSpace" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Room Spaces</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        var Hostel = GetParameterValues('HostelCode');
        var HostelName = GetParameterValues('HostelName');
        function GetParameterValues(name) {
            name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
            var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
            var results = regex.exec(location.search);
            return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
        }
        $("#lblHostel").text(HostelName);
        LoadRoomsList(Hostel);
    });
    function LoadRoomsList(Hostel) {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            datatype: "json",
            data: JSON.stringify({ HostelCode: Hostel }),
            contentType: "application/json; charset = utf-8",
            processData: false,
            url: '@Url.Action("HostelBlockRooms", "Welfare")',
            success: function (data) {
                $("#divRoomList").html(data);
                HideProgress();
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var HostelBookingLink = function () {
        ShowProgress();
        window.location = '@Url.Action("HostelList", "Welfare")';
    }
    var LoadRoomSpaces = function (HostelCode, RoomCode, cost) {
        ShowProgress();
        $.ajax({
            url: '@Url.Action("RoomSpacesList", "Welfare")',
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ HostelCode: HostelCode, RoomCode: RoomCode, Cost: cost }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalRoomSpace").modal("show");
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var BookSpace = function (HostelCode, RoomCode, SpaceCode, cost) {
        Swal.fire({
            title: 'Are you sure?',
            text: "You want to book this space",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Yes, Book it!',
            cancelButtonText: 'No, cancel!',
            confirmButtonClass: 'btn btn-success mt-2',
            cancelButtonClass: 'btn btn-danger ms-2 mt-2',
            buttonsStyling: false
        }).then(function (result) {
            if (result.value) {
                ShowProgress();
                var RoomSpaces = {};
                RoomSpaces.HostelCode = HostelCode;
                RoomSpaces.RoomCode = RoomCode;
                RoomSpaces.SpaceCode = SpaceCode;
                RoomSpaces.Cost = cost;
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("SaveSelectedSpace", "Welfare")',
                    data: JSON.stringify({ spaceDetails: RoomSpaces }),
                    contentType: "application/json; charset=utf-8",
                    dataType: "json",
                    success: function (data) {
                        if (data.success == true) {
                            HideProgress();
                            HostelBookingLink();
                            Swal.fire('Success', data.message, 'success');
                        }
                        else {
                            HideProgress();
                            Swal.fire('Error', data.message, 'error');
                        }
                    },
                    error: function (err) {
                        HideProgress();
                        Swal.fire('Error', err, 'error');
                    }
                });
            } else if (result.dismiss === Swal.DismissReason.cancel) {
                Swal.fire({
                    title: 'Cancelled',
                    text: 'You space booking has been cancelled',
                    icon: 'error',
                    confirmButtonColor: "#1abc9c",
                });
            }
        });
    }
</script>

