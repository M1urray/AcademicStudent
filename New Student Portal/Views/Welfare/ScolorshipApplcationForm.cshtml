
@{
    ViewBag.Title = "Scolorship Applcation Form";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<style>
    .BtnPadding {
        padding: 1px;
        font-size: 12px;
    }
    /*input[type=radio] {
