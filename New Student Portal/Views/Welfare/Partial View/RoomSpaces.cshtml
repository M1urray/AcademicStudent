@model IEnumerable<New_Student_Portal.ViewModel.RoomSpaces>
<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th width="10%">
                Space
            </th>
            <th width="10%">
                Space Cost
            </th>
            <th width="10%">
                Status
            </th>
            <th width="10%">
                Action
            </th>
        </tr>
    </thead>
    <tbody>
        @{
            if (Model != null)
            {
                if (Model.Count() > 0)
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.SpaceCode)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Cost)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status)
                            </td>
                            <td>
                                <a href="#" onclick="BookSpace('@item.HostelCode','@item.RoomCode','@item.SpaceCode','@item.Cost')" class="btn btn-sm btn-danger">Book Space</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" style="color:red">
                            No Rooms Found
                        </td>
                    </tr>
                }
            }
        }
    </tbody>
</table>
