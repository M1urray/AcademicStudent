@model New_Student_Portal.ViewModel.MealBooking
<div class="row">
    @if (Model.BookedMeals == true)
    {
        <div class="col-md-12">
            @Model.Message
        </div>
    }
    else
    {
        <div class="col-md-12">
            @Model.Message
        </div>
        <div class="col-md-12">
            <hr />
            <input type="button" id="btnMeal" class="btn btn-danger" value="Book Meals" onclick="SubmitMealBooking();" />
        </div>
    }
</div>
