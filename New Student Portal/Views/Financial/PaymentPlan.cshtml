@{
    ViewBag.Title = "Payment Plan";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }
</style>
<div class="card">
    <div class="card-body">
        <div class="row">
            <div id="divPaymentPlan"></div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        LoadForm();
        var Successmsg = '@Request.RequestContext.HttpContext.Session["SuccessMsg"]';
        if (Successmsg != "") {
            Swal.fire('Success', Successmsg, 'success', true);
            $.ajax({
                type: "POST",
                url: '@Url.Action("NullibySessions", "Common")'
            });
        }
    });
    var LoadForm = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: '@Url.Action("GetPaymentPlan", "Financial")',
            success: function (data) {
                $("#divPaymentPlan").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                Swal.fire("Warning", "There is some problem to process your request. Please try after some time", "warning");
            }
        });
    };
    var SubmitPaymentPlan = function () {
        ShowProgress();
        var count = $('#IstallmentLines > tbody > tr').length;
        if (count < 1) {
            Swal.fire("Warning", "You have not entered any installment data", "warning");
            HideProgress();
            return;
        }

        var lastRow = $('#IstallmentLines > tbody > tr:last').find("TD").eq(2);

        var lastcellData = lastRow.find("input[type=text]").val();

        if (lastcellData == "") {
            Swal.fire("Warning", "You have not entered the last installment percentage which should be 100%", "warning");
            HideProgress();
            return;
        }
        else if (parseInt(lastcellData) != 100) {
            Swal.fire("Warning", "Your last installment percentage should be 100%", "warning");
            HideProgress();
            return;
        }
        else {
            var myTableArray = [];
            $('#IstallmentLines tbody tr').each(function () {
                var arrayOfThisRow = [];
                var tableData = $(this).find('td');
                if (tableData.length > 0) {
                    tableData.each(function () {
                        if ($(this).find("input[type=text]").length) {
                            var myText = $(this).find("input[type=text]").val();
                            arrayOfThisRow.push(myText);
                        }
                        else arrayOfThisRow.push($(this).text());
                    });

                    myTableArray.push(arrayOfThisRow);
                }
            });
            if (myTableArray.length < 1) {
                Swal.fire('Warning', 'You have not Added any installment line(s)', 'warning');
                HideProgress();
                return;
            }
            else {
                //Send the JSON array to Controller using AJAX.
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("SavePaymentPlan", "Financial")',
                    data: { pPlan: myTableArray },
                    contenttype: "text/plain; charset=utf-8",
                    success: function (data) {
                        if (data.success) {
                            HideProgress();
                            LoadForm();
                            Swal.fire('Success', data.message, 'success');
                        }
                        else {
                            Swal.fire('Warning', data.message, 'warning');
                            HideProgress();
                        }
                    },
                    error: function (err) {
                        HideProgress();
                        console.log(err);
                        Swal.fire('Warning', err, 'warning');
                    }
                });
            }
        }
    };
    function functionx(evt) {
        if (evt.charCode > 31 && (evt.charCode < 48 || evt.charCode > 57)) {
            Swal.fire("Error", "Please enter only numeric characters in the text box", "error");
            return false;
        }
    }
</script>

