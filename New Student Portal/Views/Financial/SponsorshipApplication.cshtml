
@{
    ViewBag.Title = "SponsorshipApplication";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }
</style>
<div class="modal-content">
    <div class="modal-header" style="padding-top: 3px; padding-bottom: 3px">
        <h4 class="modal-title"><span class="spanClass">Sponsorship Application</span></h4>
    </div>
    <div class="modal-body">
        <div id="divSponsorhsipApp"></div>
    </div>
</div>
<script src="~/JS/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        LoadForm();
    });
    var LoadForm = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: '@Url.Action("GetSponsorshipApplications", "Financial")',
            success: function (data) {
                $("#divSponsorhsipApp").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                alert("There is some problem to process your request. Please try after some time");
            }
        });
    };
</script>

