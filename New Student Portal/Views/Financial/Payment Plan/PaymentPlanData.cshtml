@model IEnumerable<New_Student_Portal.ViewModel.PaymentPlan>
<div class="responsive-table-plugin">
    <div class="table-rep-plugin">
        <div class="table-responsive" data-pattern="priority-columns">
            <table id="tech-companies-1" class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Installment</th>
                        <th class="text-center">By Date</th>
                        <th class="text-center">Upto Percentage(%)</th>
                        <th class="text-center">Amount Due</th>
                    </tr>
                </thead>
                <tbody>
                <tbody>
                    @{
                        if (Model != null && Model.Count() > 0)
                        {
                            decimal Totals = 0;
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        @Html.DisplayFor(modelItem => item.InstallNo)
                                    </td>
                                    <td>
                                        @Html.TextBoxFor(modelItem => item.ByDate, new { @readonly = "true", Style = "text-align:center", @class = "form-control" })
                                    </td>
                                    <td>
                                        @Html.TextBoxFor(modelItem => item.Percentage, new { @readonly = "true", Style = "text-align:center", @class = "form-control" })
                                    </td>
                                    <td>
                                        @Html.TextBoxFor(modelItem => item.AmountDue, new { @readonly = "true", Style = "text-align:center", @class = "form-control" })
                                    </td>
                                </tr>
                                Totals = Totals + Convert.ToDecimal(item.AmountDue);
                            }
                            <tr>
                                <td colspan="2"></td>
                                <td align="right">Totals : </td>
                                <td>@Convert.ToDecimal(Totals).ToString("#,##0.00")</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" style="color:red">
                                    No Records Found
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

