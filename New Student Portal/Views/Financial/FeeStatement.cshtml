@model IEnumerable<New_Student_Portal.ViewModel.FeeStatementDetails>
@{
    ViewBag.Title = "Fee Statement";
    Layout = "~/Views/Shared/Sitemaster.cshtml";
}
<style>
    thead {
        background-color: black;
        color: white;
    }

    tfoot {
        background-color: #051936;
        color: #cbcc32;
    }
</style>
<div class="card">
    <div class="card-body">
        <input type="button" value="Print Fee Statement" class="btn btn-danger" onclick="PrintFeeStatement();" />
        @{
            decimal TotalDebit = 0, TotalCredit = 0, Balance = 0, RunningBal = 0;
        }
        <div class="responsive-table-plugin">
            <div class="table-rep-plugin">
                <div class="table-responsive" data-pattern="priority-columns">
                    <table id="tech-companies-1" class="table table-striped table-hover" style="font-size:12px">
                        <thead>
                            <tr>
                                <th width="10%">
                                    Posting Date
                                </th>
                                <th width="10%">
                                    Ref #
                                </th>
                                <th width="40%">
                                    Description
                                </th>
                                <th width="20%" style="text-align:right">
                                    Debit Amount
                                </th>
                                <th width="20%" style="text-align:right">
                                    Credit Amount
                                </th>
                                <th width="20%" style="text-align:right">
                                    Running Balance
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                if (Model != null)
                                {
                                    if (Model.Count() > 0)
                                    {
                                        foreach (var item in Model)
                                        {
                                            RunningBal = RunningBal + Convert.ToDecimal(item.RunnningBal);
                                            <tr>
                                                <td>
                                                    @Convert.ToDateTime(item.Posting_Date).ToString("dd/MM/yyyy")
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Document_No)
                                                </td>
                                                <td>
                                                    @Html.DisplayFor(modelItem => item.Description)
                                                </td>
                                                <td align="right">
                                                    @Convert.ToDecimal(item.Debit_Amount).ToString("#,##0.00")
                                                </td>
                                                <td align="right">
                                                    @Convert.ToDecimal(item.Credit_Amount).ToString("#,##0.00")
                                                </td>
                                                <td align="right">
                                                    @RunningBal.ToString("#,##0.00")
                                                </td>
                                            </tr>
                                            TotalDebit = TotalDebit + Convert.ToDecimal(item.Debit_Amount);
                                            TotalCredit = TotalCredit + Convert.ToDecimal(item.Credit_Amount);
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="6" style="color:red">
                                                No Records Found
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                        @{
                            Balance = TotalDebit - TotalCredit;
                        }
                        <tfoot>
                            <tr>
                                <td colspan="3" align="right">
                                    Balance : @Balance.ToString("#,##0.00")
                                </td>
                                <td align="right">
                                    @TotalDebit.ToString("#,##0.00")
                                </td>
                                <td align="right">
                                    @TotalCredit.ToString("#,##0.00")
                                </td>
                                <td align="right">
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div id="myModalUnits" class="modal fade" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Fee Statement</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
                <iframe id="iframe" style="width:100%;height:450px"></iframe>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    var PrintFeeStatement = function () {
        ShowProgress();
        $.ajax({
            url: '/ViewDocuments/FeeStatement',
            type: "POST",
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', data.message);
                    $("#myModalUnits").modal("show");
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }

            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>
