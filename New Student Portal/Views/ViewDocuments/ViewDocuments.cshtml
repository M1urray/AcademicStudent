
@{
    ViewBag.Title = "View Documents";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<div class="card">
    <div class="card-body">
        <div class="row" id="divProg">
            <div class="col-md-6">
                <b>Programme</b>
                <select class="form-select" id="ddlProgramme" name="ddlProgramme">
                </select>
            </div>
            <div class="col-md-6">
                <br />
                <input type="button" id="btnGetReport" class="btn btn-danger" value="Get Report" onclick="GetReport();" />
            </div>
            <hr />
        </div>
        <div class="row" id="divSem">
            <div class="col-md-6">
                <div class="form-group">
                    @Html.Label("Semester :", htmlAttributes: new { @class = "control-label col-md-12" })
                    <div class="col-md-12">
                        <select class="form-control" id="ddlSemester" name="ddlSemester">
                        </select>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <br />
                <input type="button" id="btnGetExamCard" class="btn btn-danger" value="Get Report" onclick="GetReport();" />
            </div>
        </div>
        
        <div class="row" id="divReport">
            <div class="col-md-12">
                <iframe id="iframe" style="width:100%;height:600px"></iframe>
            </div>
        </div>
    </div>
</div>
<script src="~/JS/ShowProgression.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        var DocType = GetParameterValues('DocT');
        function GetParameterValues(name) {
            name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
            var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
            var results = regex.exec(location.search);
            return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
        }
        LoadDocument(DocType);
    });
    function LoadDocument(DocType) {
        if (DocType == "EXAMCARD") {
            $("#divProg").hide();
            $("#divSem").show();
            $("#divReport").hide();
            GetSemesters();
        }
        if (DocType == "RESULTS") {
            $("#divProg").hide();
            $("#divSem").hide();
            $("#divReport").show();
            PrintProvissionalResults();
        }
        //if (DocType == "RESULTS" || DocType == "STDAUDIT") {
        //    $("#divProg").show();
        //    $("#divReport").hide();
        //    ShowProgress();.
        //    $("#ddlProgramme option").remove();
        //    $('#ddlProgramme').empty().append('<option selected="selected" value="">--Select Programme--</option>');

        //    $.getJSON("/ViewDocuments/GetEnrolledProgrammes",
        //        function (data) {
        //            $('#ddlProgramme').empty().append('<option selected="selected" value="">--Select Programme--</option>');
        //            $.each(data.ListOfValues, function () {
        //                $("#ddlProgramme").append($("<option></option>").val(this['Value']).html(this['Text']));
        //            });
        //            HideProgress();
        //        });
        //};
        if (DocType == "SEMPROFINV") {
            $("#divProg").hide();
            $("#divReport").show();
            GetSemesterInvoice();
        }
    }
    var GetSemesterInvoice = function () {
        ShowProgress();
        $.ajax({
            url: '/ViewDocuments/SemesterProformaInvoice',
            type: "POST",
            async: false,
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', data.message);
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }

            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var GetSemesters = function () {
            ShowProgress();
            $("#ddlSemester option").remove();
            $('#ddlSemester').empty().append('<option selected="selected" value="">--Select Semester--</option>');

            $.get('@Url.Action("GetSemesters", "ViewDocuments")',{},
                function (data) {
                    $('#ddlSemester').empty().append('<option selected="selected" value="0">--Select Semester--</option>');
                    $.each(data.ListOfSemesters, function () {
                        $("#ddlSemester").append($("<option></option>").val(this['Value']).html(this['Text']));
                    });
                    HideProgress();
                });
    }
    var PrintExamCard = function (semester) {
        ShowProgress();
        $.ajax({
            url: '/ViewDocuments/ExamCard',
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify({ Semester: semester }),
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', "data:application/pdf;base64," + data.message);
                    $("#divReport").show();
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var GetReport = function () {
        var prog = $("#ddlProgramme").children("option:selected").val();
        var semester = $("#ddlSemester").children("option:selected").val();

        if (prog == "") {
            Swal.fire('Warning', "Select programme", 'warning');
            return;
        }
        else {
            var DocType = GetParameterValues('DocT');
            function GetParameterValues(name) {
                name = name.replace(/[\[]/, '\\[').replace(/[\]]/, '\\]');
                var regex = new RegExp('[\\?&]' + name + '=([^&#]*)');
                var results = regex.exec(location.search);
                return results === null ? '' : decodeURIComponent(results[1].replace(/\+/g, ' '));
            }
            if (DocType == "EXAMCARD") {
                PrintExamCard(semester);
            }
            if (DocType == "RESULTS") {
                PrintProvissionalResults(prog);
            }
            if (DocType == "STDAUDIT") {
                GetStudentAudit(prog);
            }
        }
    };
    var PrintProvissionalResults = function () {
        ShowProgress();
        $.ajax({
            url: '/ViewDocuments/ProvisionalResults',
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', data.message + "#toolbar=0");
                    $("#divReport").show();
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
    var GetStudentAudit = function (Prog) {
        ShowProgress();
        $.ajax({
            url: '/ViewDocuments/GenerateStudentAudit',
            type: "POST",
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            data: JSON.stringify({ Prog: Prog }),
            success: function (data) {
                if (data.success == true) {
                    $('iframe').attr('src', data.message);
                    $("#divReport").show();
                    HideProgress();
                }
                else {
                    Swal.fire('Warning', data.message, 'warning');
                    HideProgress();
                }
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Warning', err, 'warning');
            }
        });
    }
</script>