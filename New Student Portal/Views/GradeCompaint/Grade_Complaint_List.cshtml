
@{
    ViewBag.Title = "Grade Complaint List";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<style>
    .btnClass {
        padding: 2px;
        font-size: 12px;
    }

    .selectedTableRow {
        background: #2a2b2b;
        color: white;
    }
</style>
<div class="card">
    <div class="card-body">
        <input type="button" class="btn btn-danger btnClass" value="New Requisition" onclick="NewRequisition();" />
        <hr />
        <div id="divCompList"></div>
    </div>
</div>
@*//////////////////////Modal////////////////////////////*@
<div class="modal fade" id="myModalUnits" tabindex="-1" role="dialog" aria-labelledby="scrollableModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelT"></label></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        LoadGradeComplaintList();
    });
    function LoadGradeComplaintList() {
        ShowProgress();
        $.ajax({
            async: false,
            type: "GET",
            dataType: 'HTML',
            contentType: false,
            processData: false,
            url: "/GradeCompaint/Grade_Complaint_List_Views",
            success: function (data) {
                $("#divCompList").html(data);
                HideProgress();
            },
            error: function () {
                HideProgress();
                Swal.fire('Error', "There is some problem to process your request. Please try after some time", 'error');
            }
        });
    }
    var NewRequisition = function () {
        var x = document.getElementById("labelT");
        x.innerHTML = 'New Requisition';
        ShowProgress();
        $.ajax({
            url: "/GradeCompaint/NewRequistion",
            datatype: "json",
            type: "POST",
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalUnits").modal("show");
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var SelectedRowUnit = function (unit, Sec) {
        $("#labelT").text("Course Evaluation Form");
        ShowProgress();
        $.ajax({
            type: "POST",
            url: "/Course/LecturerEvaluationForm",
            data: JSON.stringify({ Unit: unit, Sec: Sec }),
            contentType: "application/json; charset=utf-8",
            dataType: "html",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalLecturerEvaluationForm").modal("show");
            },
            error: function (err) {
                HideProgress();
                Swal.fire('Error', "There is some problem to process your request. Please try after some time", 'error');
            }
        });
    }
    var CompleteEvaluation = function (Unit, UnitName, StaffNo) {
        var sug1 = $("#txtContrb").val();
        var sug2 = $("#txtImprivents").val();
        var sug3 = $("#txtOtherComment").val();
        ShowProgress();
        $.ajax({
            type: "POST",
            url: "/LecturerEvaluation/CompleteCourseEvaluation",
            data: JSON.stringify({ Unit: Unit, UnitName: UnitName, StaffNo: StaffNo, sug1: sug1, sug2: sug2, sug3: sug3, sug4: "" }),
            contentType: "application/json; charset=utf-8",
            dataType: "json",
            success: function (data) {
                if (data.success == true) {
                    HideProgress();
                    LoadCurrentRegisteredUnits();
                    $("#myModalLecturerEvaluationForm").modal("hide");
                    Swal.fire('Success', data.message, 'success');
                }
                else {
                    HideProgress();
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function () {
                HideProgress();
                Swal.fire('Error', data.message, 'error');
            }
        });
    };
</script>
