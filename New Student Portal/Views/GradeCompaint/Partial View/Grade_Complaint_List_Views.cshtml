@model IEnumerable<New_Student_Portal.ViewModel.Grade_Compaint>
<div class="responsive-table-plugin">
    <div class="table-rep-plugin">
        <div class="table-responsive" data-pattern="priority-columns">
            <table id="tech-companies-1" class="table table-striped table-hover" style="font-size:12px">
                <thead>
                    <tr>
                        <th width="10%">
                            Doc No.
                        </th>
                        <th width="10%">
                            Unit
                        </th>
                        <th width="40%">
                            Description
                        </th>
                        <th width="20%" style="text-align:right">
                            Semester
                        </th>
                        <th width="20%" style="text-align:right">
                            Current Grade
                        </th>
                        <th width="20%" style="text-align:right">
                            New Grade
                        </th>
                        <th width="20%" style="text-align:right">
                            Status
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model != null)
                        {
                            if (Model.Count() > 0)
                            {
                                foreach (var item in Model)
                                {
                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Doc_No)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Unit)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Unit_Name)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Semester)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Current_Grade)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.New_Grade)
                                        </td>
                                        <td>
                                            @if (item.Status == "Pending Approval")
                                            {
                                                <button class="btn btn-sm btn-success" onclick="ViewApprovalTrail('@item.Doc_No');">Approval Trail</button>
                                            }
                                            else if (item.Status == "Rejected")
                                            {
                                                <button class="btn btn-sm btn-danger" onclick="ViewComments('@item.Doc_No');">View Comment</button>
                                            }
                                            else
                                            {
                                                <span class="badge badge-soft-warning">No Action</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" style="color:red">
                                        No Records Found
                                    </td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
