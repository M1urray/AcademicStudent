@model New_Student_Portal.ViewModel.Payments
<label>
    Kindly select service and key in the Amount You would like to pay
</label>
<hr />
<div class="row">
    <span style="font-size: 16px; font-weight: bold">Select Service:</span>
    @Html.DropDownListFor(model => model.ServiceCode, Model.ListofServices, "--select Service--", new { @class = "form-select", @id = "ddlService" })
</div>
<hr />
<div class="row">
    <input class="form-control" type="number" id="amountopay" required="" placeholder="1000">
</div>
<hr>
<div class="row">
    <button class="btn btn-sm btn-success form-control" onclick="PayNow();">Pay Now</button>
</div>
