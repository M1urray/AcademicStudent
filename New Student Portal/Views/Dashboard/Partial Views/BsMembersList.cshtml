@model New_Student_Portal.ViewModel.BsGList
<div class="container">
    <div class="row">
        <div class="col-md-12">
            <div class="responsive-table-plugin">
                <div class="table-rep-plugin">
                    <div class="table-responsive" data-pattern="priority-columns">
                        <table class="table" id="tbRegUnits">
                            <thead style="background-color:black;color:white">
                                <tr>
                                    <th>
                                        Student
                                    </th>
                                    <th>
                                        Contact
                                    </th>
                                    <th>
                                        Email
                                    </th>
                                    @if (Model.Waiting)
                                    {
                                        <th style="text-align:center" colspan="2">
                                            Action
                                        </th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    if (Model.ListOfBsList != null)
                                    {
                                        if (Model.ListOfBsList.Count() > 0)
                                        {
                                            foreach (var item in Model.ListOfBsList)
                                            {
                                                <tr>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.Name)
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.Contact)
                                                    </td>
                                                    <td>
                                                        @Html.DisplayFor(modelItem => item.Email)
                                                    </td>
                                                    @if (Model.Waiting)
                                                    {
                                                        <td>
                                                            <button class="btn btn-sm btn-success form-control" onclick="AdmitStudent('@item.Student_No');">Admit</button>
                                                        </td>
                                                        <td>
                                                            <button class="btn btn-sm btn-danger form-control" onclick="RejectRequest('@item.Student_No');">Reject</button>
                                                        </td>
                                                    }
                                                </tr>
                                            }
                                        }
                                        else
                                        {
                                            <tr>
                                                <td colspan="4" style="color:red">No Members Found</td>
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>








