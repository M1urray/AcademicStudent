@model New_Student_Portal.ViewModel.BSGroupList
<div class="container">
    <div class="col-md-12" style="background-color: white">
        <div class="row">
            <div class="col-md-6">
                <span style="font-weight: bold">Choose a Bible Study(BSG)</span>
                @Html.DropDownListFor(m => m.Code, new SelectList(Model.ListOfBSGroup, "Value", "Text", Model.Code), "--Select a BSG--", new { @id = "ddlBs", @class = "form-select" })
            </div>
            <div class="col-md-6">
                <br />
                <input type="button" class="btn btn-danger" value="Submit Request" onclick="SubmitLeadershipRequest();" />
            </div>
        </div>
    </div>
</div>



