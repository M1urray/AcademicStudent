@model New_Student_Portal.ViewModel.NewDCF
<div class="container">
    <div class="row">
        <div class="col-md-12">
            <table class="table" id="tbRegUnits">
                <thead style="background-color:black;color:white">
                    <tr>
                        <th>
                            DCF
                        </th>
                        <th>
                            Date
                        </th>
                        <th>
                            Time
                        </th>
                        <th>
                            Event Remarks
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model != null)
                        {
                            if (Model.EventList.Count() > 0)
                            {
                                foreach (var item in Model.EventList)
                                {
                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.DCF)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Date)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Time)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Description)
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" style="color:red">No Events Found</td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<hr />
<div class="container" style="border:cadetblue">
    <div class="col-md-12" style="background-color: white;">
        <div class="row">
            <div class="col-md-6">
                <span style="font-weight: bold">Choose a DCF</span>
                @Html.DropDownListFor(m => m.Code, new SelectList(Model.ListOfDCF, "Value", "Text", Model.Code), "--Select a DCF--", new { @id = "ddlDCF", @class = "form-select" })
            </div>
            <div class="col-md-6">
            </div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <span style="font-weight: bold">Code</span>
                @Html.TextBoxFor(m => m.Code, new { @id = "txtCode", @class = "form-control" })
            </div>
            <div class="col-md-6">
                <span style="font-weight: bold">Description</span>
                @Html.TextBoxFor(m => m.Code, new { @id = "txtDescription", @class = "form-control" })
            </div>
            <hr />
            <div class="row">
                <div class="col-md-12" align="center">
                    <br />
                    <input type="button" class="btn btn-danger" id="lblSubmit" value="Create Event" onclick="SubmitDCFDocument();" />
                </div>
            </div>
        </div>
    </div>
</div>






