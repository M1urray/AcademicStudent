@model New_Student_Portal.ViewModel.NewBS
<div class="container">
    <div class="row">
        <div class="col-md-12">
            <table class="table" id="tbRegUnits">
                <thead style="background-color:black;color:white">
                    <tr>
                        <th>
                            Code
                        </th>
                        <th>
                            Description
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        if (Model != null)
                        {
                            if (Model.BsList.Count() > 0)
                            {
                                foreach (var item in Model.BsList)
                                {
                                    <tr>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Code)
                                        </td>
                                        <td>
                                            @Html.DisplayFor(modelItem => item.Description)
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="2" style="color:red">No BS List Found</td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<hr />
<div class="container">
    <div class="col-md-12" style="background-color: white">
        <div class="row">
            <div class="col-md-6">
                <span style="font-weight: bold">Code</span>
                @Html.TextBoxFor(m => m.Code, new { @id = "txtCode", @class = "form-control" })
            </div>
            <div class="col-md-6">
                <span style="font-weight: bold">Description</span>
                @Html.TextBoxFor(m => m.Code, new { @id = "txtDescription", @class = "form-control" })
            </div>
            <hr />
            <div class="col-md-12" align="center">
                <br />
                <input type="button" class="btn btn-danger" id="lblSubmit" value="Create BS" onclick="SubmitCreatedDocument('@Model.Type');" />
            </div>
        </div>
    </div>
</div>



