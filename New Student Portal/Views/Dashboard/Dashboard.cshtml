@model New_Student_Portal.ViewModel.StudentDetailView
@using New_Student_Portal.Models;
@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
    string StudentNo = "";
    string imgSrc = "";

    if (Session["username"] == null)
    {
        Response.Redirect(Url.Action("Login", "Login"));
    }
    else
    {
        StudentNo = Session["username"].ToString();
    }

    try
    {
        if (Session["ImgProfile"] == null)
        {
            var base64 = CommonClass.ProfilePicture(Session["Username"].ToString());
            if (base64 != "")
            {
                imgSrc = String.Format("data:image/gif;base64,{0}", base64);
                Session["ImgProfile"] = imgSrc;
            }
        }
        else
        {
            imgSrc = Session["ImgProfile"].ToString();
        }
    }
    catch (Exception ex)
    {
        ex.Data.Clear();
    }

    string CreditAmout = "0.00", DebitAmount = "0.00", Balance = "0.00";
    if (Model.Balance != 0)
    {
        Balance = Convert.ToDecimal(Model.Balance).ToString("#,##0.00");
    }
    if (Model.Debit_Amount != 0)
    {
        DebitAmount = Convert.ToDecimal(Model.Debit_Amount).ToString("#,##0.00");
    }
    if (Model.Credit_Amount != 0)
    {
        CreditAmout = Convert.ToDecimal(Model.Credit_Amount).ToString("#,##0.00");
    }
}
<style>
    .card, .card-title {
        color: white
    }

    .card-header, .card-title {
        background-color: #d10e2c;
    }

    .card-title {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-left: 10px;
    }
</style>
@if (Model.DisplinaryCases.Count() > 0)
{
    <div class="row">
        <div class="col-md-12">
            @foreach (var c in Model.DisplinaryCases)
            {
                <table class="table table-hover" style="border:2px solid Black">
                    <thead style="background-color:black;color:white">
                        <tr>
                            <th>Displinary Remarks</th>
                            <th>Return Date</th>
                        </tr>
                    </thead>
                    <tbody style="color:red">
                        <tr>
                            <td>
                                <img src="~/assets/images/NEW2.gif" /> @c.Remarks
                            </td>
                            <td>@c.EndDate</td>
                        </tr>
                    </tbody>
                </table>
            }
        </div>
    </div>
}
<div class="card">
    <h4 class="card-title">Basic information</h4>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-6 col-md-2 col-lg-2">
                @{

                    if (imgSrc != "")
                    {
                        <img src="@imgSrc" Height="115" Width="114" style="border-radius: 50% !important" />
                    }
                    else
                    {
                        if (Model.Gender == "Female")
                        {
                            <img src="~/img/profile_f.png" Height="115" Width="114" style="border-radius: 50% !important" />
                        }
                        else
                        {
                            <img src="~/img/profile_m.png" Height="115" Width="114" style="border-radius: 50% !important" />
                        }
                    }
                }
                <hr />
            </div>
            <div class="col-sm-6 col-md-10 col-lg-10">
                <div class="row modal-dialog-scrollable">
                    <div class="col-sm-6 col-md-6">
                        <div class="row mb-3">
                            <label class="col-md-4">Reg. No</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.No)</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-4"> Name</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.Name)</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-4"> ID No</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.ID_No)</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-4">Gender</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.Gender)</span>
                            </div>
                        </div>
                    </div> <!-- end col -->
                    <div class="col-sm-6 col-md-6">
                        <div class="row mb-3">
                            <label class="col-md-4"> Address</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.Address)</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-4">Email</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.E_Mail)</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-4"> Date Of Birth</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.Date_Of_Birth)</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-4"> Campus</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.Campus)</span>
                            </div>
                        </div>
                    </div> <!-- end col -->
                    @if (Model.Qualify_For_Catering)
                    {
                        <div class="col-sm-4 col-md-4">
                            <hr />
                            <div class="row mb-3">
                                <label class="col-md-2"></label>
                                <div class="col-md-8">
                                    <button class="btn btn-sm btn-danger form-control" onclick="GenerateCateringToken('@Model.Semester');">Get Catering Token</button>
                                    <b style="color:black">Current Catering Token :</b> <label id="lblToken" class="label badge badge-outline-success"></label>
                                </div>
                                <label class="col-md-2"></label>
                            </div>
                        </div>
                    }
                    <div class="col-sm-4 col-md-4">
                        <hr />
                        <div class="row mb-3">
                            <label class="col-md-2"></label>
                            <div class="col-md-8">
                                <button class="btn btn-sm btn-success form-control" onclick="AcademicCalender('@Model.Semester');">Get Academic Calender</button>
                            </div>
                            <label class="col-md-2"></label>
                        </div>
                    </div>
                    <div class="col-sm-4 col-md-4">
                        <hr />
                        <div class="row mb-3">
                            <label class="col-md-2"></label>
                            <div class="col-md-8">
                                <button class="btn btn-sm btn-danger form-control" onclick="GetClassAttendanceList();">View Class Attendance</button>
                            </div>
                            <label class="col-md-2"></label>
                        </div>
                    </div>
                </div> <!-- end row -->
            </div>
        </div>
    </div> <!-- end card-body -->
</div> <!-- end card-->
<div class="row">
    <div class="col-md-3 col-md-6">
        <div class="card">
            <h4 class="card-title">Academic Information</h4>
            <div class="card-body">
                <div class="row">
                    <div class="col-12">
                        <div class="row mb-3">
                            <label class="col-md-5">Current Programme</label>
                            <div class="col-md-7">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.ProgName)</span>
                            </div>
                        </div>
                        @if (Model.OtherProg != "")
                        {
                            <div class="row mb-3">
                                <label class="col-md-5">Other Programme</label>
                                <div class="col-md-7">
                                    <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.OtherProg)</span>
                                </div>
                            </div>
                        }
                        @if (Model.SecondConc != "")
                        {
                            <div class="row mb-3">
                                <label class="col-md-5">Double Concentration</label>
                                <div class="col-md-7">
                                    <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.SecondConc)</span>
                                </div>
                            </div>
                        }
                        @if (Model.Minor != "")
                        {
                            <div class="row mb-3">
                                <label class="col-md-5">Minor Programme</label>
                                <div class="col-md-7">
                                    <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.Minor)</span>
                                </div>
                            </div>
                        }
                        <div class="row mb-3">
                            <label class="col-md-5"> Completed Units</label>
                            <div class="col-md-7">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.AttemptedUnits)</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-5"> GPA</label>
                            <div class="col-md-7">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.GPA)</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-5">Academic Status</label>
                            <div class="col-md-7">
                                <span class="badge badge-soft-pink"> @Html.DisplayFor(model => model.AcademicStatus)</span>
                            </div>
                        </div>
                    </div> <!-- end col -->
                </div> <!-- end row -->
            </div> <!-- end card-body -->
        </div> <!-- end card-->
    </div>
    <div class="col-md-3 col-md-6">
        <div class="card">
            <h4 class="card-title">Fee Payment</h4>
            <div class="card-body">
                <div class="row">
                    <div class="col-12">
                        <div class="row mb-3">
                            <label class="col-md-4">Total Billed</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @DebitAmount</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-4"> Total Paid</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @CreditAmout</span>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <label class="col-md-4"> Fee Balance</label>
                            <div class="col-md-8">
                                <span class="badge badge-soft-pink"> @Balance</span>
                            </div>
                        </div>
                    </div> <!-- end col -->
                </div> <!-- end row -->
            </div> <!-- end card-body -->
        </div> <!-- end card-->
    </div>
</div>
<hr />
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <h4 class="card-title">Important Documents</h4>
            <div class="card-body">
                <div class="row">
                    <div class="col-12">
                        <table class="table table-bordered dt-responsive nowrap">
                            <thead style="color:white;background-color:black;">
                                <tr>
                                    <th width="5%">#</th>
                                    <th width="45%">File Name</th>
                                    <th width="40%">Remarks</th>
                                    <th width="10%">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @{
                                    if (Model.ListInternalMemos.ListOfIntMemos != null && Model.ListInternalMemos.ListOfIntMemos.Count > 0)
                                    {
                                        if (Model.ListInternalMemos.hasFiles)
                                        {
                                            int i = 1;
                                            foreach (var item in Model.ListInternalMemos.ListOfIntMemos)
                                            {
                                                <tr>
                                                    <td>@i</td>
                                                    <td>@item.FileName</td>
                                                    <td>@item.Remarks</td>
                                                    <td> <button id="btnview" class="btn btn-sm btn-danger btnPadding" onclick="ViewAttachment('@item.TabelID','@item.No','@item.ID','@item.FileName','@item.FileExt');">View Document</button></td>
                                                </tr>
                                                i++;
                                            }
                                        }
                                        else
                                        {
                                            foreach (var item in Model.ListInternalMemos.ListOfIntMemos)
                                            {
                                                <tr>
                                                    <td colspan="4">@item.FileName</td>
                                                </tr>
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <tr>
                                            <td colspan="4" style="color:Red">No Internal Memos found</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div> <!-- end col -->
                </div> <!-- end row -->
            </div> <!-- end card-body -->
        </div> <!-- end card-->
    </div>
</div>

@*//////////////////////Modal////////////////////////////*@
<div id="myModalUnits" class="modal" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title"><label id="labelT"></label></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBody">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<!--/////////////////notification/////////////////////-->
<div id="myModalNotif" class="modal" tabindex="-1" role="dialog" aria-hidden="true" style="display: none;">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title">Notifications | <img src="~/assets/images/NEW2.gif" /></h4>
                <button type="button" class="btn-close" data-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4" id="modalBodyNot">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary waves-effect" data-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>
<script type="text/javascript">
    $(document).ready(function () {
        if ('@Model.BSGroup' == "") {
            $("#lblJoinBS").text("Join Bible Study(BS) Group");
        }
        else {
            $("#lblJoinBS").text("Bible Study(BS) Group Details");
        }
        $("#lblToken").text(`@Model.Cat_Token`);
        MyBSInformation();
    });
    var ViewRegUnits = function (Type) {
        var x = document.getElementById("labelT");
        if (Type == "CurrReg") {
            x.innerHTML = 'Currently Registared Units';
        }
        else {
            x.innerHTML = 'Attempted Units List';
        }
        ShowProgress();
        $.ajax({
            url: "/Dashboard/ViewStudentRegisteredUnits",
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ Type: Type }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalUnits").modal("show");
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var MyBSInformation = function () {
        ShowProgress();
        $.ajax({
            async: true,
            type: "POST",
            dataType: 'HTML',
            url: '@Url.Action("GetBsDetailForm", "Dashboard")',
            success: function (data) {
                $("#divBs").html(data);
                HideProgress();
                LoadNotifications();
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'There is some problem to process your request. Please try after some time', 'warning');
            }
        });
    }
    var LoadNotifications = function () {
         if (parseInt(`@Model.NotfCount`) > 0) {
             ShowProgress();
             $.ajax({
                async: false,
                type: "GET",
                dataType: 'HTML',
                contentType: false,
                processData: false,
                url: '@Url.Action("NotificationMessages", "Common")',
                success: function (data) {
                    HideProgress();
                    $("#modalBodyNot").html(data);
                    $("#myModalNotif").modal("show");
                },
                error: function () {
                    HideProgress();
                    Swal.fire('Warning', 'There is some problem to process your request. Please try after some time', 'warning');
                }
            });
        }
    };
    var BSDetails = function (BsG) {
        var x = document.getElementById("labelT");
        var url;
        if (BsG != "") {
            x.innerHTML = 'Bible Study Details';
            url = "/Dashboard/GetBSDetails";
        }
        else {
            x.innerHTML = 'Join a Bible Study(BSG)';
           url = "/Dashboard/JoinBSGroup";
        }
        ShowProgress();
        $.ajax({
            url: url,
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ BSG: BsG }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalUnits").modal("show");
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var CreateDocument = function (Type) {
        var x = document.getElementById("labelT");
        if (Type == "BS") {
            x.innerHTML = 'Create Bible Study(BS)';
        }
        if (Type == "DCF") {
            x.innerHTML = 'Create Aiu Christain Fellowship(DCF)';
        }
       ShowProgress();
        $.ajax({
            url: "/Dashboard/CreateDocument",
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ Type:Type  }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalUnits").modal("show");
            },
            error: function () {
                HideProgress();
                swal('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var BibleStudyMembers = function (Bs,Waiting,Title) {
        var x = document.getElementById("labelT");
        x.innerHTML = Title;
        ShowProgress();
        $.ajax({
            url: "/Dashboard/BibleStudyMembers",
            datatype: "json",
            data:JSON.stringify({ waitingRoom: Waiting, BsG: Bs }),
            type: "POST",
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalUnits").modal("show");
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var AdmitStudent = function (StdNo) {
        ShowProgress();
        $.ajax({
            url: "/Dashboard/ApproveBSRequest",
            datatype: "json",
            type: "POST",
            data: JSON.stringify({ Bs: '@Model.BstudyDetails.Code', StdNo: StdNo }),
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                if (data.success) {
                    HideProgress();
                    BibleStudyMembers('@Model.BSGroup', true, 'Students in Waiting Room');
                }
                else {
                    HideProgress();
                    Swal.fire('Warning', data.message, 'warning');
                }
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var CDFEvents = function () {
        var x = document.getElementById("labelT");
        x.innerHTML = 'AIU Christian Fellowship(CDF) Events';
        ShowProgress();
        $.ajax({
            url: "/Dashboard/DCFEventsList",
            datatype: "json",
            type: "POST",
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalUnits").modal("show");
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var CreateCDFEvent = function () {
        var x = document.getElementById("labelT");
        x.innerHTML = 'Create AIU Christian Fellowship(CDF) Event';
        ShowProgress();
        $.ajax({
            url: "/Dashboard/CreateDCFDocument",
            datatype: "json",
            type: "POST",
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                HideProgress();
                $("#modalBody").html(data);
                $("#myModalUnits").modal("show");
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var SubmitBSRequest = function () {
        var BSG = $("#ddlBs").children("option:selected").val();
        if (BSG == "") {
            Swal.fire('Warning', 'Kindly select a group', 'warning');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                url: "/Dashboard/SubmitBSRequest",
                datatype: "json",
                type: "POST",
                async:false,
                data: JSON.stringify({ BSG: BSG }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    HideProgress();
                    MyBSInformation();
                    $("#myModalUnits").modal("hide");
                    Swal.fire('Success', data.message, 'success');
                },
                error: function () {
                    HideProgress();
                    Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
                }
            });
        }
    }
    var RequestToBeBSLeader = function () {
        var url;
        if (`@Model.LeadershipOption` == "Request Against A Group") {
            url = "/Dashboard/JoinBSGroupAgainstGroup";
        }
        else {
            url = "/Dashboard/RequestBsGroupLeader";
        }
        ShowProgress();
        $.ajax({
            url: url,
            datatype: "json",
            type: "POST",
            contentType: "application/json; charset = utf-8",
            success: function (data) {
                HideProgress();
                MyBSInformation();
                Swal.fire('Success', data.message, 'success');
            },
            error: function () {
                HideProgress();
                Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
            }
        });
    }
    var SubmitCreatedDocument = function (Type) {
        var Code = $("#txtCode").val();
        var Descr = $("#txtDescription").val();
        if (Code == "") {
            Swal.fire('Warning', 'Kindly enter Code', 'warning');
            return;
        }
        else if (Descr == "") {
            Swal.fire('Warning', 'Kindly enter description', 'warning');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                url: "/Dashboard/SubmitDocument",
                datatype: "json",
                type: "POST",
                data: JSON.stringify({ Code: Code, Desc: Descr, Type: Type }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    HideProgress();
                    Swal.fire('Success', data.message, 'success');
                },
                error: function () {
                    HideProgress();
                    Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
                }
            });
        }
    }
    var SubmitDCFDocument = function () {
        var CDF = $("#ddlDCF").children("option:selected").val();
        var Code = $("#txtCode").val();
        var Descr = $("#txtDescription").val();
        if (CDF == "") {
            Swal.fire('Warning', 'Kindly Select DCF', 'warning');
            return;
        }
        if (Code == "") {
            Swal.fire('Warning', 'Kindly enter Code', 'warning');
            return;
        }
        else if (Descr == "") {
            Swal.fire('Warning', 'Kindly enter description', 'warning');
            return;
        }
        else {
            ShowProgress();
            $.ajax({
                url: "/Dashboard/SubmitDCFDocument",
                datatype: "json",
                type: "POST",
                data: JSON.stringify({ DCF: CDF, Code: Code, Desc: Descr }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        HideProgress();
                        CreateCDFEvent();
                        Swal.fire('Success', data.message, 'success');
                    }
                    else {
                        HideProgress();
                        Swal.fire('Error', data.message, 'error');
                    }
                },
                error: function () {
                    HideProgress();
                    Swal.fire('Warning', 'Problem encountered while reading Units', 'warning');
                }
            });
        }
    }
    var AcademicCalender = function (Sem) {
        if (Sem == "" || Sem == null) {
            Swal.fire('Warning', 'Current Semester not set', 'warning');
            return;
        }
        else {
            var x = document.getElementById("labelT");
            x.innerHTML = 'Academic Calender';
            ShowProgress();
            $.ajax({
                type: "POST",
                dataType: 'HTML',
                contentType: "application/json; charset = utf-8",
                data: JSON.stringify({ Sem: Sem }),
                url: "/Common/GetAcademicCalender",
                success: function (data) {
                    HideProgress();
                    $("#modalBody").html(data);
                    $("#myModalUnits").modal("show");
                },
                error: function () {
                    HideProgress();
                    Swal.fire('Warning', 'There is some problem to process your request. Please try after some time', 'warning');
                }
            });
        }
    };
