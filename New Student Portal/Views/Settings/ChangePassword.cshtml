
@{
    ViewBag.Title = "Change Password";
    Layout = "~/Views/Shared/SiteMaster.cshtml";
}
<div class="modal-content">     
    <div class="modal-body">
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="username" class="lblClass">New Password</label>
                    <input type="password" class="form-control" id="NewPassword" placeholder="Password" required="" autocomplete="off">
                </div>
            </div>
            <div class="col-md-6"></div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group">
                    <label for="userpassword" class="lblClass">Confirm Password</label>
                    <input type="password" class="form-control" id="confirmPass" placeholder="Confirm password" required="" autocomplete="off">
                </div>
            </div>
            <div class="col-md-6"></div>
        </div>
        <hr />
        <input type="submit" value="Change Password" id="btnChange" class="btn btn-danger" style="color: wheat" />
    </div>
</div>
<script>
    $(document).ready(function () {
        $("#btnChange").click(function () {
            var passord = $("#NewPassword").val();
            var Confirmpassord = $("#confirmPass").val();

            if (passord == "") {
                swal('Warning', 'Enter Your new password', 'warning');
                return;
            }
            else if (Confirmpassord == "") {
                swal('Warning', 'Confirm your password', 'warning');
                return;
            }
            else if (passord != Confirmpassord) {
                $("#NewPassword").val('');
                $("#confirmPass").val('');
                swal('Warning', 'Passwords do not match. Enter them again', 'warning');
                return;
            }
            else {
                ShowProgress();
                $.ajax({
                    url: '@Url.Action("ChangePassord", "Settings")',
                    datatype: "json",
                    type: "POST",
                    data: JSON.stringify({ newpass: passord }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        if (data.success == true) {
                            swal('Success', data.message, 'success');
                            $("#NewPassword").val('');
                            $("#confirmPass").val('');
                            HideProgress();
                        }
                        else {
                            if (data.redirect == true) {
                                window.location = data.message;
                            }
                            else {
                                swal('Warning', data.message, 'warning');
                                HideProgress();
                            }
                        }
                    },
                    error: function (err) {
                        HideProgress();
                        swal('Error', err, 'error');
                    }
                });
            }
        });
    });
</script>



