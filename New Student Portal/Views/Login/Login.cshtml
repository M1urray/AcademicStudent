@model New_Student_Portal.Models.Authedication
@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/LoginMaster.cshtml";
}
<style>
    label {
        color: white;
    }    
</style>

<div class="mb-2">
    <label for="emailaddress" class="form-label">Reg. Number</label>
    <input class="form-control" type="text" id="username" required="" placeholder="Reg. Number">
</div>

<div class="mb-2">
    <label for="password" class="form-label">Password</label>
    <div class="input-group input-group-merge">
        <input type="password" id="userpassword" class="form-control" placeholder="Password">

        <div class="input-group-text" data-password="false">
            <span class="password-eye"></span>
        </div>
    </div>
</div>
<div class="mb-3">
    <div class="form-check">
        <input class="form-check-input" type="checkbox" id="checkbox-signin" checked>
        <label class="form-check-label" for="checkbox-signin">
            Remember me
        </label>
    </div>
</div>
<div class="d-grid mb-0 text-center">
    <button class="btn btn-primary" id="btnLogin" type="submit"> Log In </button>
</div>
<div class="row mt-3">
    <div class="col-12 text-center">
        <p> <a href="@Url.Action("ForgotPassword", "Login")" class="text-muted ms-1">Forgot your password?</a></p>
    </div> <!-- end col -->
</div>
<!-- end card -->
<!-- end row -->
<script src="~/JS/ShowProgression.js"></script>
<script>
    $(document).ready(function () {
        $("#btnLogin").click(function () {
            var username = $("#username").val();
            var password = $("#userpassword").val();
            if (username == "") {
                Swal.fire('Warning', 'Enter Username', 'warning');
                return;
            }
            else if (password == "") {
                Swal.fire('Warning', 'Enter Your Password', 'warning');
                return;
            }
            else {
                var Authedication = {};
                Authedication.Username = username;
                Authedication.Password = password;
                ShowProgress();
                $.ajax({
                    url: '@Url.Action("LoginUser", "Login")',
                    datatype: "json",
                    type: "POST",
                    data: JSON.stringify({ userlogin: Authedication }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        if (data.success == true) {
                            if (data.message == "ALL") {
                                window.location = '@Url.Action("Alumni", "Dashboard")';
                            } else if (data.message == "RESET") {
                                window.location = '@Url.Action("AccountResetPassword", "Login")';
                            }
                            else {
                                window.location = '@Url.Action("Dashboard", "Dashboard")';
                            }
                        }
                        else {
                            HideProgress();
                            Swal.fire('Warning', data.message, 'warning');
                        }
                    },
                    error: function (err) {
                        HideProgress();
                        Swal.fire('Error', err, 'error');
                    }
                });
            }
        });
    });
    $("#username").keyup(function (event) {
        if (event.keyCode === 13) {
            $("#btnLogin").click();
        }
    });
    $("#userpassword").keyup(function (event) {
        if (event.keyCode === 13) {
            $("#btnLogin").click();
        }
    });
</script>

