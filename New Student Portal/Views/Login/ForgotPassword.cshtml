@model New_Student_Portal.Models.Authedication
@{
    ViewBag.Title = "ForgotPassword";
    Layout = "~/Views/Shared/LoginMaster.cshtml";
}
<style>
    label {
        color: white;
    }
</style>
<div class="mb-2">
    <label for="emailaddress" class="form-label">Reg. Number</label>
    <input class="form-control" type="text" id="username" required="" placeholder="Reg. Number">
</div>
@*<div class="mb-2">
    <label for="emailaddress" class="form-label">Choose Reset Mode</label>
    <select class="form-control" id="ddlMode">
        <option value="">----</option>
        <option value="1">SMS</option>
        <option value="2">Email</option>
    </select>
</div>*@
<div class="d-grid mb-0 text-center">
    <button class="btn btn-primary" id="btnReset" value="" type="submit">Reset Password</button>
</div>
<div class="row mt-3">
    <div class="col-12 text-center">
        <p> <a href="@Url.Action("Login", "Login")" class="text-muted ms-1">Login</a></p>
    </div> <!-- end col -->
</div>
<script src="~/JS/ShowProgression.js"></script>
<script>
    $(document).ready(function () {
        $("#btnReset").click(function () {
            var username = $("#username").val();
            var mode = $("#ddlMode").children("option:selected").val();
            if (username == "") {
                Swal.fire('Warning', 'Enter Username', 'warning');
                return;
            }
            else if (mode == "") {
                Swal.fire('Warning', 'Choose Mode of Reset', 'warning');
                return;
            }
            else {
                var Authedication = {};
                Authedication.Username = username;
                Authedication.Mode = mode;
                ShowProgress();
                $.ajax({
                    url: '@Url.Action("ForgotPassword", "Login")',
                    datatype: "json",
                    type: "POST",
                    data: JSON.stringify({ Reg: Authedication }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        if (data.success == true) {
                            Swal.fire('Success', data.message, 'success');
                            $("#username").val("");
                            $("#ddlMode").val("");
                            HideProgress();
                        }
                        else {
                            Swal.fire('Warning', data.message, 'warning');
                            HideProgress();
                        }
                    },
                    error: function (err) {
                        HideProgress();
                        Swal.fire('Error', err, 'error');
                    }
                });
            }
        });
    });
    $("#username").keyup(function (event) {
        if (event.keyCode === 13) {
            $("#btnLogin").click();
        }
    });
</script>


