@model New_Student_Portal.Models.Authedication
@{
    ViewBag.Title = "ForgotPassword";
    Layout = "~/Views/Shared/LoginMaster.cshtml";
}
<style>
    label {
        color: white;
    }

    .card-body {
        padding: 0.7rem 0.5rem;
    }

    .w-75 {
        width: 100% !important;
    }
</style>
<div class="card">
    <div class="card-body p-4">
        <div class="text-center w-75 m-auto">
            <div class="auth-logo">
                <a href="#" class="logo logo-dark text-center">
                    <span class="logo-lg">
                        <img src="~/assets/images/retina_logo3.png" alt="" height="120" width="100%">
                    </span>
                </a>
            </div>
        </div>
        <hr />
        <div class="mb-2">
            <label for="emailaddress" class="form-label">Email Address</label>
            <input class="form-control" type="text" id="username" required="" placeholder="Email Address">
        </div>
        <div class="d-grid mb-0 text-center">
            <button class="btn btn-primary" id="btnReset" value="" type="submit">Reset Password</button>
        </div>
        <div class="row mt-3">
            <div class="col-12 text-center">
                <p> <a href="/Login/Login" class="text-muted ms-1">Login</a></p>
            </div> <!-- end col -->
        </div>
    </div> <!-- end card-body -->
</div>
<script src="~/JS/ShowProgression.js"></script>
<script>
    $(document).ready(function () {
        $("#btnReset").click(function () {
            var username = $("#username").val();
            if (username == "") {
                Swal.fire('Warning', 'Enter Username', 'warning');
                return;
            }
            else {
                var Authedication = {};
                Authedication.Username = username;
                ShowProgress();
                $.ajax({
                    url: "/Login/ForgotPassword",
                    datatype: "json",
                    type: "POST",
                    data: JSON.stringify({ Reg: Authedication }),
                    contentType: "application/json; charset = utf-8",
                    success: function (data) {
                        if (data.success == true) {
                            Swal.fire('Success', data.message, 'success');
                            $("#username").val("");
                            HideProgress();
                        }
                        else {
                            Swal.fire('Warning', data.message, 'warning');
                            HideProgress();
                        }
                    },
                    error: function (err) {
                        HideProgress();
                        Swal.fire('Error', err, 'error');
                    }
                });
            }
        });
    });
    $("#username").keyup(function (event) {
        if (event.keyCode === 13) {
            $("#btnLogin").click();
        }
    });
</script>


