@model New_Student_Portal.ViewModel.ResetPasswordAccount
@{
    ViewBag.Title = "AccountResetPassword";
    Layout = "~/Views/Shared/LoginMaster.cshtml";
}
<style>
    label {
        color: white;
    }

    .card-body {
        padding: 0.7rem 0.5rem;
    }

    .w-75 {
        width: 100% !important;
    }
</style>
<div class="card">
    <div class="card-body p-4">
        <div class="text-center w-75 m-auto">
            <div class="auth-logo">
                <a href="#" class="logo logo-dark text-center">
                    <span class="logo-lg">
                        <img src="~/assets/images/logo2.png" alt="" height="120" width="100%">
                    </span>
                </a>
            </div>
        </div>
        <div class="row m-b-20">
            <div class="col-md-12">
                <h3 class="text-center txt-primary"><b>NEW PASSWORD FORM</b></h3>
            </div>
        </div>
        <hr />
        <div style="background-color:lightslategrey">
            <div class="mb-2">
                <label class="float-label">New Password</label>
                <input type="password" class="form-control" id="NewPassword" placeholder="New Password" />
            </div>
            <div class="mb-2">
                <label class="float-label">Confirm Password</label>
                <input type="password" class="form-control" id="ConfirmPass" placeholder="Confirm Passwor" />
            </div>
            <div class="d-grid mb-0 text-center">
                <input type="submit" id="btnReset" value="Reset Password" class="btn btn-danger btn-md btn-block waves-effect text-center m-b-20" style="font-weight:bold; color:wheat" onclick="ResetPassword();" />
            </div>
        </div>
    </div> <!-- end card-body -->
</div>
<script src="~/JS/ShowProgression.js"></script>
<script>
    var ResetPassword = function () {
        var username = `@Model.UserName`;
        var Password = $("#NewPassword").val();
        var ConfPassword = $("#ConfirmPass").val();
        if (username == "") {
            Swal.fire('Warning', 'Registration Number cannot be Empty', 'warning');
            return;
        }
        else if (Password == "") {
            Swal.fire('Warning', 'Enter your new passwor', 'warning');
            return;
        }
        else if (ConfPassword == "") {
            Swal.fire('Warning', 'Confirm your new passwor', 'warning');
            return;
        }
        else if (Password.length < 6) {
            Swal.fire('Warning', 'Your password should be at least six characters', 'warning');
            return;
        }
        else if (Password != ConfPassword) {
            $("#NewPassword").val('');
            $("#ConfirmPass").val('');
            Swal.fire('Warning', 'Passwords do not match. Enter them again', 'warning');
            return;
        }
        else {
            var ResetPasswordAccount = {};
            ResetPasswordAccount.UserName = username;
            ResetPasswordAccount.Password = Password;
            ShowProgress();
            $.ajax({
                url: "/Login/ApplicantResetPassword",
                datatype: "json",
                type: "POST",
                data: JSON.stringify({ userReset: ResetPasswordAccount }),
                contentType: "application/json; charset = utf-8",
                success: function (data) {
                    if (data.success == true) {
                        window.location = data.message;
                        HideProgress();
                    }
                    else {
                        Swal.fire('Warning', data.message, 'warning');
                        HideProgress();
                    }
                },
                error: function (err) {
                    HideProgress();
                    Swal.fire('Error', err, 'error');
                }
            });
        }
    };
</script>
